<Window x:Class="FiveMServerLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:FiveMServerLauncher.Views"
        xmlns:core="clr-namespace:FiveMServerLauncher.Core"
        Title="{x:Static core:AppInfo.Title}"
        Icon="Assets/launcher.ico"
        Height="520"
        Width="860"
        Background="#151515"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize">

    <Window.Resources>
        <sys:Double x:Key="CaptionHeight">40</sys:Double>
        <sys:Double x:Key="WindowButtonWidth">50</sys:Double>
        <GridLength x:Key="CaptionRowHeight">40</GridLength>
        <Style x:Key="WindowButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width"
                    Value="{StaticResource WindowButtonWidth}"/>
            <Setter Property="Height"
                    Value="{StaticResource CaptionHeight}"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome"
                    Value="True"/>
        </Style>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>

        <shell:WindowChrome
            CaptionHeight="{StaticResource CaptionHeight}"
            ResizeBorderThickness="6"
            GlassFrameThickness="0"
            UseAeroCaptionButtons="False"/>

    </shell:WindowChrome.WindowChrome>

    <Grid Background="#151515">

        <Grid.RowDefinitions>
            <RowDefinition Height="{StaticResource CaptionRowHeight}"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- BARRA SUPERIOR -->

        <Grid Grid.Row="0"
              Background="#1E1E1E"
              Panel.ZIndex="10">


            <!-- ================================================= -->
            <!-- ZONA PARA MOVER LA VENTANA -->
            <!-- ================================================= -->

            <Border Background="Transparent"
                    Margin="0,0,100,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    WindowChrome.IsHitTestVisibleInChrome="True">

                <TextBlock Text="{x:Static core:AppInfo.Title}"
                           Foreground="White"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="15,0,0,0"
                           IsHitTestVisible="False"/>

            </Border>


            <!-- ================================================= -->
            <!-- BOTONES DE VENTANA -->
            <!-- ================================================= -->

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top">


                <!-- MINIMIZAR -->

                <Button Content="—"
                        FontSize="16"
                        Style="{StaticResource WindowButtonStyle}"
                        Click="MinimizeButton_Click"/>


                <!-- CERRAR -->

                <Button Content="✕"
                        FontSize="14"
                        Style="{StaticResource WindowButtonStyle}"
                        Click="CloseButton_Click"/>

            </StackPanel>

        </Grid>

        <!-- CONTENIDO -->
        
        <Grid Grid.Row="1">

            <views:MainView/>

        </Grid>

        <!-- PIE DE PANTALLA -->

        <Border Grid.Row="2"
                Background="#1A1A1A"
                Panel.ZIndex="10">

            <TextBlock Text="{x:Static core:AppInfo.Title}"
                       Foreground="#666666"
                       FontSize="10"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="0,4"/>

        </Border>

    </Grid>

</Window>