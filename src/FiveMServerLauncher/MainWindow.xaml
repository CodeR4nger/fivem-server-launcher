<Window x:Class="FiveMServerLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:FiveMServerLauncher.Views"
        xmlns:core="clr-namespace:FiveMServerLauncher.Core"
        Title="{x:Static core:AppInfo.Title}"
        Icon="Assets/launcher.ico"
        Height="520"
        Width="860"
        Background="{DynamicResource GroundBrush}"
        views:Motion.IsEnabled="{Binding IsMotionEnabled, FallbackValue=False}"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize">

    <!-- The window root: the theme is merged here too (title bar, footer, and the root
         FontFamily/motion switch above resolve from it). FontFamily and Motion.IsEnabled
         inherit into every page control. -->
    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <views:ThemeResources/>
        </ResourceDictionary.MergedDictionaries>
        <sys:Double x:Key="CaptionHeight">40</sys:Double>
        <sys:Double x:Key="WindowButtonWidth">50</sys:Double>
        <GridLength x:Key="CaptionRowHeight">40</GridLength>
        <Style x:Key="WindowButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width"
                    Value="{StaticResource WindowButtonWidth}"/>
            <Setter Property="Height"
                    Value="{StaticResource CaptionHeight}"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Foreground"
                    Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome"
                    Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>

        <shell:WindowChrome
            CaptionHeight="{StaticResource CaptionHeight}"
            ResizeBorderThickness="6"
            GlassFrameThickness="0"
            UseAeroCaptionButtons="False"/>

    </shell:WindowChrome.WindowChrome>

    <!-- Root: the UI font is set once here (inherits everywhere below; Segoe UI fallback).
         The motion switch is bound on the Window itself above. -->
    <Grid Background="{StaticResource GroundBrush}"
          TextElement.FontFamily="{StaticResource UiFontFamily}">

        <Grid.RowDefinitions>
            <RowDefinition Height="{StaticResource CaptionRowHeight}"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- BARRA SUPERIOR -->

        <Grid Grid.Row="0"
              Background="{StaticResource TitleBarBrush}"
              Panel.ZIndex="10">


            <!-- ================================================= -->
            <!-- ZONA PARA MOVER LA VENTANA -->
            <!-- ================================================= -->

            <Border Background="Transparent"
                    Margin="0,0,100,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    WindowChrome.IsHitTestVisibleInChrome="True">

                <TextBlock Text="{x:Static core:AppInfo.Title}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="15,0,0,0"
                           IsHitTestVisible="False"/>

            </Border>


            <!-- ================================================= -->
            <!-- BOTONES DE VENTANA -->
            <!-- ================================================= -->

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top">


                <!-- MINIMIZAR -->

                <Button Content="—"
                        FontSize="16"
                        Style="{StaticResource WindowButtonStyle}"
                        Click="MinimizeButton_Click"/>


                <!-- CERRAR -->

                <Button Content="✕"
                        FontSize="14"
                        Style="{StaticResource WindowButtonStyle}"
                        Click="CloseButton_Click"/>

            </StackPanel>

        </Grid>

        <!-- CONTENIDO -->
        
        <Grid Grid.Row="1">

            <views:MainView/>

        </Grid>

        <!-- PIE DE PANTALLA -->

        <Border Grid.Row="2"
                Background="{StaticResource FooterBrush}"
                Panel.ZIndex="10">

            <TextBlock Text="{x:Static core:AppInfo.Title}"
                       Foreground="{StaticResource FooterTextBrush}"
                       FontSize="10"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="0,4"/>

        </Border>

    </Grid>

</Window>