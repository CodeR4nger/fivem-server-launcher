<!-- The Settings page (ui-redesign ticket 09): a "Settings" title with the General / Dev mode
     tabs on the right, then one scrolling area holding the shown tab. General groups the
     launcher settings (Launch, Integration, Display, About) as SettingsRowStyle rows; Dev mode
     holds the client overrides and the two launch buttons. Every control binds straight to
     MainViewModel (DataContext inherited); the tabs, the segments and the switches are plain
     ListBoxes and ToggleButtons, so arrow keys move within a segmented control, Space toggles
     a switch and Tab walks the page in order. -->
<UserControl x:Class="FiveMServerLauncher.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:core="clr-namespace:FiveMServerLauncher.Core"
             xmlns:enums="clr-namespace:FiveMServerLauncher.Core.Enums"
             xmlns:viewModels="clr-namespace:FiveMServerLauncher.ViewModels"
             xmlns:loc="clr-namespace:FiveMServerLauncher.Views"
             xmlns:views="clr-namespace:FiveMServerLauncher.Views">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <views:ThemeResources/>
            </ResourceDictionary.MergedDictionaries>

            <!-- A settings row with the mockup's breathing room -->
            <Style x:Key="PageRowStyle" TargetType="HeaderedContentControl" BasedOn="{StaticResource SettingsRowStyle}">
                <Setter Property="Padding" Value="0,14"/>
            </Style>

            <!-- The hairline between two rows of a group -->
            <Style x:Key="RowSeparatorStyle" TargetType="Border">
                <Setter Property="Height" Value="1"/>
                <Setter Property="Background" Value="{StaticResource BorderBrush}"/>
            </Style>

            <!-- A group card: rows run edge to edge vertically, so the padding is sideways -->
            <Style x:Key="PageGroupStyle" TargetType="Border" BasedOn="{StaticResource SettingsGroupStyle}">
                <Setter Property="Padding" Value="20,0"/>
            </Style>

            <Style x:Key="PageSectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionHeaderStyle}">
                <Setter Property="Margin" Value="4,0,0,8"/>
            </Style>

            <!-- A section: header + group, spaced from the next one -->
            <Style x:Key="SectionStyle" TargetType="StackPanel">
                <Setter Property="Margin" Value="0,0,0,18"/>
            </Style>

            <Style x:Key="RowPickerStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                <Setter Property="MinWidth" Value="200"/>
                <Setter Property="MaxWidth" Value="320"/>
                <Setter Property="MinHeight" Value="36"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <Style x:Key="RowSwitchStyle" TargetType="ToggleButton" BasedOn="{StaticResource ToggleSwitchStyle}">
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="28,24,0,0">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: the title, and the tabs at the right edge of the content column. The
             column caps the page at a readable width when the window is maximized. -->
        <Grid Grid.Row="0" Margin="0,0,42,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1000*" MaxWidth="900"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Grid x:Name="SettingsHeader">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{loc:Loc NavSettings}"
                           Style="{StaticResource PageTitleStyle}"
                           VerticalAlignment="Center"
                           TextTrimming="None"/>

                <ListBox x:Name="SettingsTabs"
                         Grid.Column="1"
                         Style="{StaticResource SegmentedControlStyle}"
                         SelectedValuePath="Tag"
                         SelectedValue="{Binding SettingsTab}"
                         VerticalAlignment="Center">
                    <ListBoxItem Content="{loc:Loc SettingsTabGeneral}"
                                 Tag="{x:Static viewModels:SettingsTab.General}"/>
                    <ListBoxItem Content="{loc:Loc SettingsTabDevMode}"
                                 Tag="{x:Static viewModels:SettingsTab.DevMode}"/>
                </ListBox>
            </Grid>
        </Grid>

        <ScrollViewer x:Name="SettingsScroller"
                      Grid.Row="1"
                      Margin="0,16,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">

            <Grid Margin="0,0,28,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1000*" MaxWidth="900"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- ============================ GENERAL ============================ -->
                <StackPanel x:Name="GeneralTab"
                            Style="{StaticResource PageSurfaceStyle}"
                            views:Motion.Shown="{Binding IsGeneralSettingsTab}">

                    <!-- LAUNCH -->
                    <StackPanel Style="{StaticResource SectionStyle}">
                        <TextBlock Text="{loc:Loc SettingsSectionLaunch}" Style="{StaticResource PageSectionHeaderStyle}"/>
                        <Border Style="{StaticResource PageGroupStyle}">
                            <StackPanel>
                                <HeaderedContentControl Style="{StaticResource PageRowStyle}"
                                                        Header="{loc:Loc SettingsPreferredClient}"
                                                        Tag="{loc:Loc SettingsPreferredClientDescription}">
                                    <Grid>
                                        <ListBox x:Name="PreferredClientSegments"
                                                 Style="{StaticResource SegmentedControlStyle}"
                                                 ItemsSource="{Binding AvailableOpenClients}"
                                                 DisplayMemberPath="DisplayName"
                                                 SelectedItem="{Binding PreferredClientOption}"
                                                 AutomationProperties.Name="{loc:Loc SettingsPreferredClient}"
                                                 Visibility="{Binding HasInstalledClients, Converter={StaticResource BoolToVisibility}}"/>
                                        <TextBlock x:Name="NoClientNote"
                                                   Text="{loc:Loc OpenClientNone}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Opacity="0.7"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding HasInstalledClients, Converter={StaticResource InverseBoolToVisibility}}"/>
                                    </Grid>
                                </HeaderedContentControl>

                                <Border Style="{StaticResource RowSeparatorStyle}"/>

                                <HeaderedContentControl Style="{StaticResource PageRowStyle}"
                                                        Header="{loc:Loc SettingsAutoLaunch}"
                                                        Tag="{loc:Loc SettingsAutoLaunchDescription}">
                                    <ToggleButton x:Name="AutoLaunchSwitch"
                                                  Style="{StaticResource RowSwitchStyle}"
                                                  IsChecked="{Binding AutoLaunch}"
                                                  AutomationProperties.Name="{loc:Loc SettingsAutoLaunch}"/>
                                </HeaderedContentControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- INTEGRATION -->
                    <StackPanel Style="{StaticResource SectionStyle}">
                        <TextBlock Text="{loc:Loc SettingsSectionIntegration}" Style="{StaticResource PageSectionHeaderStyle}"/>
                        <Border Style="{StaticResource PageGroupStyle}">
                            <StackPanel>
                                <HeaderedContentControl Style="{StaticResource PageRowStyle}"
                                                        Header="{loc:Loc SettingsWebLinks}"
                                                        Tag="{loc:Loc SettingsWebLinksDescription}">
                                    <ToggleButton x:Name="WebLinksSwitch"
                                                  Style="{StaticResource RowSwitchStyle}"
                                                  IsChecked="{Binding WebLinks}"
                                                  AutomationProperties.Name="{loc:Loc SettingsWebLinks}"/>
                                </HeaderedContentControl>

                                <Border Style="{StaticResource RowSeparatorStyle}"/>

                                <HeaderedContentControl Style="{StaticResource PageRowStyle}"
                                                        Header="{loc:Loc SettingsMinimizeToTray}"
                                                        Tag="{loc:Loc SettingsMinimizeToTrayDescription}">
                                    <ToggleButton x:Name="MinimizeToTraySwitch"
                                                  Style="{StaticResource RowSwitchStyle}"
                                                  IsChecked="{Binding MinimizeToTray}"
                                                  AutomationProperties.Name="{loc:Loc SettingsMinimizeToTray}"/>
                                </HeaderedContentControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- DISPLAY -->
                    <StackPanel Style="{StaticResource SectionStyle}">
                        <TextBlock Text="{loc:Loc SettingsSectionDisplay}" Style="{StaticResource PageSectionHeaderStyle}"/>
                        <Border Style="{StaticResource PageGroupStyle}">
                            <StackPanel>
                                <HeaderedContentControl Style="{StaticResource PageRowStyle}"
                                                        Header="{loc:Loc SettingsLanguage}"
                                                        Tag="{loc:Loc SettingsLanguageDescription}">
                                    <ComboBox x:Name="LanguagePicker"
                                              Style="{StaticResource RowPickerStyle}"
                                              ItemsSource="{Binding LanguageOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedItem="{Binding SelectedLanguageOption}"
                                              AutomationProperties.Name="{loc:Loc SettingsLanguage}"/>
                                </HeaderedContentControl>

                                <Border Style="{StaticResource RowSeparatorStyle}"/>

                                <HeaderedContentControl Style="{StaticResource PageRowStyle}"
                                                        Header="{loc:Loc SettingsAnimations}"
                                                        Tag="{loc:Loc SettingsAnimationsDescription}">
                                    <ListBox x:Name="AnimationsSegments"
                                             Style="{StaticResource SegmentedControlStyle}"
                                             SelectedValuePath="Tag"
                                             SelectedValue="{Binding InterfaceAnimations}"
                                             AutomationProperties.Name="{loc:Loc SettingsAnimations}">
                                        <ListBoxItem Content="{loc:Loc SettingsAnimationsDefault}"
                                                     Tag="{x:Static enums:InterfaceAnimations.Default}"/>
                                        <ListBoxItem Content="{loc:Loc SettingsAnimationsMinimal}"
                                                     Tag="{x:Static enums:InterfaceAnimations.Minimal}"/>
                                    </ListBox>
                                </HeaderedContentControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ABOUT -->
                    <StackPanel Style="{StaticResource SectionStyle}" Margin="0">
                        <TextBlock Text="{loc:Loc SettingsSectionAbout}" Style="{StaticResource PageSectionHeaderStyle}"/>
                        <Border Style="{StaticResource PageGroupStyle}">
                            <StackPanel>
                                <HeaderedContentControl Style="{StaticResource PageRowStyle}"
                                                        Header="{loc:Loc SettingsVersion}">
                                    <TextBlock x:Name="VersionText"
                                               Text="{x:Static core:AppInfo.Version}"
                                               Style="{StaticResource BodyTextStyle}"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </HeaderedContentControl>

                                <Border Style="{StaticResource RowSeparatorStyle}"/>

                                <!-- The check's result sits beside its button; a found update
                                     shows the title-bar pill instead of a line. -->
                                <HeaderedContentControl Style="{StaticResource PageRowStyle}"
                                                        Header="{loc:Loc SettingsUpdates}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="UpdateCheckLine"
                                                   Text="{Binding UpdateCheckText}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Right"
                                                   MaxWidth="300"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0"/>
                                        <Button x:Name="CheckForUpdatesButton"
                                                Content="{loc:Loc SettingsCheckForUpdates}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding CheckForUpdatesCommand}"
                                                Padding="14,8"
                                                VerticalAlignment="Center"/>
                                    </StackPanel>
                                </HeaderedContentControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- ============================ DEV MODE ============================ -->
                <StackPanel x:Name="DevModeTab"
                            Style="{StaticResource PageSurfaceStyle}"
                            views:Motion.Shown="{Binding IsDevModeSettingsTab}">

                    <TextBlock Text="{loc:Loc DevModeDescription}"
                               Style="{StaticResource BodyTextStyle}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="4,0,4,18"/>

                    <StackPanel Style="{StaticResource SectionStyle}">
                        <TextBlock Text="{loc:Loc DevModeSectionOverrides}" Style="{StaticResource PageSectionHeaderStyle}"/>
                        <Border Style="{StaticResource PageGroupStyle}">
                            <StackPanel>
                                <HeaderedContentControl Style="{StaticResource PageRowStyle}"
                                                        Header="{loc:Loc DevModeClient}">
                                    <ListBox x:Name="DevClientSegments"
                                             Style="{StaticResource SegmentedControlStyle}"
                                             SelectedValuePath="Tag"
                                             SelectedValue="{Binding DevClient}"
                                             AutomationProperties.Name="{loc:Loc DevModeClient}">
                                        <ListBoxItem Content="FiveM" Tag="{x:Static enums:GameClient.FiveM}"/>
                                        <ListBoxItem Content="RedM" Tag="{x:Static enums:GameClient.RedM}"/>
                                    </ListBox>
                                </HeaderedContentControl>

                                <Border Style="{StaticResource RowSeparatorStyle}"/>

                                <HeaderedContentControl Style="{StaticResource PageRowStyle}"
                                                        Header="{loc:Loc DetailGameBuild}">
                                    <ComboBox x:Name="DevGameBuildPicker"
                                              Style="{StaticResource RowPickerStyle}"
                                              ItemsSource="{Binding DevGameBuildOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Build"
                                              SelectedValue="{Binding DevGameBuild}"
                                              AutomationProperties.Name="{loc:Loc DetailGameBuild}"/>
                                </HeaderedContentControl>

                                <Border Style="{StaticResource RowSeparatorStyle}"/>

                                <HeaderedContentControl Style="{StaticResource PageRowStyle}"
                                                        Header="{loc:Loc DetailPureMode}">
                                    <ComboBox x:Name="DevPureModePicker"
                                              Style="{StaticResource RowPickerStyle}"
                                              SelectedValuePath="Tag"
                                              SelectedValue="{Binding DevPureMode}"
                                              AutomationProperties.Name="{loc:Loc DetailPureMode}">
                                        <ComboBoxItem Content="{loc:Loc PureModeNone}"/>
                                        <ComboBoxItem Content="0">
                                            <ComboBoxItem.Tag><sys:Int32>0</sys:Int32></ComboBoxItem.Tag>
                                        </ComboBoxItem>
                                        <ComboBoxItem Content="1">
                                            <ComboBoxItem.Tag><sys:Int32>1</sys:Int32></ComboBoxItem.Tag>
                                        </ComboBoxItem>
                                        <ComboBoxItem Content="2">
                                            <ComboBoxItem.Tag><sys:Int32>2</sys:Int32></ComboBoxItem.Tag>
                                        </ComboBoxItem>
                                    </ComboBox>
                                </HeaderedContentControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <WrapPanel>
                        <Button x:Name="DevLaunchButton"
                                Content="{loc:Loc DevModeLaunch}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding DevLaunchCommand}"
                                CommandParameter="{x:Null}"
                                MinHeight="46"
                                Padding="24,0"
                                Margin="0,0,10,10"/>
                        <Button x:Name="DevLaunchSecondButton"
                                Content="{loc:Loc DevModeLaunchSecondClient}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding DevLaunchCommand}"
                                CommandParameter="{x:Static viewModels:DevLaunchParams.SecondClient}"
                                MinHeight="46"
                                Padding="22,0"
                                Margin="0,0,10,10"/>
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>

</UserControl>
