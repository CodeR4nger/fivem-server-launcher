<!-- Add/edit server overlay dialog with its loopback side panel. DataContext is inherited (MainViewModel). -->
<UserControl x:Class="FiveMServerLauncher.Views.ServerDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:loc="clr-namespace:FiveMServerLauncher.Views"
             xmlns:views="clr-namespace:FiveMServerLauncher.Views">

    <UserControl.Resources>
        <views:ThemeResources/>
    </UserControl.Resources>

    <Border Background="#66000000"
            Padding="40,60"
            Opacity="0">

        <Border.Visibility>
            <MultiBinding Converter="{StaticResource PanelVisibilityStateConverter}"
                          Mode="OneWay">
                <Binding Path="IsServerDialogOpen"/>
                <Binding Path="Opacity"
                         RelativeSource="{RelativeSource Self}"/>
            </MultiBinding>
        </Border.Visibility>

        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsServerDialogOpen}" Value="True">
                        <DataTrigger.EnterActions>
                            <BeginStoryboard Storyboard="{StaticResource PanelFadeIn}"/>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                            <BeginStoryboard Storyboard="{StaticResource PanelFadeOut}"/>
                        </DataTrigger.ExitActions>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsServerDialogOpen}" Value="False">
                        <Setter Property="IsHitTestVisible" Value="False"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">

        <Border Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                Padding="20"
                MinWidth="320">

            <StackPanel>

                <TextBlock Text="{Binding ServerDialogTitle}"
                           Style="{StaticResource SectionHeaderStyle}"
                           Margin="0,0,0,12"/>

                <TextBlock Text="{loc:Loc NameField}"
                           Style="{StaticResource SectionHeaderStyle}"/>

                <TextBox Text="{Binding DialogServerName, UpdateSourceTrigger=PropertyChanged}"
                         Background="{StaticResource PanelLightBrush}"
                         Foreground="{StaticResource TextBrush}"
                         BorderBrush="{StaticResource BorderBrush}"
                         BorderThickness="1"
                         Padding="12,8"
                         FontSize="12"
                         MinHeight="38"
                         Margin="0,5,0,0"/>

                <TextBlock Text="{loc:Loc AddressField}"
                           Style="{StaticResource SectionHeaderStyle}"
                           Margin="0,10,0,0"/>

                <TextBox Text="{Binding DialogServerAddress, UpdateSourceTrigger=PropertyChanged}"
                         Background="{StaticResource PanelLightBrush}"
                         Foreground="{StaticResource TextBrush}"
                         BorderBrush="{StaticResource BorderBrush}"
                         BorderThickness="1"
                         Padding="12,8"
                         FontSize="12"
                         MinHeight="38"
                         Margin="0,5,0,0"/>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">

                    <CheckBox IsChecked="{Binding DialogRequiresSteam}"
                              Content="{loc:Loc RequiresSteamCheckbox}"
                              Foreground="{StaticResource SecondaryTextBrush}"
                              FontSize="11"/>

                    <CheckBox IsChecked="{Binding DialogRequiresDiscord}"
                              Content="{loc:Loc RequiresDiscordCheckbox}"
                              Foreground="{StaticResource SecondaryTextBrush}"
                              FontSize="11"
                              Margin="16,0,0,0"/>

                </StackPanel>

                <TextBlock Text="{Binding DialogError}"
                           Foreground="#E5533D"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0"/>

                <DockPanel Margin="0,14,0,0">

                    <Button Content="{loc:Loc CancelButton}"
                            MinHeight="32"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Left"
                            Command="{Binding CancelServerDialogCommand}"/>

                    <Button Content="{loc:Loc SaveButton}"
                            MinHeight="32"
                            Style="{StaticResource MainButtonStyle}"
                            HorizontalAlignment="Right"
                            MinWidth="90"
                            Command="{Binding SaveServerDialogCommand}"/>

                </DockPanel>

            </StackPanel>

        </Border>

        <!-- LOCAL DEV SIDE PANEL (loopback addresses only, slides in from the right) -->

        <Border Margin="10,0,0,0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                Padding="20"
                MinWidth="220"
                Opacity="0">

            <Border.Visibility>
                <MultiBinding Converter="{StaticResource PanelVisibilityStateConverter}"
                              Mode="OneWay">
                    <Binding Path="IsDialogLocalhost"/>
                    <Binding Path="Opacity"
                             RelativeSource="{RelativeSource Self}"/>
                </MultiBinding>
            </Border.Visibility>

            <Border.RenderTransform>
                <TranslateTransform X="60"/>
            </Border.RenderTransform>

            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDialogLocalhost}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)"
                                                         To="0"
                                                         Duration="0:0:0.25">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0:0:0.25"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)"
                                                         To="60"
                                                         Duration="0:0:0.25">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0:0:0.25"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsDialogLocalhost}" Value="False">
                            <Setter Property="IsHitTestVisible" Value="False"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel VerticalAlignment="Top">

                <TextBlock Text="{loc:Loc DialogLocalDevHeader}"
                           Style="{StaticResource SectionHeaderStyle}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12"/>

                <TextBlock Text="{loc:Loc DialogCfxIdField}"
                           Style="{StaticResource SectionHeaderStyle}"/>

                <TextBox Text="{Binding DialogCfxId, UpdateSourceTrigger=PropertyChanged}"
                         Background="{StaticResource PanelLightBrush}"
                         Foreground="{StaticResource TextBrush}"
                         BorderBrush="{StaticResource BorderBrush}"
                         BorderThickness="1"
                         Padding="12,8"
                         FontSize="12"
                         MinHeight="38"
                         Margin="0,5,0,0"/>

                <TextBlock Text="{loc:Loc GameBuildHeader}"
                           Style="{StaticResource SectionHeaderStyle}"
                           Margin="0,10,0,0"/>

                <ComboBox ItemsSource="{Binding DialogGameBuildOptions}"
                          DisplayMemberPath="Label"
                          SelectedValuePath="Build"
                          SelectedValue="{Binding DialogGameBuild}"
                          IsEnabled="{Binding IsDialogGameBuildEnabled}"
                          MinHeight="30"
                          VerticalContentAlignment="Center"
                          Margin="0,5,0,0"/>

                <TextBlock Text="{loc:Loc PureModeHeader}"
                           Style="{StaticResource SectionHeaderStyle}"
                           Margin="0,10,0,0"/>

                <ComboBox SelectedValue="{Binding DialogPureMode}"
                          SelectedValuePath="Tag"
                          MinHeight="30"
                          VerticalContentAlignment="Center"
                          Margin="0,5,0,0">

                    <ComboBoxItem Content="{loc:Loc PureModeNone}"/>
                    <ComboBoxItem Content="0">
                        <ComboBoxItem.Tag><sys:Int32>0</sys:Int32></ComboBoxItem.Tag>
                    </ComboBoxItem>
                    <ComboBoxItem Content="1">
                        <ComboBoxItem.Tag><sys:Int32>1</sys:Int32></ComboBoxItem.Tag>
                    </ComboBoxItem>
                    <ComboBoxItem Content="2">
                        <ComboBoxItem.Tag><sys:Int32>2</sys:Int32></ComboBoxItem.Tag>
                    </ComboBoxItem>

                </ComboBox>

                <TextBlock Text="{loc:Loc DialogGameField}"
                           Style="{StaticResource SectionHeaderStyle}"
                           Margin="0,10,0,0"/>

                <ComboBox ItemsSource="{Binding DialogGameClientOptions}"
                          DisplayMemberPath="Label"
                          SelectedValuePath="Game"
                          SelectedValue="{Binding DialogGameClient}"
                          MinHeight="30"
                          VerticalContentAlignment="Center"
                          Margin="0,5,0,0"/>

            </StackPanel>

        </Border>

        </StackPanel>

    </Border>

</UserControl>
