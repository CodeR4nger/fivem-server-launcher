<!-- Add/edit server modal: a scrim over the content panel and the bottom bar with one centred
     card (title + close, Name, Address, the requirement switches, the loopback-only local
     connection section, the inline error, Cancel / Save). The card body scrolls when it is
     taller than the room it has. Esc cancels, Enter saves; focus enters the card on open,
     cycles inside it and returns to the opener on close (ModalFocus). DataContext is
     inherited (MainViewModel). -->
<UserControl x:Class="FiveMServerLauncher.Views.ServerDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:loc="clr-namespace:FiveMServerLauncher.Views"
             xmlns:views="clr-namespace:FiveMServerLauncher.Views">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <views:ThemeResources/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Field caption above an input -->
            <Style x:Key="FieldCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>

            <!-- Border 1 + Padding 9 + the text view's 2 px gutter = the combo boxes' 12 px
                 content inset, so field text and combo text line up. -->
            <Style x:Key="FieldInputStyle" TargetType="TextBox" BasedOn="{StaticResource TextInputStyle}">
                <Setter Property="FontSize" Value="{StaticResource FontSizeRowTitle}"/>
                <Setter Property="Padding" Value="9,0"/>
                <Setter Property="Height" Value="44"/>
            </Style>

            <Style x:Key="FieldComboStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                <Setter Property="Height" Value="40"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <!-- A requirement row: label left, switch right -->
            <Style x:Key="SwitchLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,12,0"/>
            </Style>

            <!-- Enter submits the dialog, Space toggles the switch -->
            <Style x:Key="DialogSwitchStyle" TargetType="ToggleButton" BasedOn="{StaticResource ToggleSwitchStyle}">
                <Setter Property="KeyboardNavigation.AcceptsReturn" Value="False"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- The inline error takes no room while there is none -->
            <Style x:Key="DialogErrorStyle" TargetType="TextBlock" BasedOn="{StaticResource DangerTextStyle}">
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
                <Style.Triggers>
                    <Trigger Property="Text" Value="">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- SCRIM: fades in/out with the open flag; collapses once faded out -->
    <Border Background="{StaticResource ScrimBrush}"
            Padding="24"
            views:Motion.Shown="{Binding IsServerDialogOpen}">

        <Border.Visibility>
            <MultiBinding Converter="{StaticResource PanelVisibilityStateConverter}"
                          Mode="OneWay">
                <Binding Path="IsServerDialogOpen"/>
                <Binding Path="Opacity"
                         RelativeSource="{RelativeSource Self}"/>
            </MultiBinding>
        </Border.Visibility>

        <Border.Style>
            <StaticResource ResourceKey="FadeSurfaceStyle"/>
        </Border.Style>

        <!-- CARD: pops in -->
        <Border x:Name="ServerDialogCard"
                Style="{StaticResource ModalFrameStyle}"
                views:Motion.Shown="{Binding IsServerDialogOpen}"
                views:ModalFocus.IsOpen="{Binding IsServerDialogOpen}"
                Padding="0"
                Width="520"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                KeyboardNavigation.TabNavigation="Cycle"
                KeyboardNavigation.ControlTabNavigation="Cycle"
                KeyboardNavigation.DirectionalNavigation="Contained"
                AutomationProperties.Name="{Binding ServerDialogTitle}">

            <Border.InputBindings>
                <KeyBinding Key="Escape" Command="{Binding CancelServerDialogCommand}"/>
                <KeyBinding Key="Return" Command="{Binding SaveServerDialogCommand}"/>
            </Border.InputBindings>

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- BODY: scrolls when the card has less room than its fields -->

                <ScrollViewer x:Name="ServerDialogBody"
                              Grid.Row="1"
                              Margin="0,16,0,0"
                              Padding="28,0"
                              Focusable="False"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">

                    <StackPanel>

                        <TextBlock Text="{loc:Loc NameField}"
                                   Style="{StaticResource FieldCaptionStyle}"/>

                        <TextBox Text="{Binding DialogServerName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FieldInputStyle}"
                                 AutomationProperties.Name="{loc:Loc NameField}"/>

                        <TextBlock Text="{loc:Loc AddressField}"
                                   Style="{StaticResource FieldCaptionStyle}"
                                   Margin="0,14,0,6"/>

                        <TextBox Text="{Binding DialogServerAddress, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FieldInputStyle}"
                                 AutomationProperties.Name="{loc:Loc AddressField}"/>

                        <!-- REQUIREMENTS: two switch rows in one group -->

                        <Border Style="{StaticResource SettingsGroupStyle}"
                                CornerRadius="{StaticResource RadiusCard}"
                                Padding="16,0"
                                Margin="0,16,0,0">

                            <StackPanel>

                                <Grid MinHeight="52">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{loc:Loc RequiresSteamCheckbox}"
                                               Style="{StaticResource SwitchLabelStyle}"/>

                                    <ToggleButton Grid.Column="1"
                                                  IsChecked="{Binding DialogRequiresSteam}"
                                                  Style="{StaticResource DialogSwitchStyle}"
                                                  AutomationProperties.Name="{loc:Loc RequiresSteamCheckbox}"/>
                                </Grid>

                                <Border Height="1" Background="{StaticResource BorderBrush}"/>

                                <Grid MinHeight="52">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{loc:Loc RequiresDiscordCheckbox}"
                                               Style="{StaticResource SwitchLabelStyle}"/>

                                    <ToggleButton Grid.Column="1"
                                                  IsChecked="{Binding DialogRequiresDiscord}"
                                                  Style="{StaticResource DialogSwitchStyle}"
                                                  AutomationProperties.Name="{loc:Loc RequiresDiscordCheckbox}"/>
                                </Grid>

                            </StackPanel>

                        </Border>

                        <!-- LOCAL CONNECTION (loopback addresses only) -->

                        <StackPanel x:Name="LoopbackSection"
                                    Margin="0,18,0,0"
                                    Style="{StaticResource FadeSurfaceStyle}"
                                    views:Motion.Shown="{Binding IsDialogLocalhost}"
                                    IsVisibleChanged="LoopbackSection_IsVisibleChanged">

                            <StackPanel.Visibility>
                                <Binding Path="IsDialogLocalhost"
                                         Converter="{StaticResource BoolToVisibility}"/>
                            </StackPanel.Visibility>

                            <TextBlock Text="{loc:Loc DialogLocalDevHeader}"
                                       Style="{StaticResource SectionHeaderStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,10"/>

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0">

                                    <TextBlock Text="{loc:Loc DialogCfxIdField}"
                                               Style="{StaticResource FieldCaptionStyle}"/>

                                    <TextBox Text="{Binding DialogCfxId, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource FieldInputStyle}"
                                             Height="40"
                                             AutomationProperties.Name="{loc:Loc DialogCfxIdField}"/>

                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="2">

                                    <TextBlock Text="{loc:Loc DialogGameField}"
                                               Style="{StaticResource FieldCaptionStyle}"/>

                                    <ComboBox ItemsSource="{Binding DialogGameClientOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Game"
                                              SelectedValue="{Binding DialogGameClient}"
                                              Style="{StaticResource FieldComboStyle}"
                                              AutomationProperties.Name="{loc:Loc DialogGameField}"/>

                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,12,0,0">

                                    <TextBlock Text="{loc:Loc GameBuildHeader}"
                                               Style="{StaticResource FieldCaptionStyle}"/>

                                    <ComboBox ItemsSource="{Binding DialogGameBuildOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Build"
                                              SelectedValue="{Binding DialogGameBuild}"
                                              IsEnabled="{Binding IsDialogGameBuildEnabled}"
                                              Style="{StaticResource FieldComboStyle}"
                                              AutomationProperties.Name="{loc:Loc GameBuildHeader}"/>

                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,0,0">

                                    <TextBlock Text="{loc:Loc PureModeHeader}"
                                               Style="{StaticResource FieldCaptionStyle}"/>

                                    <ComboBox SelectedValue="{Binding DialogPureMode}"
                                              SelectedValuePath="Tag"
                                              Style="{StaticResource FieldComboStyle}"
                                              AutomationProperties.Name="{loc:Loc PureModeHeader}">

                                        <ComboBoxItem Content="{loc:Loc PureModeNone}"/>
                                        <ComboBoxItem Content="0">
                                            <ComboBoxItem.Tag><sys:Int32>0</sys:Int32></ComboBoxItem.Tag>
                                        </ComboBoxItem>
                                        <ComboBoxItem Content="1">
                                            <ComboBoxItem.Tag><sys:Int32>1</sys:Int32></ComboBoxItem.Tag>
                                        </ComboBoxItem>
                                        <ComboBoxItem Content="2">
                                            <ComboBoxItem.Tag><sys:Int32>2</sys:Int32></ComboBoxItem.Tag>
                                        </ComboBoxItem>

                                    </ComboBox>

                                </StackPanel>

                            </Grid>

                        </StackPanel>

                    </StackPanel>

                </ScrollViewer>

                <!-- FOOTER: the inline error, then Cancel / Save (always in view) -->

                <StackPanel Grid.Row="2" Margin="28,16,28,24">

                    <TextBlock Text="{Binding DialogError}"
                               Style="{StaticResource DialogErrorStyle}"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button Content="{loc:Loc CancelButton}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                MinHeight="44"
                                Padding="20,0"
                                Command="{Binding CancelServerDialogCommand}"/>

                        <Button Content="{loc:Loc SaveButton}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                MinHeight="44"
                                MinWidth="96"
                                Padding="26,0"
                                Margin="10,0,0,0"
                                Command="{Binding SaveServerDialogCommand}"/>

                    </StackPanel>

                </StackPanel>

                <!-- HEADER: title + close (declared last: tab order is the fields, Cancel, Save,
                     then close — focus opens on Name) -->

                <DockPanel Grid.Row="0" Margin="28,22,22,0">

                    <Button DockPanel.Dock="Right"
                            Content="✕"
                            FontSize="12"
                            Width="36"
                            Height="36"
                            Padding="0"
                            Margin="12,0,0,0"
                            Background="{StaticResource SurfaceHoverBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Style="{StaticResource IconButtonStyle}"
                            AutomationProperties.Name="{loc:Loc DialogClose}"
                            Command="{Binding CancelServerDialogCommand}"/>

                    <TextBlock Text="{Binding ServerDialogTitle}"
                               Style="{StaticResource PageTitleStyle}"
                               FontSize="20"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>

                </DockPanel>

            </Grid>

        </Border>

    </Border>

</UserControl>
