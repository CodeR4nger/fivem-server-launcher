<!-- CFX service status rows. DataContext is inherited (MainViewModel). -->
<UserControl x:Class="FiveMServerLauncher.Views.CfxStatusPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:FiveMServerLauncher.Views"
             xmlns:views="clr-namespace:FiveMServerLauncher.Views">

    <UserControl.Resources>
        <views:ThemeResources/>
    </UserControl.Resources>

    <StackPanel VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Margin="30,12">

        <StackPanel.Visibility>
            <MultiBinding Converter="{StaticResource PanelVisibilityStateConverter}"
                          ConverterParameter="invert"
                          Mode="OneWay">
                <Binding Path="IsDevMode"/>
                <Binding Path="Opacity"
                         RelativeSource="{RelativeSource Self}"/>
            </MultiBinding>
        </StackPanel.Visibility>

        <StackPanel.Style>
            <Style TargetType="StackPanel">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDevMode}" Value="False">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard Storyboard="{StaticResource PanelFadeIn}"/>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard Storyboard="{StaticResource PanelFadeOut}"/>
                    </DataTrigger.ExitActions>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsDevMode}" Value="True">
                        <Setter Property="IsHitTestVisible" Value="False"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </StackPanel.Style>

        <TextBlock Text="{loc:Loc CfxStatusHeader}"
                   Style="{StaticResource SectionHeaderStyle}"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>

        <ItemsControl ItemsSource="{Binding CfxStatuses}" Width="250">

            <ItemsControl.ItemTemplate>

                <DataTemplate>

                    <DockPanel Margin="0,3" LastChildFill="False">

                        <Ellipse DockPanel.Dock="Left"
                                 Width="8"
                                 Height="8"
                                 Fill="{Binding Status,
                                               Converter={StaticResource CfxStatusToBrushConverter}}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0"/>

                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding StatusLabel}"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>

                        <TextBlock DockPanel.Dock="Left"
                                   Text="{Binding DisplayName}"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>

                    </DockPanel>

                </DataTemplate>

            </ItemsControl.ItemTemplate>

        </ItemsControl>

    </StackPanel>

</UserControl>
