<!-- CFX service status (FiveM, FiveM Enhanced, RedM), compact for the bottom bar's left
     slot. DataContext is inherited (MainViewModel). -->
<UserControl x:Class="FiveMServerLauncher.Views.CfxStatusPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:FiveMServerLauncher.Views"
             xmlns:views="clr-namespace:FiveMServerLauncher.Views"
             AutomationProperties.Name="{loc:Loc CfxStatusHeader}">

    <UserControl.Resources>
        <views:ThemeResources/>
    </UserControl.Resources>

    <ItemsControl ItemsSource="{Binding CfxStatuses}"
                  Focusable="False"
                  Grid.IsSharedSizeScope="True">

        <ItemsControl.ItemTemplate>

            <DataTemplate>

                <Grid Margin="0,1">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="CfxStatusName"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Ellipse Grid.Column="0"
                             Width="8"
                             Height="8"
                             Fill="{Binding Status,
                                           Converter={StaticResource CfxStatusToBrushConverter}}"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0"/>

                    <TextBlock Grid.Column="1"
                               Text="{Binding DisplayName}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="{StaticResource FontSizeCaption}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>

                    <TextBlock Grid.Column="2"
                               Text="{Binding StatusLabel}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="{StaticResource FontSizeCaption}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                </Grid>

            </DataTemplate>

        </ItemsControl.ItemTemplate>

    </ItemsControl>

</UserControl>
