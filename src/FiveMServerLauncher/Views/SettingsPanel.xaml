<!-- Settings dropdown panel (preferred client, language, checkboxes). DataContext is inherited (MainViewModel). -->
<UserControl x:Class="FiveMServerLauncher.Views.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:FiveMServerLauncher.Views"
             xmlns:views="clr-namespace:FiveMServerLauncher.Views">

    <UserControl.Resources>
        <views:ThemeResources/>
    </UserControl.Resources>

    <Border VerticalAlignment="Top"
            Margin="14,10,14,0"
            Padding="14"
            Background="{StaticResource PanelLightBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            Opacity="0">

        <Border.Visibility>
            <MultiBinding Converter="{StaticResource PanelVisibilityStateConverter}"
                          Mode="OneWay">
                <Binding Path="IsSettingsOpen"/>
                <Binding Path="Opacity"
                         RelativeSource="{RelativeSource Self}"/>
            </MultiBinding>
        </Border.Visibility>

        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSettingsOpen}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard Storyboard="{StaticResource PanelFadeIn}"/>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard Storyboard="{StaticResource PanelFadeOut}"/>
                    </DataTrigger.ExitActions>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsSettingsOpen}" Value="False">
                        <Setter Property="IsHitTestVisible" Value="False"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <StackPanel VerticalAlignment="Top">

            <TextBlock Text="{loc:Loc PreferredOpenClientHeader}"
                       Style="{StaticResource SectionHeaderStyle}"/>

             <ComboBox ItemsSource="{Binding AvailableOpenClients}"
                       DisplayMemberPath="DisplayName"
                       SelectedItem="{Binding PreferredClientOption}"
                       Height="30"
                       Margin="0,6,0,6"
                       VerticalContentAlignment="Center"/>

            <TextBlock Text="{loc:Loc LanguageHeader}"
                       Style="{StaticResource SectionHeaderStyle}"/>

            <ComboBox ItemsSource="{Binding LanguageOptions}"
                      DisplayMemberPath="Label"
                      SelectedItem="{Binding SelectedLanguageOption}"
                      Height="30"
                      Margin="0,6,0,6"
                      VerticalContentAlignment="Center"/>

            <CheckBox IsChecked="{Binding AutoLaunch}"
                      Content="{loc:Loc AutoLaunchCheckbox}"
                      Foreground="{StaticResource TextBrush}"
                      FontSize="12"/>

            <CheckBox IsChecked="{Binding WebLinks}"
                      Content="{loc:Loc WebLinksCheckbox}"
                      Foreground="{StaticResource TextBrush}"
                      FontSize="12"
                      Margin="0,6,0,0"/>

            <CheckBox IsChecked="{Binding MinimizeToTray}"
                      Content="{loc:Loc MinimizeToTrayCheckbox}"
                      Foreground="{StaticResource TextBrush}"
                      FontSize="12"
                      Margin="0,6,0,0"/>

        </StackPanel>

    </Border>

</UserControl>
