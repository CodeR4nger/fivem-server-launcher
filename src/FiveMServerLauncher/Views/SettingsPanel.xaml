<!-- Settings group on the Settings page (preferred client, language, checkboxes). DataContext is inherited (MainViewModel). -->
<UserControl x:Class="FiveMServerLauncher.Views.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:FiveMServerLauncher.Views"
             xmlns:views="clr-namespace:FiveMServerLauncher.Views">

    <UserControl.Resources>
        <views:ThemeResources/>
    </UserControl.Resources>

    <Border VerticalAlignment="Top"
            Padding="14,14,14,18"
            Background="{StaticResource SettingsGroupBrush}"
            BorderBrush="{StaticResource BorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusGroup}">

        <StackPanel VerticalAlignment="Top">

            <TextBlock Text="{loc:Loc PreferredOpenClientHeader}"
                       Style="{StaticResource SectionHeaderStyle}"/>

             <ComboBox ItemsSource="{Binding AvailableOpenClients}"
                       DisplayMemberPath="DisplayName"
                       SelectedItem="{Binding PreferredClientOption}"
                       Height="30"
                       Margin="0,6,0,6"
                       VerticalContentAlignment="Center"/>

            <TextBlock Text="{loc:Loc LanguageHeader}"
                       Style="{StaticResource SectionHeaderStyle}"/>

            <ComboBox ItemsSource="{Binding LanguageOptions}"
                      DisplayMemberPath="Label"
                      SelectedItem="{Binding SelectedLanguageOption}"
                      Height="30"
                      Margin="0,6,0,6"
                      VerticalContentAlignment="Center"/>

            <CheckBox IsChecked="{Binding AutoLaunch}"
                      Content="{loc:Loc AutoLaunchCheckbox}"
                      Foreground="{StaticResource TextPrimaryBrush}"
                      FontSize="12"/>

            <CheckBox IsChecked="{Binding WebLinks}"
                      Content="{loc:Loc WebLinksCheckbox}"
                      Foreground="{StaticResource TextPrimaryBrush}"
                      FontSize="12"
                      Margin="0,6,0,0"/>

            <CheckBox IsChecked="{Binding MinimizeToTray}"
                      Content="{loc:Loc MinimizeToTrayCheckbox}"
                      Foreground="{StaticResource TextPrimaryBrush}"
                      FontSize="12"
                      Margin="0,6,0,0"/>

        </StackPanel>

    </Border>

</UserControl>
