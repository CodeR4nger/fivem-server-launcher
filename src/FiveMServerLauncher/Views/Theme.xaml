<!-- The app's single theme dictionary: every shared token, brush, style, template, converter
     instance and storyboard. Loaded ONCE per UI thread (ThemeResources caches the instance);
     every view control (and MainWindow) merges it through ThemeResources, never by Source.

     Token rule: each value is defined once, here. Two exceptions own their colours in code
     because they map data to colour: GameClientToBrushConverter (game tags #F5A623 /
     #4DA3FF / #E05252) and CfxStatusToBrushConverter (status dots #3FB950 / #D29922 /
     #E05252 / #7A7A7A); ServerMark owns the mark palette.

     Motion rule: every animation here is gated on the inherited views:Motion.IsEnabled
     (bound once at the MainWindow root; off by default). With it off no storyboard starts:
     a setter snaps the end state, and a RemoveStoryboard drops any held animation when it is
     switched off (clock removals apply on the next tick of a rendering element). An in/out
     pair lives on ONE trigger (EnterActions + ExitActions): storyboards begun by different
     triggers compose in layers by declaration order, so a later "out" trigger's held value
     would override an earlier "in" trigger forever. -->
<ResourceDictionary x:Class="FiveMServerLauncher.Views.Theme"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:views="clr-namespace:FiveMServerLauncher.Views">

    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
    <views:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibility"/>
    <views:BytesToImageSourceConverter x:Key="BytesToImageSourceConverter"/>
    <views:GameClientToBrushConverter x:Key="GameClientToBrushConverter"/>
    <views:CfxStatusToBrushConverter x:Key="CfxStatusToBrushConverter"/>
    <views:ServerMarkInitialsConverter x:Key="ServerMarkInitials"/>
    <views:ServerMarkBrushConverter x:Key="ServerMarkBrush"/>
    <views:ServerMarkFontSizeConverter x:Key="ServerMarkFontSize"/>

    <views:SelectionEqualityToVisibilityConverter x:Key="SelectionEqualityToVisibility"/>
    <views:DropdownOpenStateConverter x:Key="DropdownOpenStateConverter"/>
    <views:PanelVisibilityStateConverter x:Key="PanelVisibilityStateConverter"/>
    <views:AnyTrueToVisibilityConverter x:Key="AnyTrueToVisibility"/>

    <!-- ============================== TOKENS ============================== -->

    <!-- Font: Inter (bundled static weights 400/500/600/700/800), Segoe UI fallback.
         Set once at the MainWindow root; popups that do not inherit set it in their style. -->
    <FontFamily x:Key="UiFontFamily">pack://application:,,,/CFXLauncher;component/Assets/Fonts/#Inter, Segoe UI</FontFamily>

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="GroundBrush" Color="#161616"/>
    <SolidColorBrush x:Key="TitleBarBrush" Color="#111111"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#222222"/>
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#333333"/>
    <SolidColorBrush x:Key="SettingsGroupBrush" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="InputBrush" Color="#1B1B1B"/>
    <SolidColorBrush x:Key="FooterBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="ScrimBrush" Color="#99000000"/>

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#2E2E2E"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#353535"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#3A3A3A"/>

    <!-- Text (each pair with its backgrounds is pinned >= 4.5:1 by ThemeContrastTests) -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B0B0B0"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#A8A8A8"/>
    <SolidColorBrush x:Key="FooterTextBrush" Color="#8A8A8A"/>
    <SolidColorBrush x:Key="DangerTextBrush" Color="#FF8A80"/>

    <!-- Accent: the primary pill button only -->
    <SolidColorBrush x:Key="AccentBrush" Color="#F5A623"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#1A1A1A"/>

    <!-- Selected chip / active tab: fill TextPrimaryBrush, text OnSelectedBrush -->
    <SolidColorBrush x:Key="OnSelectedBrush" Color="#1A1A1A"/>

    <!-- Game tag text (the fill comes from GameClientToBrushConverter) -->
    <SolidColorBrush x:Key="GameTagTextBrush" Color="#101010"/>

    <!-- Hover/press feedback layers (drawn over a fill at low opacity) -->
    <SolidColorBrush x:Key="HoverLayerBrush" Color="#FFFFFF"/>
    <sys:Double x:Key="HoverLayerOpacity">0.08</sys:Double>
    <sys:Double x:Key="PressLayerOpacity">0.16</sys:Double>

    <!-- Radii -->
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>
    <CornerRadius x:Key="RadiusPanel">22</CornerRadius>
    <CornerRadius x:Key="RadiusModal">22</CornerRadius>
    <CornerRadius x:Key="RadiusGroup">16</CornerRadius>
    <CornerRadius x:Key="RadiusCard">14</CornerRadius>
    <CornerRadius x:Key="RadiusMenu">14</CornerRadius>
    <CornerRadius x:Key="RadiusInput">12</CornerRadius>
    <CornerRadius x:Key="RadiusItem">8</CornerRadius>
    <CornerRadius x:Key="RadiusTag">3</CornerRadius>

    <!-- Shell: the fixed page-tab width (the sliding highlight moves by whole tabs; the
         shell layout test pins every language's label inside it) and the open-client slot. -->
    <sys:Double x:Key="NavTabWidthValue">128</sys:Double>
    <GridLength x:Key="NavTabWidth">128</GridLength>
    <sys:Double x:Key="OpenClientSlotWidth">260</sys:Double>

    <!-- Type ramp -->
    <sys:Double x:Key="FontSizePageTitle">22</sys:Double>
    <sys:Double x:Key="FontSizeRowTitle">14</sys:Double>
    <sys:Double x:Key="FontSizeBody">13</sys:Double>
    <sys:Double x:Key="FontSizeCaption">12</sys:Double>
    <sys:Double x:Key="FontSizeSectionHeader">11</sys:Double>
    <sys:Double x:Key="FontSizeTag">10</sys:Double>

    <!-- ============================== MOTION ============================== -->

    <!-- Durations 150–350 ms, standard ease-out; nothing waits for them (no input gating). -->
    <Duration x:Key="MotionFast">0:0:0.15</Duration>
    <Duration x:Key="MotionMedium">0:0:0.25</Duration>
    <CubicEase x:Key="MotionEase" EasingMode="EaseOut"/>

    <!-- Fade: target = the styled element -->
    <Storyboard x:Key="MotionFadeIn">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1"
                         Duration="{StaticResource MotionMedium}"
                         EasingFunction="{StaticResource MotionEase}"/>
    </Storyboard>

    <Storyboard x:Key="MotionFadeOut">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0"
                         Duration="{StaticResource MotionMedium}"
                         EasingFunction="{StaticResource MotionEase}"/>
    </Storyboard>

    <!-- Slide in: the element needs a TranslateTransform as RenderTransform -->
    <Storyboard x:Key="MotionSlideIn">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1"
                         Duration="{StaticResource MotionMedium}"
                         EasingFunction="{StaticResource MotionEase}"/>
        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)" From="16" To="0"
                         Duration="{StaticResource MotionMedium}"
                         EasingFunction="{StaticResource MotionEase}"/>
    </Storyboard>

    <!-- Pop (dialogs): the element needs a ScaleTransform as RenderTransform -->
    <Storyboard x:Key="MotionPopIn">
        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" From="0.96" To="1"
                         Duration="{StaticResource MotionMedium}"
                         EasingFunction="{StaticResource MotionEase}"/>
        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" From="0.96" To="1"
                         Duration="{StaticResource MotionMedium}"
                         EasingFunction="{StaticResource MotionEase}"/>
    </Storyboard>

    <!-- Drop (menus): the element needs a TranslateTransform as RenderTransform -->
    <Storyboard x:Key="MotionDropIn">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1"
                         Duration="{StaticResource MotionFast}"
                         EasingFunction="{StaticResource MotionEase}"/>
        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" From="-6" To="0"
                         Duration="{StaticResource MotionFast}"
                         EasingFunction="{StaticResource MotionEase}"/>
    </Storyboard>

    <!-- A surface shown/hidden by a view-model flag: bind views:Motion.Shown to the flag
         (and keep the element's Visibility on PanelVisibilityStateConverter so it collapses
         once faded). Fades with motion on; snaps with motion off. -->
    <Style x:Key="FadeSurfaceStyle" TargetType="{x:Type FrameworkElement}">
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Style.Triggers>
            <Trigger Property="views:Motion.Shown" Value="True">
                <Setter Property="IsHitTestVisible" Value="True"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="views:Motion.Shown" Value="True"/>
                    <Condition Property="views:Motion.IsEnabled" Value="True"/>
                </MultiTrigger.Conditions>
                <MultiTrigger.EnterActions>
                    <BeginStoryboard x:Name="SurfaceFadeIn" Storyboard="{StaticResource MotionFadeIn}"/>
                </MultiTrigger.EnterActions>
                <MultiTrigger.ExitActions>
                    <BeginStoryboard x:Name="SurfaceFadeOut" Storyboard="{StaticResource MotionFadeOut}"/>
                </MultiTrigger.ExitActions>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="views:Motion.Shown" Value="True"/>
                    <Condition Property="views:Motion.IsEnabled" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter Property="Opacity" Value="1"/>
            </MultiTrigger>
            <Trigger Property="views:Motion.IsEnabled" Value="False">
                <Trigger.EnterActions>
                    <RemoveStoryboard BeginStoryboardName="SurfaceFadeIn"/>
                    <RemoveStoryboard BeginStoryboardName="SurfaceFadeOut"/>
                </Trigger.EnterActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Page in (the shell's pages): fade up from a short rise. The element needs a
         TranslateTransform as RenderTransform (PageSurfaceStyle sets one). -->
    <Storyboard x:Key="MotionPageIn">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1"
                         Duration="{StaticResource MotionMedium}"
                         EasingFunction="{StaticResource MotionEase}"/>
        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" From="12" To="0"
                         Duration="{StaticResource MotionMedium}"
                         EasingFunction="{StaticResource MotionEase}"/>
    </Storyboard>

    <!-- A page of the shell: bind views:Motion.Shown to the page flag (IsServersPage, ...).
         Shown → visible, and with motion on it fades/slides in; hidden → collapsed at once
         (the incoming page carries the motion, so nothing fades out underneath it). The in
         storyboard and its removal sit on ONE trigger: storyboards begun by different
         triggers compose in layers by declaration order. -->
    <Style x:Key="PageSurfaceStyle" TargetType="{x:Type FrameworkElement}">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform/>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="views:Motion.Shown" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="views:Motion.Shown" Value="True"/>
                    <Condition Property="views:Motion.IsEnabled" Value="True"/>
                </MultiTrigger.Conditions>
                <MultiTrigger.EnterActions>
                    <BeginStoryboard x:Name="PageIn" Storyboard="{StaticResource MotionPageIn}"/>
                </MultiTrigger.EnterActions>
                <MultiTrigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="PageIn"/>
                </MultiTrigger.ExitActions>

            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <!-- ============================== TEXT ============================== -->

    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizePageTitle}"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- Section header: 11 bold uppercase (the strings are uppercase; WPF TextBlock has no
         letter-spacing, so the tracking of the mockup is not reproduced) -->
    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeSectionHeader}"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="RowTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeRowTitle}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
    </Style>

    <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
    </Style>

    <Style x:Key="DangerTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource DangerTextBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Empty state: a centred, wrapped secondary message inside a list or page -->
    <Style x:Key="EmptyStateTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="24"/>
    </Style>

    <!-- ============================== SURFACES ============================== -->

    <!-- Content panel (the large rounded areas on the ground) -->
    <Style x:Key="ContentPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusPanel}"/>
    </Style>

    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}"/>
    </Style>

    <Style x:Key="SettingsGroupStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SettingsGroupBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusGroup}"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <!-- Modal frame: the dialog body over a scrim. Bind views:Motion.Shown to the dialog's
         open flag to pop it in. -->
    <Style x:Key="ModalFrameStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusModal}"/>
        <Setter Property="Padding" Value="24"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform/>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="views:Motion.Shown" Value="True"/>
                    <Condition Property="views:Motion.IsEnabled" Value="True"/>
                </MultiTrigger.Conditions>
                <MultiTrigger.EnterActions>
                    <BeginStoryboard x:Name="ModalPopIn" Storyboard="{StaticResource MotionPopIn}"/>
                </MultiTrigger.EnterActions>
            </MultiTrigger>
            <Trigger Property="views:Motion.IsEnabled" Value="False">
                <Trigger.EnterActions>
                    <RemoveStoryboard BeginStoryboardName="ModalPopIn"/>
                </Trigger.EnterActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Settings row: Header = title, Tag = description, Content = the control (right) -->
    <Style x:Key="SettingsRowStyle" TargetType="HeaderedContentControl">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Padding" Value="0,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <Grid Margin="{TemplateBinding Padding}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{TemplateBinding Header}"
                                       Style="{StaticResource RowTitleStyle}"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="Description"
                                       Text="{TemplateBinding Tag}"
                                       Style="{StaticResource CaptionTextStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{x:Null}">
                            <Setter TargetName="Description" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================== BUTTONS ============================== -->

    <!-- Keyboard focus ring (focus visuals appear for keyboard navigation only) -->
    <Style x:Key="PillFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <views:RoundedBorder Margin="-3"
                            BorderBrush="{StaticResource TextPrimaryBrush}"
                            BorderThickness="2"
                            CornerRadius="{StaticResource RadiusPill}"
                            SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The shared pill: a fill + border, a hover/press layer and the content. Hover and
         press ease the layer's opacity (150 ms) with motion on and snap it with motion off. -->
    <ControlTemplate x:Key="PillButtonTemplate" TargetType="{x:Type ButtonBase}">
        <Grid SnapsToDevicePixels="True">
            <views:RoundedBorder x:Name="Chrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding views:Shape.CornerRadius}"/>
            <views:RoundedBorder x:Name="HoverLayer"
                    Background="{StaticResource HoverLayerBrush}"
                    CornerRadius="{TemplateBinding views:Shape.CornerRadius}"
                    Opacity="0"
                    IsHitTestVisible="False"/>
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True"/>
        </Grid>
        <ControlTemplate.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True"/>
                    <Condition Property="views:Motion.IsEnabled" Value="True"/>
                </MultiTrigger.Conditions>
                <MultiTrigger.EnterActions>
                    <BeginStoryboard x:Name="HoverIn">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                             Storyboard.TargetProperty="Opacity"
                                             To="{StaticResource HoverLayerOpacity}"
                                             Duration="{StaticResource MotionFast}"
                                             EasingFunction="{StaticResource MotionEase}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiTrigger.EnterActions>
                <MultiTrigger.ExitActions>
                    <BeginStoryboard x:Name="HoverOut">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                             Storyboard.TargetProperty="Opacity"
                                             To="0"
                                             Duration="{StaticResource MotionFast}"
                                             EasingFunction="{StaticResource MotionEase}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiTrigger.ExitActions>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsPressed" Value="True"/>
                    <Condition Property="views:Motion.IsEnabled" Value="True"/>
                </MultiTrigger.Conditions>
                <MultiTrigger.EnterActions>
                    <BeginStoryboard x:Name="PressIn">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                             Storyboard.TargetProperty="Opacity"
                                             To="{StaticResource PressLayerOpacity}"
                                             Duration="{StaticResource MotionFast}"
                                             EasingFunction="{StaticResource MotionEase}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiTrigger.EnterActions>
                <!-- Release REMOVES the press instead of animating to the hover value: this
                     trigger is declared after the hover one, so a value it holds would outrank
                     the hover fade-out forever (a clicked tab kept its grey fill after the
                     pointer left). Removal hands the layer back to the hover storyboards. -->
                <MultiTrigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="PressIn"/>
                </MultiTrigger.ExitActions>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True"/>
                    <Condition Property="views:Motion.IsEnabled" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="HoverLayer" Property="Opacity" Value="{StaticResource HoverLayerOpacity}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsPressed" Value="True"/>
                    <Condition Property="views:Motion.IsEnabled" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="HoverLayer" Property="Opacity" Value="{StaticResource PressLayerOpacity}"/>
            </MultiTrigger>
            <Trigger Property="views:Motion.IsEnabled" Value="False">
                <Trigger.EnterActions>
                    <RemoveStoryboard BeginStoryboardName="HoverIn"/>
                    <RemoveStoryboard BeginStoryboardName="HoverOut"/>
                    <RemoveStoryboard BeginStoryboardName="PressIn"/>
                </Trigger.EnterActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="PillButtonBaseStyle" TargetType="{x:Type ButtonBase}">
        <Setter Property="views:Shape.CornerRadius" Value="{StaticResource RadiusPill}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="18,9"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource PillFocusVisual}"/>
        <Setter Property="Template" Value="{StaticResource PillButtonTemplate}"/>
    </Style>

    <!-- Primary pill: the one amber action on a surface -->
    <Style x:Key="PrimaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource PillButtonBaseStyle}">
        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- Secondary pill: raised neutral fill -->
    <Style x:Key="SecondaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource PillButtonBaseStyle}">
        <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <!-- Icon button: a round, borderless glyph button (refresh, add, the actions ⋮) -->
    <Style x:Key="IconButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource PillButtonBaseStyle}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Padding" Value="6"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A bottom-bar page tab: borderless text on the nav track. Tag = the page flag
         (IsServersPage, ...): the selected tab sits on the sliding TextPrimary highlight, so
         its text turns OnSelected (dark). The highlight itself is drawn by the bar. -->
    <Style x:Key="NavTabStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource PillButtonBaseStyle}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Padding" Value="12,0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            </Trigger>
            <Trigger Property="Tag">
                <Trigger.Value>
                    <sys:Boolean>True</sys:Boolean>
                </Trigger.Value>
                <Setter Property="Foreground" Value="{StaticResource OnSelectedBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Filter chip (ToggleButton/RadioButton): unselected raised + strong border, selected
         light fill with dark text. Compose an optional dot (ChipDotStyle) and count
         (ChipCountStyle) inside the content. -->
    <Style x:Key="FilterChipStyle" TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource PillButtonBaseStyle}">
        <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
        <Setter Property="Padding" Value="14,6"/>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource OnSelectedBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ChipDotStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Height" Value="8"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="ChipCountStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="6,0,0,0"/>
        <Setter Property="Opacity" Value="0.75"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Toggle switch: a styled ToggleButton (keyboard + Toggle pattern for screen readers).
         50x28 track, 20 px knob sliding 4 -> 26. Off: strong-border track, light knob;
         on: light track, dark knob. -->
    <Style x:Key="ToggleSwitchStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Width" Value="50"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource PillFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Track"
                                Background="{StaticResource BorderStrongBrush}"
                                CornerRadius="14"/>
                        <Ellipse x:Name="Knob"
                                 Width="20"
                                 Height="20"
                                 Fill="{StaticResource TextPrimaryBrush}"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center">
                            <Ellipse.RenderTransform>
                                <TranslateTransform X="4"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource TextPrimaryBrush}"/>
                            <Setter TargetName="Knob" Property="Fill" Value="{StaticResource OnSelectedBrush}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True"/>
                                <Condition Property="views:Motion.IsEnabled" Value="True"/>
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard x:Name="KnobOn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Knob"
                                                         Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)"
                                                         To="26"
                                                         Duration="{StaticResource MotionFast}"
                                                         EasingFunction="{StaticResource MotionEase}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard x:Name="KnobOff">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Knob"
                                                         Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)"
                                                         To="4"
                                                         Duration="{StaticResource MotionFast}"
                                                         EasingFunction="{StaticResource MotionEase}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True"/>
                                <Condition Property="views:Motion.IsEnabled" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Knob" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform X="26"/>
                                </Setter.Value>
                            </Setter>
                        </MultiTrigger>
                        <Trigger Property="views:Motion.IsEnabled" Value="False">
                            <Trigger.EnterActions>
                                <RemoveStoryboard BeginStoryboardName="KnobOn"/>
                                <RemoveStoryboard BeginStoryboardName="KnobOff"/>
                            </Trigger.EnterActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Segmented control: a horizontal ListBox (keyboard selection for free) in an input
         pill; the selected segment is the light fill with dark text. -->
    <Style x:Key="SegmentItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource PillFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <views:RoundedBorder x:Name="Segment"
                            Background="Transparent"
                            CornerRadius="{StaticResource RadiusPill}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </views:RoundedBorder>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Segment" Property="Background" Value="{StaticResource TextPrimaryBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource OnSelectedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SegmentedControlStyle" TargetType="{x:Type ListBox}">
        <Setter Property="ItemContainerStyle" Value="{StaticResource SegmentItemStyle}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBox}">
                    <views:RoundedBorder Background="{StaticResource InputBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusPill}"
                            Padding="3">
                        <ItemsPresenter/>
                    </views:RoundedBorder>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================== DATA MARKS ============================== -->

    <!-- Filled game tag: Border (fill bound through GameClientToBrushConverter) + text -->
    <Style x:Key="GameTagStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource RadiusTag}"/>
        <Setter Property="Padding" Value="5,1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="GameTagTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource GameTagTextBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeTag}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Server mark: Content = icon bytes, Tag = server name. The icon when there is one,
         else the name's initials on its deterministic colour (ServerMark). Size it with
         Width/Height. -->
    <Style x:Key="ServerMarkStyle" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border x:Name="Initials"
                                Background="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ServerMarkBrush}}"
                                CornerRadius="6"
                                Visibility="Collapsed">
                            <!-- A fixed share of the mark (ServerMark.InitialsFontSize), never a
                                 shrink-to-fit Viewbox: "WW" renders as large as "LS". -->
                            <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ServerMarkInitials}}"
                                       FontSize="{Binding ActualHeight, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ServerMarkFontSize}}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <Image x:Name="Icon"
                               Source="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BytesToImageSourceConverter}}"
                               Stretch="Uniform"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Initials" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================== INPUTS ============================== -->

    <!-- Text input: rounded 12 well; PillTextInputStyle is the fully rounded variant -->
    <Style x:Key="TextInputStyle" TargetType="{x:Type TextBox}">
        <Setter Property="views:Shape.CornerRadius" Value="{StaticResource RadiusInput}"/>
        <Setter Property="Background" Value="{StaticResource InputBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <views:RoundedBorder x:Name="Well"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding views:Shape.CornerRadius}"
                            SnapsToDevicePixels="True">
                        <!-- No Margin from Padding here: the TextBox already hands its Padding to
                             the text view inside this host, so binding it again doubled the inset.
                             Text starts at BorderThickness + Padding + the text view's 2 px gutter;
                             an overlaid placeholder's left margin is that same sum. -->
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                    </views:RoundedBorder>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Well" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Well" Property="BorderBrush" Value="{StaticResource TextSecondaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PillTextInputStyle" TargetType="{x:Type TextBox}" BasedOn="{StaticResource TextInputStyle}">
        <Setter Property="views:Shape.CornerRadius" Value="{StaticResource RadiusPill}"/>
    </Style>

    <!-- The search-box placeholder laid over a TextInputStyle box -->
    <Style x:Key="PlaceholderTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- THIN DARK SCROLLBAR (implicit: applies inside every control that merges the theme, never app-wide) -->

    <Style TargetType="{x:Type ScrollBar}">

        <Setter Property="Width" Value="6"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="{x:Type ScrollBar}">

                    <Grid UseLayoutRounding="True">

                        <Track x:Name="PART_Track"
                               IsDirectionReversed="True"
                               IsEnabled="True">

                            <Track.Thumb>

                                <Thumb>

                                    <Thumb.Template>

                                        <ControlTemplate TargetType="{x:Type Thumb}">

                                            <Rectangle Fill="{StaticResource BorderStrongBrush}"
                                                       RadiusX="3"
                                                       RadiusY="3"/>

                                        </ControlTemplate>

                                    </Thumb.Template>

                                </Thumb>

                            </Track.Thumb>

                            <Track.DecreaseRepeatButton>

                                <RepeatButton Command="{x:Static ScrollBar.LineUpCommand}"
                                              Focusable="False"
                                              IsTabStop="False"
                                              Background="Transparent"
                                              BorderThickness="0">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>

                            </Track.DecreaseRepeatButton>

                            <Track.IncreaseRepeatButton>

                                <RepeatButton Command="{x:Static ScrollBar.LineDownCommand}"
                                              Focusable="False"
                                              IsTabStop="False"
                                              Background="Transparent"
                                              BorderThickness="0">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>

                            </Track.IncreaseRepeatButton>

                        </Track>

                    </Grid>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>

    <!-- ============================== DROPDOWN ============================== -->

    <!-- COMBOBOX TOGGLE (closed box + chevron) -->

    <ControlTemplate x:Key="ComboBoxToggleTemplate" TargetType="{x:Type ToggleButton}">

        <Border x:Name="ToggleBorder"
                Background="{StaticResource InputBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusInput}"
                SnapsToDevicePixels="True">

            <TextBlock Text="▾"
                       FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>

        </Border>

        <ControlTemplate.Triggers>

            <Trigger Property="IsMouseOver" Value="True">

                <Setter TargetName="ToggleBorder"
                        Property="BorderBrush"
                        Value="{StaticResource BorderStrongBrush}"/>

            </Trigger>

            <DataTrigger Binding="{Binding IsKeyboardFocusWithin,
                                           RelativeSource={RelativeSource AncestorType=ComboBox}}"
                         Value="True">

                <Setter TargetName="ToggleBorder"
                        Property="BorderBrush"
                        Value="{StaticResource TextSecondaryBrush}"/>

            </DataTrigger>

        </ControlTemplate.Triggers>

    </ControlTemplate>

    <!-- COMBOBOX ITEM (popup rows) -->

    <Style TargetType="{x:Type ComboBoxItem}">

        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="{x:Type ComboBoxItem}">

                    <Border x:Name="ItemBorder"
                            Background="Transparent"
                            CornerRadius="{StaticResource RadiusItem}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">

                        <ContentPresenter VerticalAlignment="Center"/>

                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsSelected" Value="True">

                            <Setter Property="FontWeight" Value="SemiBold"/>

                        </Trigger>

                        <Trigger Property="IsHighlighted" Value="True">

                            <Setter TargetName="ItemBorder"
                                    Property="Background"
                                    Value="{StaticResource SurfaceHoverBrush}"/>

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>

    <!-- COMBOBOX (dark, non-editable). The popup drops in with motion on (scale + fade,
         the CloseHold marker keeps the popup alive for the close motion); with motion off
         it snaps open and shut. -->

    <Style TargetType="{x:Type ComboBox}">

        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="{x:Type ComboBox}">

                    <Grid>

                        <ToggleButton Focusable="False"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen,
                                                          Mode=TwoWay,
                                                          RelativeSource={RelativeSource TemplatedParent}}"
                                      Template="{StaticResource ComboBoxToggleTemplate}"/>

                        <ContentPresenter IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          Margin="12,0,26,0"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

                        <!-- Collapsed marker holding the popup open for the
                             ~200 ms of close animation: its Opacity is snapped
                             to 1 on open and released by a discrete keyframe
                             when the collapse completes, so the closing motion
                             renders inside a still-alive popup. -->
                        <TextBlock x:Name="CloseHold"
                                   Opacity="0"
                                   Visibility="Collapsed"/>

                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               VerticalOffset="4"
                               Placement="Bottom">

                            <Popup.IsOpen>
                                <MultiBinding Converter="{StaticResource DropdownOpenStateConverter}"
                                              Mode="OneWay">
                                    <Binding Path="IsDropDownOpen"
                                             RelativeSource="{RelativeSource TemplatedParent}"/>
                                    <Binding Path="Opacity"
                                             ElementName="CloseHold"/>
                                </MultiBinding>
                            </Popup.IsOpen>

                            <Border x:Name="DropDownBorder"
                                    Background="{StaticResource SurfaceRaisedBrush}"
                                    BorderBrush="{StaticResource BorderStrongBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusMenu}"
                                    Padding="4"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    Opacity="0"
                                    SnapsToDevicePixels="True">

                                <Border.RenderTransform>
                                    <ScaleTransform ScaleY="0"/>
                                </Border.RenderTransform>

                                <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}">

                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>

                                </ScrollViewer>

                            </Border>

                        </Popup>

                    </Grid>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsEnabled" Value="False">

                            <Setter Property="Opacity" Value="0.45"/>

                        </Trigger>

                        <MultiTrigger>

                            <MultiTrigger.Conditions>
                                <Condition Property="IsDropDownOpen" Value="True"/>
                                <Condition Property="views:Motion.IsEnabled" Value="True"/>
                            </MultiTrigger.Conditions>

                            <MultiTrigger.EnterActions>

                                <BeginStoryboard x:Name="DropDownOpen">

                                    <Storyboard>

                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CloseHold"
                                                                       Storyboard.TargetProperty="Opacity">

                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/>

                                        </DoubleAnimationUsingKeyFrames>

                                        <DoubleAnimation Storyboard.TargetName="DropDownBorder"
                                                         Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                         To="1"
                                                         Duration="0:0:0.2"
                                                         EasingFunction="{StaticResource MotionEase}"/>

                                        <DoubleAnimation Storyboard.TargetName="DropDownBorder"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0:0:0.2"/>

                                    </Storyboard>

                                </BeginStoryboard>

                            </MultiTrigger.EnterActions>

                            <MultiTrigger.ExitActions>

                                <BeginStoryboard x:Name="DropDownClose">

                                    <Storyboard>

                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CloseHold"
                                                                       Storyboard.TargetProperty="Opacity">

                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/>

                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.2" Value="0"/>

                                        </DoubleAnimationUsingKeyFrames>

                                        <DoubleAnimation Storyboard.TargetName="DropDownBorder"
                                                         Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                         To="0"
                                                         Duration="0:0:0.2"
                                                         EasingFunction="{StaticResource MotionEase}"/>

                                        <DoubleAnimation Storyboard.TargetName="DropDownBorder"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0:0:0.2"/>

                                    </Storyboard>

                                </BeginStoryboard>

                            </MultiTrigger.ExitActions>

                        </MultiTrigger>

                        <MultiTrigger>

                            <MultiTrigger.Conditions>
                                <Condition Property="IsDropDownOpen" Value="True"/>
                                <Condition Property="views:Motion.IsEnabled" Value="False"/>
                            </MultiTrigger.Conditions>

                            <Setter TargetName="DropDownBorder" Property="Opacity" Value="1"/>

                            <Setter TargetName="DropDownBorder" Property="RenderTransform" Value="{x:Null}"/>

                        </MultiTrigger>

                        <Trigger Property="views:Motion.IsEnabled" Value="False">

                            <Trigger.EnterActions>
                                <RemoveStoryboard BeginStoryboardName="DropDownOpen"/>
                                <RemoveStoryboard BeginStoryboardName="DropDownClose"/>
                            </Trigger.EnterActions>

                        </Trigger>

                        <Trigger Property="IsDropDownOpen" Value="False">

                            <Setter TargetName="DropDownBorder"
                                    Property="IsHitTestVisible"
                                    Value="False"/>

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>

    <!-- CHECKBOX (input box, light fill with a dark check when on) -->

    <Style TargetType="{x:Type CheckBox}">

        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="{x:Type CheckBox}">

                    <!-- A Grid, not a horizontal StackPanel: a StackPanel gives the
                         label unlimited width, so a long label could never wrap and
                         was cut off by its container instead. -->
                    <Grid Background="Transparent">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="CheckBoxBox"
                                Width="16"
                                Height="16"
                                Background="{StaticResource InputBrush}"
                                BorderBrush="{StaticResource BorderStrongBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                VerticalAlignment="Top"
                                SnapsToDevicePixels="True">

                            <Path x:Name="CheckMark"
                                  Data="M 3,8 L 6.5,11.5 L 11,3.5"
                                  Stroke="{StaticResource OnSelectedBrush}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Visibility="Collapsed"/>

                        </Border>

                        <ContentPresenter Grid.Column="1"
                                          Margin="8,0,0,0"
                                          VerticalAlignment="Center">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>

                    </Grid>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver" Value="True">

                            <Setter TargetName="CheckBoxBox"
                                    Property="BorderBrush"
                                    Value="{StaticResource TextSecondaryBrush}"/>

                        </Trigger>

                        <Trigger Property="IsChecked" Value="True">

                            <Setter TargetName="CheckMark"
                                    Property="Visibility"
                                    Value="Visible"/>

                            <Setter TargetName="CheckBoxBox"
                                    Property="Background"
                                    Value="{StaticResource TextPrimaryBrush}"/>

                            <Setter TargetName="CheckBoxBox"
                                    Property="BorderBrush"
                                    Value="{StaticResource TextPrimaryBrush}"/>

                        </Trigger>

                        <Trigger Property="IsKeyboardFocusWithin" Value="True">

                            <Setter TargetName="CheckBoxBox"
                                    Property="BorderBrush"
                                    Value="{StaticResource TextSecondaryBrush}"/>

                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">

                            <Setter Property="Opacity" Value="0.45"/>

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>

    <!-- ============================== POPUP MENU ============================== -->

    <!-- A ContextMenu does not inherit from the window: its font and motion switch are taken
         here (motion from the PlacementTarget, which is in the window). Drops in with motion. -->
    <Style x:Key="PopupMenuStyle" TargetType="ContextMenu">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="views:Motion.IsEnabled"
                Value="{Binding PlacementTarget.(views:Motion.IsEnabled), RelativeSource={RelativeSource Self}}"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMenu}"
                            Padding="6">
                        <ItemsPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsOpen" Value="True"/>
                    <Condition Property="views:Motion.IsEnabled" Value="True"/>
                </MultiTrigger.Conditions>
                <MultiTrigger.EnterActions>
                    <BeginStoryboard x:Name="MenuDropIn" Storyboard="{StaticResource MotionDropIn}"/>
                </MultiTrigger.EnterActions>
            </MultiTrigger>
            <Trigger Property="views:Motion.IsEnabled" Value="False">
                <Trigger.EnterActions>
                    <RemoveStoryboard BeginStoryboardName="MenuDropIn"/>
                </Trigger.EnterActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PopupMenuItemStyle" TargetType="MenuItem">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="ItemBorder"
                            Background="Transparent"
                            CornerRadius="{StaticResource RadiusItem}"
                            Padding="14,8">
                        <ContentPresenter ContentSource="Header"
                                          RecognizesAccessKey="True"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background"
                                    Value="{StaticResource SurfaceHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ItemBorder" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ToolTips are popups too: dark, Inter -->
    <Style TargetType="ToolTip">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{StaticResource SurfaceRaisedBrush}"
                            BorderBrush="{StaticResource BorderStrongBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusItem}"
                            Padding="10,6">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
