<!-- The Browse page: header (title, shown count, search, refresh), the filter row (game chips,
     Hide full / Hide empty chips, sort) and the virtualized server list with its loading,
     failure and no-match states. DataContext is inherited (MainViewModel); the browser state
     lives in MainViewModel.Browser, which is never rebuilt, so everything survives page
     switches. Page-only styles live here; shared ones come from the theme. -->
<UserControl x:Class="FiveMServerLauncher.Views.ServerBrowser"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:FiveMServerLauncher.Views"
             xmlns:views="clr-namespace:FiveMServerLauncher.Views"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <views:ThemeResources/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Row geometry: fixed height so the virtualizing panel never re-measures a
                 recycled row for its size. -->
            <sys:Double x:Key="BrowserRowHeight">60</sys:Double>

            <!-- White at 4 % over the raised card lands on SurfaceHoverBrush (#333333), a pair
                 the theme's contrast table already pins for every text colour used here. -->
            <sys:Double x:Key="BrowserRowHoverOpacity">0.04</sys:Double>

            <!-- Frozen copy of the theme hover tint (the theme brush is not frozen): every
                 realized row shares it with no change tracking. -->
            <SolidColorBrush x:Key="BrowserRowHoverBrush" Color="#FFFFFF" po:Freeze="True"/>

            <!-- Game chip: a ListBoxItem drawn like the theme's FilterChipStyle, so the chip
                 row is one ListBox (arrow keys move the selection, Tab enters it once). -->
            <Style x:Key="GameChipItemStyle" TargetType="{x:Type ListBoxItem}">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="14,0"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource PillFocusVisual}"/>
                <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <views:RoundedBorder x:Name="Chip"
                                    Background="{StaticResource SurfaceRaisedBrush}"
                                    BorderBrush="{StaticResource BorderStrongBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusPill}"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </views:RoundedBorder>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chip" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Chip" Property="Background" Value="{StaticResource TextPrimaryBrush}"/>
                                    <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource TextPrimaryBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource OnSelectedBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Row buttons: Connect is the row's light pill, Save its outlined one. A saved
                 server shows a quiet "Saved" that is neither clickable nor a tab stop (it is a
                 state, not an action). -->
            <Style x:Key="RowConnectButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource PillButtonBaseStyle}">
                <Setter Property="Background" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource OnSelectedBrush}"/>
                <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Padding" Value="16,0"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="MinWidth" Value="84"/>
            </Style>

            <Style x:Key="RowSaveButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource PillButtonBaseStyle}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Padding" Value="16,0"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="MinWidth" Value="84"/>
                <Setter Property="Margin" Value="8,0,0,0"/>
                <Setter Property="Command" Value="{Binding DataContext.SaveBrowserServerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                <Setter Property="CommandParameter" Value="{Binding}"/>
                <Setter Property="AutomationProperties.Name" Value="{loc:Loc BrowserSaveButton}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSaved}" Value="True">
                        <Setter Property="AutomationProperties.Name" Value="{loc:Loc SavedBrowserButton}"/>
                        <Setter Property="Command" Value="{x:Null}"/>
                        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                        <Setter Property="IsHitTestVisible" Value="False"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Cursor" Value="Arrow"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- A browser row: a raised rounded card whose hover layer eases in (150 ms) with
                 motion on and snaps with motion off; selection and keyboard focus draw the
                 border. Kept shallow: card, hover layer, content. -->
            <Style x:Key="BrowserRowStyle" TargetType="{x:Type ListBoxItem}">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Grid SnapsToDevicePixels="True">
                                <Border x:Name="Card"
                                        Background="{StaticResource SurfaceRaisedBrush}"
                                        BorderBrush="Transparent"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusCard}"/>
                                <Border x:Name="HoverLayer"
                                        Background="{StaticResource BrowserRowHoverBrush}"
                                        CornerRadius="{StaticResource RadiusCard}"
                                        Opacity="0"
                                        IsHitTestVisible="False"/>
                                <ContentPresenter Margin="{TemplateBinding Padding}"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                        <Condition Property="views:Motion.IsEnabled" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <MultiTrigger.EnterActions>
                                        <BeginStoryboard x:Name="RowHoverIn">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="{StaticResource BrowserRowHoverOpacity}"
                                                                 Duration="{StaticResource MotionFast}"
                                                                 EasingFunction="{StaticResource MotionEase}"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </MultiTrigger.EnterActions>
                                    <MultiTrigger.ExitActions>
                                        <BeginStoryboard x:Name="RowHoverOut">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0"
                                                                 Duration="{StaticResource MotionFast}"
                                                                 EasingFunction="{StaticResource MotionEase}"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </MultiTrigger.ExitActions>
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                        <Condition Property="views:Motion.IsEnabled" Value="False"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="HoverLayer" Property="Opacity" Value="{StaticResource BrowserRowHoverOpacity}"/>
                                </MultiTrigger>
                                <Trigger Property="views:Motion.IsEnabled" Value="False">
                                    <Trigger.EnterActions>
                                        <RemoveStoryboard BeginStoryboardName="RowHoverIn"/>
                                        <RemoveStoryboard BeginStoryboardName="RowHoverOut"/>
                                    </Trigger.EnterActions>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource TextSecondaryBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <!-- Server mark at row size: the icon, else the initials at a fixed 13 px on the
                 name colour. A local template (no Viewbox, so one measure less per row; the
                 theme mark scales its text to the box, which reads too large at 40 px). -->
            <Style x:Key="BrowserMarkStyle" TargetType="ContentControl" BasedOn="{StaticResource ServerMarkStyle}">
                <Setter Property="Width" Value="40"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContentControl">
                            <Grid>
                                <Border x:Name="Initials"
                                        Background="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ServerMarkBrush}}"
                                        CornerRadius="10"
                                        Visibility="Collapsed">
                                    <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ServerMarkInitials}}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="{StaticResource FontSizeBody}"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <Image x:Name="Icon"
                                       Source="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BytesToImageSourceConverter}}"
                                       Stretch="Uniform"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Content" Value="{x:Null}">
                                    <Setter TargetName="Initials" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Save / Saved share one cell, the hidden one keeping its width, so the button is
                 as wide in every row and the Connect column never shifts. -->
            <Style x:Key="SaveLabelStyle" TargetType="TextBlock">
                <Setter Property="Text" Value="{loc:Loc BrowserSaveButton}"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSaved}" Value="True">
                        <Setter Property="Visibility" Value="Hidden"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SavedLabelStyle" TargetType="TextBlock">
                <Setter Property="Text" Value="{loc:Loc SavedBrowserButton}"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="Visibility" Value="Hidden"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSaved}" Value="True">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- The three list states: an icon, a title and a hint, centred on the list area. -->
            <Style x:Key="BrowserStateStyle" TargetType="StackPanel">
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="MaxWidth" Value="420"/>
            </Style>

            <Style x:Key="BrowserStateTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource EmptyStateTextStyle}">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="FontSize" Value="{StaticResource FontSizeRowTitle}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,14,0,0"/>
            </Style>

            <Style x:Key="BrowserStateHintStyle" TargetType="TextBlock" BasedOn="{StaticResource EmptyStateTextStyle}">
                <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
                <Setter Property="Margin" Value="0,6,0,0"/>
            </Style>

            <Style x:Key="BrowserStateIconStyle" TargetType="Path">
                <Setter Property="Width" Value="36"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="Stretch" Value="Uniform"/>
                <Setter Property="StrokeThickness" Value="2"/>
                <Setter Property="StrokeStartLineCap" Value="Round"/>
                <Setter Property="StrokeEndLineCap" Value="Round"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>

            <!-- The loading ring turns only while it is shown and motion is on; with motion off
                 it stands still (the text still says what is happening). -->
            <Style x:Key="BrowserSpinnerStyle" TargetType="Path" BasedOn="{StaticResource BrowserStateIconStyle}">
                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <RotateTransform/>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsVisible" Value="True"/>
                            <Condition Property="views:Motion.IsEnabled" Value="True"/>
                        </MultiTrigger.Conditions>
                        <MultiTrigger.EnterActions>
                            <BeginStoryboard x:Name="Spin">
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                     From="0"
                                                     To="360"
                                                     Duration="0:0:1"
                                                     RepeatBehavior="Forever"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </MultiTrigger.EnterActions>
                        <MultiTrigger.ExitActions>
                            <RemoveStoryboard BeginStoryboardName="Spin"/>
                        </MultiTrigger.ExitActions>
                    </MultiTrigger>
                </Style.Triggers>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="28,24,28,18">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER: title, shown count, search, refresh -->
        <Grid x:Name="BrowseHeader" Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{loc:Loc NavBrowse}"
                       Style="{StaticResource PageTitleStyle}"
                       VerticalAlignment="Center"/>

            <TextBlock x:Name="ShownCountText"
                       Grid.Column="1"
                       Text="{Binding Browser.ShownCountText}"
                       Visibility="{Binding Browser.ShowsCount, Converter={StaticResource BoolToVisibility}}"
                       Foreground="{StaticResource TextTertiaryBrush}"
                       FontSize="{StaticResource FontSizeBody}"
                       VerticalAlignment="Center"
                       Margin="12,2,12,0"/>

            <Grid Grid.Column="2" Width="260" Height="40">

                <TextBox x:Name="BrowserSearchBox"
                         Text="{Binding Browser.SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource TextInputStyle}"
                         Padding="34,0,12,0"
                         AutomationProperties.Name="{loc:Loc SearchByNamePlaceholder}"/>

                <Path Data="M11,4 A7,7 0 1 1 10.99,4 M20,20 L16.5,16.5"
                      Stroke="{StaticResource TextTertiaryBrush}"
                      StrokeThickness="2"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Width="15"
                      Height="15"
                      Stretch="Uniform"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      Margin="14,0,0,0"
                      IsHitTestVisible="False"/>

                <TextBlock Text="{loc:Loc SearchByNamePlaceholder}"
                           Style="{StaticResource PlaceholderTextStyle}"
                           FontSize="{StaticResource FontSizeBody}"
                           Margin="37,0,12,0"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{Binding Text,
                                                ElementName=BrowserSearchBox,
                                                Converter={StaticResource EmptyStringToVisibility}}"/>

            </Grid>

            <Button Grid.Column="3"
                    Command="{Binding Browser.RefreshCommand}"
                    ToolTip="{loc:Loc RefreshTooltip}"
                    AutomationProperties.Name="{loc:Loc RefreshTooltip}"
                    Width="40"
                    Height="40"
                    Padding="0"
                    Margin="10,0,0,0"
                    Style="{StaticResource SecondaryButtonStyle}">

                <Path Data="M20,12 A8,8 0 1 1 17.7,6.4 M20,4 L20,9 L15,9"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="2"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      Width="16"
                      Height="16"
                      Stretch="Uniform"/>

            </Button>

        </Grid>

        <!-- FILTER ROW: game chips | Hide full, Hide empty | sort (docked right). The chips
             wrap onto a second line rather than clip in a long language. -->
        <DockPanel x:Name="BrowseFilters" Grid.Row="1" Margin="0,14,0,0" LastChildFill="True">

            <ComboBox x:Name="SortBox"
                      DockPanel.Dock="Right"
                      ItemsSource="{Binding Browser.SortOptions}"
                      SelectedItem="{Binding Browser.SelectedSortOption}"
                      DisplayMemberPath="Label"
                      AutomationProperties.Name="{loc:Loc BrowserSortLabel}"
                      MinWidth="150"
                      Height="34"
                      VerticalAlignment="Top"
                      VerticalContentAlignment="Center"
                      Margin="12,0,0,0"/>

            <WrapPanel Orientation="Horizontal">

                <ListBox x:Name="GameChips"
                         ItemsSource="{Binding Browser.GameFilterOptions}"
                         SelectedItem="{Binding Browser.SelectedGameFilterOption}"
                         DisplayMemberPath="Label"
                         ItemContainerStyle="{StaticResource GameChipItemStyle}"
                         AutomationProperties.Name="{loc:Loc BrowserGameFilterLabel}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         Margin="0,0,0,8"
                         KeyboardNavigation.DirectionalNavigation="Cycle"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">

                    <ListBox.Template>
                        <ControlTemplate TargetType="{x:Type ListBox}">
                            <ItemsPresenter/>
                        </ControlTemplate>
                    </ListBox.Template>

                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                </ListBox>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">

                    <Rectangle Width="1"
                               Height="22"
                               Fill="{StaticResource BorderStrongBrush}"
                               Margin="4,0,12,0"
                               VerticalAlignment="Center"/>

                    <ToggleButton x:Name="HideFullChip"
                                  Content="{loc:Loc HideFullCheckbox}"
                                  IsChecked="{Binding Browser.HideFull}"
                                  Style="{StaticResource FilterChipStyle}"
                                  Height="34"
                                  Padding="14,0"
                                  Margin="0,0,8,0"/>

                    <ToggleButton x:Name="HideEmptyChip"
                                  Content="{loc:Loc HideEmptyCheckbox}"
                                  IsChecked="{Binding Browser.HideEmpty}"
                                  Style="{StaticResource FilterChipStyle}"
                                  Height="34"
                                  Padding="14,0"/>

                </StackPanel>

            </WrapPanel>

        </DockPanel>

        <!-- LIST + STATES -->
        <Grid Grid.Row="2" Margin="0,6,0,0">

            <ListBox x:Name="BrowserList"
                     ItemsSource="{Binding Browser.ServersView}"
                     ItemContainerStyle="{StaticResource BrowserRowStyle}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0"
                     HorizontalContentAlignment="Stretch"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemTemplate>
                    <DataTemplate>

                        <Grid Height="{StaticResource BrowserRowHeight}">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="118"/>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ContentControl Grid.Column="0"
                                            Style="{StaticResource BrowserMarkStyle}"
                                            Content="{Binding Icon}"
                                            Tag="{Binding Name}"/>

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Margin="14,0,14,0">

                                <TextBlock Text="{Binding Name}"
                                           Style="{StaticResource RowTitleStyle}"
                                           TextTrimming="CharacterEllipsis"/>

                                <TextBlock Text="{Binding Address}"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,3,0,0"/>

                            </StackPanel>

                            <Border Grid.Column="2"
                                    Style="{StaticResource GameTagStyle}"
                                    HorizontalAlignment="Left"
                                    Background="{Binding Game, Converter={StaticResource GameClientToBrushConverter}}"
                                    Visibility="{Binding HasGame, Converter={StaticResource BoolToVisibility}}">

                                <TextBlock Text="{Binding GameTagLabel}"
                                           Style="{StaticResource GameTagTextStyle}"/>

                            </Border>

                            <TextBlock Grid.Column="3"
                                       Text="{Binding PlayersText}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="{StaticResource FontSizeBody}"
                                       FontWeight="SemiBold"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="4"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="16,0,0,0">

                                <Button Content="{loc:Loc ConnectBrowserButton}"
                                        Style="{StaticResource RowConnectButtonStyle}"
                                        Command="{Binding DataContext.ConnectBrowserServerCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>

                                <Button Style="{StaticResource RowSaveButtonStyle}">
                                    <Grid>
                                        <TextBlock Style="{StaticResource SaveLabelStyle}"/>
                                        <TextBlock Style="{StaticResource SavedLabelStyle}"/>
                                    </Grid>
                                </Button>

                            </StackPanel>

                        </Grid>

                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>

            <!-- LOADING: a turning ring -->
            <StackPanel x:Name="LoadingState"
                        Style="{StaticResource BrowserStateStyle}"
                        Visibility="{Binding Browser.IsLoadingOverlay, Converter={StaticResource BoolToVisibility}}">

                <Path Style="{StaticResource BrowserSpinnerStyle}"
                      Data="M12,3 A9,9 0 1 1 3,12"
                      Stroke="{StaticResource TextSecondaryBrush}"/>

                <TextBlock Text="{loc:Loc BrowserLoading}" Style="{StaticResource BrowserStateTitleStyle}"/>

                <TextBlock Text="{loc:Loc BrowserLoadingHint}" Style="{StaticResource BrowserStateHintStyle}"/>

            </StackPanel>

            <!-- FAILED: a danger mark, the reason and a retry -->
            <StackPanel x:Name="FailedState"
                        Style="{StaticResource BrowserStateStyle}"
                        Visibility="{Binding Browser.ShowsLoadFailure, Converter={StaticResource BoolToVisibility}}">

                <Path Style="{StaticResource BrowserStateIconStyle}"
                      Data="M12,3 A9,9 0 1 1 11.99,3 M12,7.5 L12,13 M12,16.5 L12,16.6"
                      Stroke="{StaticResource DangerTextBrush}"/>

                <TextBlock Text="{loc:Loc BrowserLoadFailedTitle}"
                           Style="{StaticResource BrowserStateTitleStyle}"
                           Foreground="{StaticResource DangerTextBrush}"/>

                <TextBlock Text="{loc:Loc BrowserLoadFailedHint}" Style="{StaticResource BrowserStateHintStyle}"/>

                <Button Content="{loc:Loc RetryButton}"
                        Command="{Binding Browser.RefreshCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        HorizontalAlignment="Center"
                        Margin="0,16,0,0"/>

            </StackPanel>

            <!-- NO MATCH: a magnifier, the reason and the clear action -->
            <StackPanel x:Name="NoMatchState"
                        Style="{StaticResource BrowserStateStyle}"
                        Visibility="{Binding Browser.IsNoMatch, Converter={StaticResource BoolToVisibility}}">

                <Path Style="{StaticResource BrowserStateIconStyle}"
                      Data="M11,4 A7,7 0 1 1 10.99,4 M20,20 L16.5,16.5"
                      Stroke="{StaticResource TextSecondaryBrush}"/>

                <TextBlock Text="{loc:Loc BrowserNoMatch}" Style="{StaticResource BrowserStateTitleStyle}"/>

                <TextBlock Text="{loc:Loc BrowserNoMatchHint}" Style="{StaticResource BrowserStateHintStyle}"/>

                <Button Content="{loc:Loc ClearFiltersButton}"
                        Command="{Binding Browser.ClearFiltersCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        HorizontalAlignment="Center"
                        Margin="0,16,0,0"/>

            </StackPanel>

        </Grid>

    </Grid>

</UserControl>
