<!-- Full-view server browser overlay. DataContext is inherited (MainViewModel). -->
<UserControl x:Class="FiveMServerLauncher.Views.ServerBrowser"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:FiveMServerLauncher.Views"
             xmlns:views="clr-namespace:FiveMServerLauncher.Views">

    <UserControl.Resources>
        <views:ThemeResources/>
    </UserControl.Resources>

    <Border x:Name="BrowserOverlay"
            Background="{StaticResource BackgroundBrush}"
            Visibility="Collapsed">

        <Border.RenderTransform>
            <TranslateTransform/>
        </Border.RenderTransform>

        <Grid Margin="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,10">

                <Button Content="{loc:Loc BackButton}"
                        MinHeight="30"
                        Padding="12,4"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding CloseServerBrowserCommand}"/>

                <Button DockPanel.Dock="Right"
                        Command="{Binding Browser.RefreshCommand}"
                        ToolTip="{loc:Loc RefreshTooltip}"
                        Padding="6,2"
                        VerticalAlignment="Center"
                        Style="{StaticResource IconButtonStyle}">

                    <TextBlock Text="↻" FontSize="14"/>

                </Button>

                <TextBlock Text="{loc:Loc BrowseServersHeader}"
                           Style="{StaticResource SectionHeaderStyle}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"/>

            </DockPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">

                <ComboBox ItemsSource="{Binding Browser.GameFilterOptions}"
                          SelectedItem="{Binding Browser.SelectedGameFilterOption}"
                          DisplayMemberPath="Label"
                          MinWidth="110"
                          MinHeight="26"
                          VerticalContentAlignment="Center"/>

                <CheckBox IsChecked="{Binding Browser.HideFull}"
                          Content="{loc:Loc HideFullCheckbox}"
                          Foreground="{StaticResource SecondaryTextBrush}"
                          FontSize="11"
                          VerticalAlignment="Center"
                          Margin="12,0,0,0"/>

                <CheckBox IsChecked="{Binding Browser.HideEmpty}"
                          Content="{loc:Loc HideEmptyCheckbox}"
                          Foreground="{StaticResource SecondaryTextBrush}"
                          FontSize="11"
                          VerticalAlignment="Center"
                          Margin="12,0,0,0"/>

                <Grid Margin="12,0,0,0" VerticalAlignment="Center" Width="220">

                    <TextBox x:Name="BrowserSearchBox"
                             Text="{Binding Browser.SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Background="{StaticResource PanelLightBrush}"
                             Foreground="{StaticResource TextBrush}"
                             BorderBrush="{StaticResource BorderBrush}"
                             BorderThickness="1"
                             Padding="8,4"
                             FontSize="11"
                             VerticalContentAlignment="Center"
                             MinHeight="26"/>

                    <TextBlock Text="{loc:Loc SearchByNamePlaceholder}"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="11"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"
                               Margin="9,0,0,0"
                               Visibility="{Binding Text,
                                                    ElementName=BrowserSearchBox,
                                                    Converter={StaticResource EmptyStringToVisibility}}"/>

                </Grid>

                <ComboBox ItemsSource="{Binding Browser.SortOptions}"
                          SelectedItem="{Binding Browser.SelectedSortOption}"
                          DisplayMemberPath="Label"
                          MinWidth="130"
                          MinHeight="26"
                          Margin="12,0,0,0"
                          VerticalContentAlignment="Center"/>

            </StackPanel>

            <Border Grid.Row="2"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Background="{StaticResource PanelLightBrush}">

                <Grid>

                    <ListBox ItemsSource="{Binding Browser.ServersView}"
                             Background="{StaticResource PanelLightBrush}"
                             BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                        <ListBox.ItemsPanel>

                            <ItemsPanelTemplate>

                                <VirtualizingStackPanel/>

                            </ItemsPanelTemplate>

                        </ListBox.ItemsPanel>

                        <ListBox.ItemTemplate>

                            <DataTemplate>

                                <Border Height="36" Padding="8,0">

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Image Grid.Column="0"
                                               Source="{Binding Icon, Converter={StaticResource BytesToImageSourceConverter}, IsAsync=False}"
                                               Width="22"
                                               Height="22"
                                               Margin="0,0,10,0"
                                               VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   Foreground="{StaticResource TextBrush}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Game}"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   FontSize="10"
                                                   VerticalAlignment="Center"
                                                   Margin="10,0,0,0"/>

                                        <TextBlock Grid.Column="3"
                                                   VerticalAlignment="Center"
                                                   Margin="10,0,0,0"
                                                   Foreground="{StaticResource SecondaryTextBrush}">

                                            <TextBlock.Text>

                                                <MultiBinding StringFormat="{}{0}/{1}">

                                                    <Binding Path="Players"/>
                                                    <Binding Path="MaxPlayers"/>

                                                </MultiBinding>

                                            </TextBlock.Text>

                                        </TextBlock>

                                        <StackPanel Grid.Column="5"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    Margin="12,0,0,0">

                                            <Button MinHeight="24"
                                                    Padding="8,2"
                                                    Command="{Binding DataContext.SaveBrowserServerCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">

                                                <Button.Style>

                                                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButtonStyle}">

                                                        <Setter Property="Content" Value="{loc:Loc SaveButton}"/>

                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSaved}" Value="True">
                                                                <Setter Property="Content" Value="{loc:Loc SavedBrowserButton}"/>
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>

                                                    </Style>

                                                </Button.Style>

                                            </Button>

                                            <Button Content="{loc:Loc ConnectBrowserButton}"
                                                    MinHeight="24"
                                                    Padding="10,2"
                                                    Style="{StaticResource MainButtonStyle}"
                                                    Margin="6,0,0,0"
                                                    Command="{Binding DataContext.ConnectBrowserServerCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>

                                        </StackPanel>

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </ListBox.ItemTemplate>

                    </ListBox>

                    <TextBlock Text="{loc:Loc BrowserLoading}"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding Browser.IsLoadingOverlay,
                                                    Converter={StaticResource BoolToVisibility}}"/>

                    <TextBlock Text="{loc:Loc BrowserLoadFailed}"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding Browser.LoadFailed, Converter={StaticResource BoolToVisibility}}"/>

                </Grid>

            </Border>

        </Grid>

    </Border>

</UserControl>
