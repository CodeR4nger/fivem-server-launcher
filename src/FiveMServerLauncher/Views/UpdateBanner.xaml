<!-- Bottom update strip (available / in progress / failed). DataContext is inherited (MainViewModel). -->
<UserControl x:Class="FiveMServerLauncher.Views.UpdateBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:FiveMServerLauncher.Views"
             xmlns:views="clr-namespace:FiveMServerLauncher.Views">

    <UserControl.Resources>
        <views:ThemeResources/>
    </UserControl.Resources>

    <Border Background="{StaticResource PanelLightBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1,1,1,0"
            Padding="16,8">

        <Border.Visibility>
            <MultiBinding Converter="{StaticResource AnyTrueToVisibility}"
                          Mode="OneWay">
                <Binding Path="IsUpdateAvailable"/>
                <Binding Path="IsUpdateInProgress"/>
                <Binding Path="IsUpdateFailed"/>
            </MultiBinding>
        </Border.Visibility>

        <DockPanel LastChildFill="True">

            <!-- Dismiss: available or failed only — the VM refuses it mid-flight -->

            <Button DockPanel.Dock="Right"
                    Content="✕"
                    FontSize="14"
                    MinHeight="34"
                    MinWidth="40"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding DismissUpdateCommand}">
                <Button.Visibility>
                    <MultiBinding Converter="{StaticResource AnyTrueToVisibility}"
                                  Mode="OneWay">
                        <Binding Path="IsUpdateAvailable"/>
                        <Binding Path="IsUpdateFailed"/>
                    </MultiBinding>
                </Button.Visibility>
            </Button>

            <!-- UPDATE: the primary call to action, accent by convention -->

            <Button DockPanel.Dock="Right"
                    Content="{loc:Loc UpdateButton}"
                    MinHeight="34"
                    Padding="14,0"
                    Margin="0,0,8,0"
                    Style="{StaticResource MainButtonStyle}"
                    Command="{Binding UpdateCommand}"
                    Visibility="{Binding IsUpdateAvailable,
                                         Converter={StaticResource BoolToVisibility},
                                         FallbackValue=Collapsed}"/>

            <!-- Message: one of three mutually exclusive texts -->

            <Grid VerticalAlignment="Center">

                <TextBlock Text="{Binding UpdateBannerText}"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Visibility="{Binding IsUpdateAvailable,
                                                Converter={StaticResource BoolToVisibility},
                                                FallbackValue=Collapsed}"/>

                <TextBlock Text="{loc:Loc UpdateInProgressText}"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Visibility="{Binding IsUpdateInProgress,
                                                Converter={StaticResource BoolToVisibility},
                                                FallbackValue=Collapsed}"/>

                <TextBlock Text="{loc:Loc UpdateFailedText}"
                           Foreground="{StaticResource RedBrush}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Visibility="{Binding IsUpdateFailed,
                                                Converter={StaticResource BoolToVisibility},
                                                FallbackValue=Collapsed}"/>

            </Grid>

        </DockPanel>

    </Border>

</UserControl>
