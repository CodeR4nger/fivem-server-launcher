<UserControl x:Class="FiveMServerLauncher.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:viewModels="clr-namespace:FiveMServerLauncher.ViewModels"
             xmlns:views="clr-namespace:FiveMServerLauncher.Views">

    <UserControl.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>

        <!-- COLORES -->

        <SolidColorBrush x:Key="BackgroundBrush" Color="#101010"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#181818"/>
        <SolidColorBrush x:Key="PanelLightBrush" Color="#202020"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#F5A623"/>
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#D88E18"/>
        <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#999999"/>

        <!-- Borde -->
        <SolidColorBrush x:Key="BorderBrush" Color="#080808"/>
        <SolidColorBrush x:Key="GreenBrush" Color="#55C271"/>
        <SolidColorBrush x:Key="RedBrush" Color="#E05252"/>

        <!-- TEMPLATE DE BOTÓN COMPARTIDO -->
        <ControlTemplate x:Key="ButtonTemplate" TargetType="{x:Type Button}">

            <Border x:Name="ButtonBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}">

                <ContentPresenter
                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}"
                    ContentStringFormat="{TemplateBinding ContentStringFormat}"/>

            </Border>

            <ControlTemplate.Triggers>

                <!-- HOVER -->

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter TargetName="ButtonBorder"
                            Property="Background"
                            Value="{StaticResource AccentBrush}"/>

                    <Setter TargetName="ButtonBorder"
                            Property="BorderBrush"
                            Value="{StaticResource AccentDarkBrush}"/>

                    <Setter Property="Foreground"
                            Value="{StaticResource BackgroundBrush}"/>

                </Trigger>


                <!-- PRESSED -->

                <Trigger Property="IsPressed"
                         Value="True">

                    <Setter TargetName="ButtonBorder"
                            Property="Background"
                            Value="{StaticResource AccentDarkBrush}"/>

                    <Setter TargetName="ButtonBorder"
                            Property="BorderBrush"
                            Value="{StaticResource AccentDarkBrush}"/>

                    <Setter Property="Foreground"
                            Value="{StaticResource BackgroundBrush}"/>

                </Trigger>


                <!-- DISABLED -->

                <Trigger Property="IsEnabled"
                         Value="False">

                    <Setter TargetName="ButtonBorder"
                            Property="Opacity"
                            Value="0.45"/>

                    <Setter Property="Cursor"
                            Value="Arrow"/>

                </Trigger>

            </ControlTemplate.Triggers>

        </ControlTemplate>

        <!-- BASE DE BOTÓN -->

        <Style x:Key="BaseButtonStyle" TargetType="{x:Type Button}">

            <Setter Property="Background"
                    Value="{StaticResource PanelLightBrush}"/>

            <Setter Property="Foreground"
                    Value="{StaticResource TextBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Template"
                    Value="{StaticResource ButtonTemplate}"/>

        </Style>

        <!-- BOTÓN PRINCIPAL -->
        <Style x:Key="MainButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource BaseButtonStyle}">

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="Padding"
                    Value="20,12"/>

        </Style>

        <!-- BOTÓN SECUNDARIO -->

        <Style x:Key="SecondaryButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource MainButtonStyle}">

            <Setter Property="Background"
                    Value="{StaticResource PanelBrush}"/>

        </Style>

        <!-- BOTÓN DROPDOWN -->

        <Style x:Key="DropdownButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource BaseButtonStyle}">

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

            <Setter Property="Padding"
                    Value="18,13"/>

        </Style>

        <!-- BOTÓN DE FLECHA -->

        <Style x:Key="ArrowButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource BaseButtonStyle}">

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

        </Style>

    </UserControl.Resources>

    <!-- ROOT -->

    <Grid Background="{StaticResource BackgroundBrush}">

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="*"/>

            <ColumnDefinition Width="20"/>

            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>

        <!-- FIVEM -->

        <Border Grid.Column="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                Margin="25">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>

                <!-- SETTINGS BAR -->

                <DockPanel Grid.Row="0" Margin="14,14,14,0">

                    <Button Content="⚙ SETTINGS"
                            Height="32"
                            Padding="12,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding SettingsCommand}"/>

                    <Button Content="DEV MODE"
                            Height="32"
                            Padding="12,0"
                            Margin="8,0,0,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ToggleDevModeCommand}"/>

                </DockPanel>

                <!-- SETTINGS PANEL -->

                <Border Grid.Row="1"
                        Margin="14,10,14,0"
                        Padding="14"
                        Background="{StaticResource PanelLightBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        Visibility="{Binding IsSettingsOpen,
                                             Converter={StaticResource BoolToVisibility}}">

                    <StackPanel VerticalAlignment="Top">

                        <TextBlock Text="PREFERRED OPEN CLIENT"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>

                        <ComboBox ItemsSource="{Binding AvailableOpenClients}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedItem="{Binding PreferredClientOption}"
                                  Height="30"
                                  Margin="0,6,0,10"
                                  VerticalContentAlignment="Center"/>

                        <CheckBox IsChecked="{Binding AutoLaunch}"
                                  Content="Auto-launch last server on startup"
                                  Foreground="{StaticResource TextBrush}"
                                  FontSize="12"/>

                    </StackPanel>

                </Border>


                <!-- STATUS FIVEM -->

                <StackPanel Grid.Row="2"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="30"
                            Visibility="{Binding IsDevMode,
                                                 Converter={StaticResource InverseBoolToVisibility},
                                                 FallbackValue=Visible}">

                    <TextBlock Text="FIVEM / CFX"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,7"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">

                        <Ellipse Width="8"
                                 Height="8"
                                 Fill="{StaticResource GreenBrush}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0"/>

                        <TextBlock Text="ONLINE"
                                   Foreground="{StaticResource GreenBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>

                    </StackPanel>

                </StackPanel>


                <!-- SPLIT BUTTON -->

                <Grid Grid.Row="3"
                      Margin="20,0,20,20"
                      Visibility="{Binding IsDevMode,
                                           Converter={StaticResource InverseBoolToVisibility},
                                           FallbackValue=Visible}">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="50"/>

                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>


                    <Grid Grid.Row="0">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="50"/>

                        </Grid.ColumnDefinitions>


                        <Button x:Name="FiveMButton"
                                Grid.Column="0"
                                Content="{Binding SelectedOpenClientLabel}"
                                Command="{Binding OpenClientCommand}"
                                Style="{StaticResource MainButtonStyle}"/>


                        <Button x:Name="DropdownButton"
                                Grid.Column="1"
                                Style="{StaticResource ArrowButtonStyle}"
                                Click="DropdownButton_Click">

                            <TextBlock x:Name="ArrowText"
                                       Text="▼"
                                       FontSize="10"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Button>

                    </Grid>


                    <!-- DROPDOWN -->

                    <Border x:Name="FiveMDropdown"
                            Grid.Row="1"
                            Background="{StaticResource PanelLightBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1,0,1,1"
                            Visibility="Collapsed">

                        <StackPanel>

                            <ItemsControl ItemsSource="{Binding AvailableOpenClients}">

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate>

                                        <Button Content="{Binding DisplayName}"
                                                Height="42"
                                                Style="{StaticResource DropdownButtonStyle}"
                                                Command="{Binding DataContext.SelectOpenClientCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Click="ClientOption_Click"/>

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </StackPanel>

                    </Border>

                </Grid>

                <!-- DEV MODE -->

                <StackPanel Grid.Row="2"
                            VerticalAlignment="Center"
                            Margin="20"
                            Visibility="{Binding IsDevMode,
                                                 Converter={StaticResource BoolToVisibility},
                                                 FallbackValue=Collapsed}">

                    <TextBlock Text="DEV MODE"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,7"/>

                    <TextBlock Text="GAME BUILD"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="10"
                               Margin="0,6,0,3"/>

                    <TextBox Text="{Binding DevGameBuild, UpdateSourceTrigger=PropertyChanged}"
                             Background="{StaticResource PanelLightBrush}"
                             Foreground="{StaticResource TextBrush}"
                             BorderBrush="{StaticResource BorderBrush}"
                             BorderThickness="1"
                             Padding="10,6"
                             FontSize="12"/>

                    <TextBlock Text="PURE MODE"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="10"
                               Margin="0,10,0,3"/>

                    <ComboBox SelectedValue="{Binding DevPureMode}"
                              SelectedValuePath="Tag"
                              Height="28"
                              VerticalContentAlignment="Center">

                        <ComboBoxItem Content="None"/>
                        <ComboBoxItem Content="0">
                            <ComboBoxItem.Tag><sys:Int32>0</sys:Int32></ComboBoxItem.Tag>
                        </ComboBoxItem>
                        <ComboBoxItem Content="1">
                            <ComboBoxItem.Tag><sys:Int32>1</sys:Int32></ComboBoxItem.Tag>
                        </ComboBoxItem>
                        <ComboBoxItem Content="2">
                            <ComboBoxItem.Tag><sys:Int32>2</sys:Int32></ComboBoxItem.Tag>
                        </ComboBoxItem>

                    </ComboBox>

                </StackPanel>

                <!-- DEV LAUNCH -->

                <StackPanel Grid.Row="3"
                            Margin="20,0,20,20"
                            Visibility="{Binding IsDevMode,
                                                 Converter={StaticResource BoolToVisibility},
                                                 FallbackValue=Collapsed}">

                    <Button Content="LAUNCH"
                            Height="50"
                            Style="{StaticResource MainButtonStyle}"
                            Command="{Binding DevLaunchCommand}"
                            CommandParameter="{x:Null}"/>

                    <Button Content="LAUNCH WITH SECOND CLIENT (-cl2)"
                            Height="40"
                            Margin="0,8,0,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding DevLaunchCommand}"
                            CommandParameter="{x:Static viewModels:DevLaunchParams.SecondClient}"/>

                </StackPanel>

            </Grid>

        </Border>

<!-- SERVIDOR -->

        <Border Grid.Column="2"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                Margin="25">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="*"/>

                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <!-- FORMULARIO -->

                <StackPanel Grid.Row="0"
                            VerticalAlignment="Center"
                            Margin="20">

                    <TextBlock Text="SAVED SERVERS"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Margin="0,0,0,7"/>

                    <Border BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            Background="{StaticResource PanelLightBrush}">

                        <ListBox x:Name="SavedServersList"
                                 ItemsSource="{Binding SavedServers}"
                                 SelectedItem="{Binding SelectedServer}"
                                 Background="{StaticResource PanelLightBrush}"
                                 BorderThickness="0"
                                 MaxHeight="140"
                                 MaxWidth="340">

                            <ListBox.ItemTemplate>

                                <DataTemplate>

                                    <StackPanel Margin="8">

                                        <DockPanel>

                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="{StaticResource TextBrush}"
                                                       FontWeight="SemiBold"/>

                                            <TextBlock Text="{Binding Address}"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       HorizontalAlignment="Right"
                                                       FontSize="10"
                                                       TextTrimming="CharacterEllipsis"/>

                                        </DockPanel>

                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,4,0,0">

                                            <CheckBox Content="Requires Steam"
                                                      IsChecked="{Binding RequiresSteam}"
                                                      Foreground="{StaticResource SecondaryTextBrush}"
                                                      FontSize="11"/>

                                            <CheckBox Content="Requires Discord"
                                                      IsChecked="{Binding RequiresDiscord}"
                                                      Foreground="{StaticResource SecondaryTextBrush}"
                                                      FontSize="11"
                                                      Margin="16,0,0,0"/>

                                        </StackPanel>

                                    </StackPanel>

                                </DataTemplate>

                            </ListBox.ItemTemplate>

                        </ListBox>

                    </Border>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,8,0,0">

                        <TextBox Text="{Binding NewServerName,
                                              UpdateSourceTrigger=PropertyChanged}"
                                 Background="{StaticResource PanelLightBrush}"
                                 Foreground="{StaticResource TextBrush}"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 BorderThickness="1"
                                 Padding="10,8"
                                 FontSize="11"
                                 Width="120"
                                 VerticalContentAlignment="Center"/>

                        <TextBox Text="{Binding NewServerAddress,
                                              UpdateSourceTrigger=PropertyChanged}"
                                 Background="{StaticResource PanelLightBrush}"
                                 Foreground="{StaticResource TextBrush}"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 BorderThickness="1"
                                 Padding="10,8"
                                 FontSize="11"
                                 Margin="8,0,0,0"
                                 Width="160"
                                 VerticalContentAlignment="Center"/>

                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,8,0,0">

                        <Button Content="SAVE"
                                Height="30"
                                Padding="14,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding AddServerCommand}"/>

                        <Button Content="DELETE"
                                Height="30"
                                Padding="14,0"
                                Margin="8,0,0,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding DeleteServerCommand}"/>

                    </StackPanel>

                    <TextBlock Text="CONNECT ADDRESS"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Margin="0,16,0,7"/>

                    <TextBox x:Name="ServerAddressBox"
                             Text="{Binding ServerAddress,
                                            UpdateSourceTrigger=PropertyChanged}"
                             Background="{StaticResource PanelLightBrush}"
                             Foreground="{StaticResource TextBrush}"
                             BorderBrush="{StaticResource BorderBrush}"
                             BorderThickness="1"
                             Padding="18,14"
                             FontSize="13"
                             VerticalContentAlignment="Center"
                             Height="50"/>

                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="11"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"/>

                </StackPanel>


                <!-- BOTON ENTRAR -->

                <Button Grid.Row="1"
                        Content="ENTER SERVER"
                        Height="50"
                        Margin="20,0,20,20"
                        Style="{StaticResource MainButtonStyle}"
                        Command="{Binding ConnectCommand}"/>

            </Grid>

        </Border>

    </Grid>

</UserControl>
