<UserControl x:Class="FiveMServerLauncher.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>

        <!-- COLORES -->

        <SolidColorBrush x:Key="BackgroundBrush" Color="#101010"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#181818"/>
        <SolidColorBrush x:Key="PanelLightBrush" Color="#202020"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#F5A623"/>
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#D88E18"/>
        <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#999999"/>

        <!-- Borde -->
        <SolidColorBrush x:Key="BorderBrush" Color="#080808"/>
        <SolidColorBrush x:Key="GreenBrush" Color="#55C271"/>
        <SolidColorBrush x:Key="RedBrush" Color="#E05252"/>

        <!-- TEMPLATE DE BOTÓN COMPARTIDO -->
        <ControlTemplate x:Key="ButtonTemplate" TargetType="{x:Type Button}">

            <Border x:Name="ButtonBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}">

                <ContentPresenter
                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}"
                    ContentStringFormat="{TemplateBinding ContentStringFormat}"/>

            </Border>

            <ControlTemplate.Triggers>

                <!-- HOVER -->

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter TargetName="ButtonBorder"
                            Property="Background"
                            Value="{StaticResource AccentBrush}"/>

                    <Setter TargetName="ButtonBorder"
                            Property="BorderBrush"
                            Value="{StaticResource AccentDarkBrush}"/>

                    <Setter Property="Foreground"
                            Value="{StaticResource BackgroundBrush}"/>

                </Trigger>


                <!-- PRESSED -->

                <Trigger Property="IsPressed"
                         Value="True">

                    <Setter TargetName="ButtonBorder"
                            Property="Background"
                            Value="{StaticResource AccentDarkBrush}"/>

                    <Setter TargetName="ButtonBorder"
                            Property="BorderBrush"
                            Value="{StaticResource AccentDarkBrush}"/>

                    <Setter Property="Foreground"
                            Value="{StaticResource BackgroundBrush}"/>

                </Trigger>


                <!-- DISABLED -->

                <Trigger Property="IsEnabled"
                         Value="False">

                    <Setter TargetName="ButtonBorder"
                            Property="Opacity"
                            Value="0.45"/>

                    <Setter Property="Cursor"
                            Value="Arrow"/>

                </Trigger>

            </ControlTemplate.Triggers>

        </ControlTemplate>

        <!-- BASE DE BOTÓN -->

        <Style x:Key="BaseButtonStyle" TargetType="{x:Type Button}">

            <Setter Property="Background"
                    Value="{StaticResource PanelLightBrush}"/>

            <Setter Property="Foreground"
                    Value="{StaticResource TextBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Template"
                    Value="{StaticResource ButtonTemplate}"/>

        </Style>

        <!-- BOTÓN PRINCIPAL -->
        <Style x:Key="MainButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource BaseButtonStyle}">

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="Padding"
                    Value="20,12"/>

        </Style>

        <!-- BOTÓN SECUNDARIO -->

        <Style x:Key="SecondaryButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource MainButtonStyle}">

            <Setter Property="Background"
                    Value="{StaticResource PanelBrush}"/>

        </Style>

        <!-- BOTÓN DROPDOWN -->

        <Style x:Key="DropdownButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource BaseButtonStyle}">

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

            <Setter Property="Padding"
                    Value="18,13"/>

        </Style>

        <!-- BOTÓN DE FLECHA -->

        <Style x:Key="ArrowButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource BaseButtonStyle}">

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

        </Style>

    </UserControl.Resources>

    <!-- ROOT -->

    <Grid Background="{StaticResource BackgroundBrush}">

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="*"/>

            <ColumnDefinition Width="20"/>

            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>

        <!-- FIVEM -->

        <Border Grid.Column="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                Margin="25">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="*"/>

                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <!-- STATUS FIVEM -->

                <StackPanel Grid.Row="0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="30">

                    <TextBlock Text="FIVEM / CFX"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,7"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">

                        <Ellipse Width="8"
                                 Height="8"
                                 Fill="{StaticResource GreenBrush}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0"/>

                        <TextBlock Text="ONLINE"
                                   Foreground="{StaticResource GreenBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>

                    </StackPanel>

                </StackPanel>


                <!-- SPLIT BUTTON -->

                <Grid Grid.Row="1"
                      Margin="20,0,20,20">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="50"/>

                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>


                    <Grid Grid.Row="0">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="50"/>

                        </Grid.ColumnDefinitions>


                        <Button x:Name="FiveMButton"
                                Grid.Column="0"
                                Content="FiveM"
                                Style="{StaticResource MainButtonStyle}"/>


                        <Button x:Name="DropdownButton"
                                Grid.Column="1"
                                Style="{StaticResource ArrowButtonStyle}"
                                Click="DropdownButton_Click">

                            <TextBlock x:Name="ArrowText"
                                       Text="▼"
                                       FontSize="10"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Button>

                    </Grid>


                    <!-- DROPDOWN -->

                    <Border x:Name="FiveMDropdown"
                            Grid.Row="1"
                            Background="{StaticResource PanelLightBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1,0,1,1"
                            Visibility="Collapsed">

                        <StackPanel>

                            <Button Content="FiveM"
                                    Height="42"
                                    Style="{StaticResource DropdownButtonStyle}"
                                    CommandParameter="FiveM"
                                    Click="ClientOption_Click"/>

                            <Border Height="1"
                                    Background="#080808"/>

                            <Button Content="FiveM Enhanced"
                                    Height="42"
                                    Style="{StaticResource DropdownButtonStyle}"
                                    CommandParameter="FiveM Enhanced"
                                    Click="ClientOption_Click"/>

                        </StackPanel>

                    </Border>

                </Grid>

            </Grid>

        </Border>

<!-- SERVIDOR -->

        <Border Grid.Column="2"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                Margin="25">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="*"/>

                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <!-- FORMULARIO -->

                <StackPanel Grid.Row="0"
                            VerticalAlignment="Center"
                            Margin="20">

                    <TextBox x:Name="ServerAddressBox"
                             Text="{Binding ServerAddress,
                                            UpdateSourceTrigger=PropertyChanged}"
                             Background="{StaticResource PanelLightBrush}"
                             Foreground="{StaticResource TextBrush}"
                             BorderBrush="{StaticResource BorderBrush}"
                             BorderThickness="1"
                             Padding="18,14"
                             FontSize="13"
                             VerticalContentAlignment="Center"
                             Height="50"/>

                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="11"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"/>

                </StackPanel>


                <!-- BOTON ENTRAR -->

                <Button Grid.Row="1"
                        Content="ENTER SERVER"
                        Height="50"
                        Margin="20,0,20,20"
                        Style="{StaticResource MainButtonStyle}"
                        Command="{Binding ConnectCommand}"/>

            </Grid>

        </Border>

    </Grid>

</UserControl>
