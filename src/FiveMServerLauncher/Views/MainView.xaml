<UserControl x:Class="FiveMServerLauncher.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:viewModels="clr-namespace:FiveMServerLauncher.ViewModels"
             xmlns:loc="clr-namespace:FiveMServerLauncher.Views"
             xmlns:views="clr-namespace:FiveMServerLauncher.Views">

    <UserControl.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <views:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibility"/>
        <views:BytesToImageSourceConverter x:Key="BytesToImageSourceConverter"/>
        <views:GameClientToBrushConverter x:Key="GameClientToBrushConverter"/>
        <views:CfxStatusToBrushConverter x:Key="CfxStatusToBrushConverter"/>

        <views:SelectionEqualityToVisibilityConverter x:Key="SelectionEqualityToVisibility"/>
        <views:DropdownOpenStateConverter x:Key="DropdownOpenStateConverter"/>

        <!-- COLORES -->

        <SolidColorBrush x:Key="BackgroundBrush" Color="#101010"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#181818"/>
        <SolidColorBrush x:Key="PanelLightBrush" Color="#202020"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#F5A623"/>
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#D88E18"/>
        <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#999999"/>

        <!-- Borde -->
        <SolidColorBrush x:Key="BorderBrush" Color="#080808"/>
        <SolidColorBrush x:Key="GreenBrush" Color="#55C271"/>
        <SolidColorBrush x:Key="RedBrush" Color="#E05252"/>

        <!-- TEMPLATE DE BOTÓN COMPARTIDO -->
        <ControlTemplate x:Key="ButtonTemplate" TargetType="{x:Type Button}">

            <Border x:Name="ButtonBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}">

                <ContentPresenter
                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}"
                    ContentStringFormat="{TemplateBinding ContentStringFormat}"/>

            </Border>

            <ControlTemplate.Triggers>

                <!-- HOVER -->

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter TargetName="ButtonBorder"
                            Property="Background"
                            Value="{StaticResource AccentBrush}"/>

                    <Setter TargetName="ButtonBorder"
                            Property="BorderBrush"
                            Value="{StaticResource AccentDarkBrush}"/>

                    <Setter Property="Foreground"
                            Value="{StaticResource BackgroundBrush}"/>

                </Trigger>


                <!-- PRESSED -->

                <Trigger Property="IsPressed"
                         Value="True">

                    <Setter TargetName="ButtonBorder"
                            Property="Background"
                            Value="{StaticResource AccentDarkBrush}"/>

                    <Setter TargetName="ButtonBorder"
                            Property="BorderBrush"
                            Value="{StaticResource AccentDarkBrush}"/>

                    <Setter Property="Foreground"
                            Value="{StaticResource BackgroundBrush}"/>

                </Trigger>


                <!-- DISABLED -->

                <Trigger Property="IsEnabled"
                         Value="False">

                    <Setter TargetName="ButtonBorder"
                            Property="Opacity"
                            Value="0.45"/>

                    <Setter Property="Cursor"
                            Value="Arrow"/>

                </Trigger>

            </ControlTemplate.Triggers>

        </ControlTemplate>

        <!-- BASE DE BOTÓN -->

        <Style x:Key="BaseButtonStyle" TargetType="{x:Type Button}">

            <Setter Property="Background"
                    Value="{StaticResource PanelLightBrush}"/>

            <Setter Property="Foreground"
                    Value="{StaticResource TextBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Template"
                    Value="{StaticResource ButtonTemplate}"/>

        </Style>

        <!-- BOTÓN PRINCIPAL -->
        <Style x:Key="MainButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource BaseButtonStyle}">

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Foreground"
                    Value="{StaticResource AccentBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource AccentBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1,1,1,2"/>

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="Padding"
                    Value="20,12"/>

        </Style>

        <!-- BOTÓN SECUNDARIO (outline, quiet) -->

        <Style x:Key="SecondaryButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource BaseButtonStyle}">

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Foreground"
                    Value="{StaticResource SecondaryTextBrush}"/>

            <Setter Property="BorderBrush"
                    Value="#3A3A3A"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="Padding"
                    Value="16,10"/>

        </Style>

        <!-- SECTION HEADER (shared label style) -->
        <Style x:Key="SectionHeaderStyle"
               TargetType="TextBlock">

            <Setter Property="Foreground"
                    Value="{StaticResource SecondaryTextBrush}"/>

            <Setter Property="FontSize"
                    Value="11"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

        </Style>

        <!-- THIN DARK SCROLLBAR (view-scoped) -->

        <Style TargetType="{x:Type ScrollBar}">

            <Setter Property="Width" Value="6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type ScrollBar}">

                        <Grid UseLayoutRounding="True">

                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True"
                                   IsEnabled="True">

                                <Track.Thumb>

                                    <Thumb>

                                        <Thumb.Template>

                                            <ControlTemplate TargetType="{x:Type Thumb}">

                                                <Rectangle Fill="#3A3A3A"
                                                           RadiusX="3"
                                                           RadiusY="3"/>

                                            </ControlTemplate>

                                        </Thumb.Template>

                                    </Thumb>

                                </Track.Thumb>

                                <Track.DecreaseRepeatButton>

                                    <RepeatButton Command="{x:Static ScrollBar.LineUpCommand}"
                                                  Focusable="False"
                                                  IsTabStop="False"
                                                  Background="Transparent"
                                                  BorderThickness="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>

                                </Track.DecreaseRepeatButton>

                                <Track.IncreaseRepeatButton>

                                    <RepeatButton Command="{x:Static ScrollBar.LineDownCommand}"
                                                  Focusable="False"
                                                  IsTabStop="False"
                                                  Background="Transparent"
                                                  BorderThickness="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>

                                </Track.IncreaseRepeatButton>

                            </Track>

                        </Grid>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- BOTÓN DROPDOWN -->

        <Style x:Key="DropdownButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource BaseButtonStyle}">

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

            <Setter Property="Padding"
                    Value="18,13"/>

        </Style>

        <!-- BOTÓN DE FLECHA -->

        <Style x:Key="ArrowButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource BaseButtonStyle}">

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

        </Style>

        <!-- BOTÓN DE ÍCONO (refresh, pencil, move arrows) -->

        <Style x:Key="IconButtonStyle"
               TargetType="{x:Type Button}">

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border Background="Transparent"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsEnabled" Value="False">

                                <Setter Property="Opacity" Value="0.35"/>

                                <Setter Property="Cursor" Value="Arrow"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Resources>

                <Style TargetType="{x:Type TextBlock}" BasedOn="{x:Null}">

                    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>

                    <Style.Triggers>

                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}"
                                     Value="True">

                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>

                        </DataTrigger>

                    </Style.Triggers>

                </Style>

            </Style.Resources>

        </Style>

        <!-- COMBOBOX TOGGLE (closed box + chevron) -->

        <ControlTemplate x:Key="ComboBoxToggleTemplate" TargetType="{x:Type ToggleButton}">

            <Border x:Name="ToggleBorder"
                    Background="{StaticResource PanelLightBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    SnapsToDevicePixels="True">

                <TextBlock Text="▼"
                           FontSize="9"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Margin="0,1,9,0"/>

            </Border>

            <ControlTemplate.Triggers>

                <Trigger Property="IsMouseOver" Value="True">

                    <Setter TargetName="ToggleBorder"
                            Property="BorderBrush"
                            Value="#3A3A3A"/>

                </Trigger>

                <DataTrigger Binding="{Binding IsKeyboardFocusWithin,
                                               RelativeSource={RelativeSource AncestorType=ComboBox}}"
                             Value="True">

                    <Setter TargetName="ToggleBorder"
                            Property="BorderBrush"
                            Value="{StaticResource AccentBrush}"/>

                </DataTrigger>

            </ControlTemplate.Triggers>

        </ControlTemplate>

        <!-- COMBOBOX ITEM (popup rows) -->

        <Style TargetType="{x:Type ComboBoxItem}">

            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">

                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">

                            <ContentPresenter VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsSelected" Value="True">

                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#2A2A2A"/>

                                <Setter Property="Foreground"
                                        Value="{StaticResource AccentBrush}"/>

                            </Trigger>

                            <Trigger Property="IsHighlighted" Value="True">

                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{StaticResource AccentBrush}"/>

                                <Setter Property="Foreground"
                                        Value="{StaticResource BackgroundBrush}"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- COMBOBOX (dark, non-editable) -->

        <Style TargetType="{x:Type ComboBox}">

            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type ComboBox}">

                        <Grid>

                            <ToggleButton Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen,
                                                              Mode=TwoWay,
                                                              RelativeSource={RelativeSource TemplatedParent}}"
                                          Template="{StaticResource ComboBoxToggleTemplate}"/>

                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              Margin="10,0,26,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

                            <!-- Collapsed marker holding the popup open for the
                                 ~200 ms of close animation: its Opacity is snapped
                                 to 1 on open and released by a discrete keyframe
                                 when the collapse completes, so the closing motion
                                 renders inside a still-alive popup. -->
                            <TextBlock x:Name="CloseHold"
                                       Opacity="0"
                                       Visibility="Collapsed"/>

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Placement="Bottom">

                                <Popup.IsOpen>
                                    <MultiBinding Converter="{StaticResource DropdownOpenStateConverter}"
                                                  Mode="OneWay">
                                        <Binding Path="IsDropDownOpen"
                                                 RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="Opacity"
                                                 ElementName="CloseHold"/>
                                    </MultiBinding>
                                </Popup.IsOpen>

                                <Border x:Name="DropDownBorder"
                                        Background="{StaticResource PanelLightBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        Opacity="0"
                                        SnapsToDevicePixels="True">

                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleY="0"/>
                                    </Border.RenderTransform>

                                    <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}">

                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>

                                    </ScrollViewer>

                                </Border>

                            </Popup>

                        </Grid>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsEnabled" Value="False">

                                <Setter Property="Opacity" Value="0.45"/>

                            </Trigger>

                            <Trigger Property="IsDropDownOpen" Value="True">

                                <Trigger.EnterActions>

                                    <BeginStoryboard>

                                        <Storyboard>

                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CloseHold"
                                                                           Storyboard.TargetProperty="Opacity">

                                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/>

                                            </DoubleAnimationUsingKeyFrames>

                                            <DoubleAnimation Storyboard.TargetName="DropDownBorder"
                                                             Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                             To="1"
                                                             Duration="0:0:0.2">

                                                <DoubleAnimation.EasingFunction>

                                                    <CubicEase EasingMode="EaseOut"/>

                                                </DoubleAnimation.EasingFunction>

                                            </DoubleAnimation>

                                            <DoubleAnimation Storyboard.TargetName="DropDownBorder"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0:0:0.2"/>

                                        </Storyboard>

                                    </BeginStoryboard>

                                </Trigger.EnterActions>

                                <Trigger.ExitActions>

                                    <BeginStoryboard>

                                        <Storyboard>

                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CloseHold"
                                                                           Storyboard.TargetProperty="Opacity">

                                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/>

                                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.2" Value="0"/>

                                            </DoubleAnimationUsingKeyFrames>

                                            <DoubleAnimation Storyboard.TargetName="DropDownBorder"
                                                             Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                             To="0"
                                                             Duration="0:0:0.2">

                                                <DoubleAnimation.EasingFunction>

                                                    <CubicEase EasingMode="EaseOut"/>

                                                </DoubleAnimation.EasingFunction>

                                            </DoubleAnimation>

                                            <DoubleAnimation Storyboard.TargetName="DropDownBorder"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.2"/>

                                        </Storyboard>

                                    </BeginStoryboard>

                                </Trigger.ExitActions>

                            </Trigger>

                            <Trigger Property="IsDropDownOpen" Value="False">

                                <Setter TargetName="DropDownBorder"
                                        Property="IsHitTestVisible"
                                        Value="False"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- CHECKBOX (dark box, amber check) -->

        <Style TargetType="{x:Type CheckBox}">

            <Setter Property="SnapsToDevicePixels" Value="True"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type CheckBox}">

                        <StackPanel Orientation="Horizontal"
                                    Background="Transparent">

                            <Border x:Name="CheckBoxBox"
                                    Width="16"
                                    Height="16"
                                    Background="{StaticResource PanelLightBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="2"
                                    VerticalAlignment="Center"
                                    SnapsToDevicePixels="True">

                                <Path x:Name="CheckMark"
                                      Data="M 3,8 L 6.5,11.5 L 11,3.5"
                                      Stroke="{StaticResource AccentBrush}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Visibility="Collapsed"/>

                            </Border>

                            <ContentPresenter Margin="8,0,0,0"
                                              VerticalAlignment="Center"/>

                        </StackPanel>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="CheckBoxBox"
                                        Property="BorderBrush"
                                        Value="#3A3A3A"/>

                            </Trigger>

                            <Trigger Property="IsChecked" Value="True">

                                <Setter TargetName="CheckMark"
                                        Property="Visibility"
                                        Value="Visible"/>

                            </Trigger>

                            <Trigger Property="IsKeyboardFocusWithin" Value="True">

                                <Setter TargetName="CheckBoxBox"
                                        Property="BorderBrush"
                                        Value="#3A3A3A"/>

                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">

                                <Setter Property="Opacity" Value="0.45"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </UserControl.Resources>

    <!-- ROOT -->

    <Grid Background="{StaticResource BackgroundBrush}">

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="*"/>

            <ColumnDefinition Width="20"/>

            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>

        <!-- FIVEM -->

        <Border Grid.Column="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                Margin="20,24,10,24">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>

                <!-- SETTINGS BAR -->

                <DockPanel Grid.Row="0" Margin="14,14,14,0">

                    <Button Content="{loc:Loc SettingsButton}"
                            MinHeight="34"
                            Padding="14,8"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding SettingsCommand}"/>

                    <Button Content="{loc:Loc DevModeButton}"
                            MinHeight="34"
                            Padding="14,8"
                            Margin="8,0,0,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ToggleDevModeCommand}"/>

                </DockPanel>

                <!-- SETTINGS PANEL -->

                <Border Grid.Row="1"
                        VerticalAlignment="Top"
                        Margin="14,10,14,0"
                        Padding="14"
                        Background="{StaticResource PanelLightBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        Visibility="{Binding IsSettingsOpen,
                                             Converter={StaticResource BoolToVisibility}}">

                    <StackPanel VerticalAlignment="Top">

                        <TextBlock Text="{loc:Loc PreferredOpenClientHeader}"
                                   Style="{StaticResource SectionHeaderStyle}"/>

                         <ComboBox ItemsSource="{Binding AvailableOpenClients}"
                                   DisplayMemberPath="DisplayName"
                                   SelectedItem="{Binding PreferredClientOption}"
                                   Height="30"
                                   Margin="0,6,0,6"
                                   VerticalContentAlignment="Center"/>

                        <TextBlock Text="{loc:Loc LanguageHeader}"
                                   Style="{StaticResource SectionHeaderStyle}"/>

                        <ComboBox ItemsSource="{Binding LanguageOptions}"
                                  DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedLanguageOption}"
                                  Height="30"
                                  Margin="0,6,0,6"
                                  VerticalContentAlignment="Center"/>

                        <CheckBox IsChecked="{Binding AutoLaunch}"
                                  Content="{loc:Loc AutoLaunchCheckbox}"
                                  Foreground="{StaticResource TextBrush}"
                                  FontSize="12"/>

                    </StackPanel>

                </Border>


                <!-- STATUS FIVEM -->

                <StackPanel Grid.Row="2"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="30,12"
                            Visibility="{Binding IsDevMode,
                                                 Converter={StaticResource InverseBoolToVisibility},
                                                 FallbackValue=Visible}">

                    <TextBlock Text="{loc:Loc CfxStatusHeader}"
                               Style="{StaticResource SectionHeaderStyle}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>

                    <ItemsControl ItemsSource="{Binding CfxStatuses}" Width="250">

                        <ItemsControl.ItemTemplate>

                            <DataTemplate>

                                <DockPanel Margin="0,3" LastChildFill="False">

                                    <Ellipse DockPanel.Dock="Left"
                                             Width="8"
                                             Height="8"
                                             Fill="{Binding Status,
                                                           Converter={StaticResource CfxStatusToBrushConverter}}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,8,0"/>

                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding StatusLabel}"
                                               Foreground="{StaticResource TextBrush}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>

                                    <TextBlock DockPanel.Dock="Left"
                                               Text="{Binding DisplayName}"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="12"
                                               VerticalAlignment="Center"/>

                                </DockPanel>

                            </DataTemplate>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </StackPanel>


                <!-- SPLIT BUTTON -->

                <Grid Grid.Row="3"
                      Margin="20,0,20,16"
                      Visibility="{Binding IsDevMode,
                                           Converter={StaticResource InverseBoolToVisibility},
                                           FallbackValue=Visible}">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="48"/>

                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>


                    <Grid Grid.Row="0">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="50"/>

                        </Grid.ColumnDefinitions>


                        <Button x:Name="FiveMButton"
                                Grid.Column="0"
                                Content="{Binding SelectedOpenClientLabel}"
                                Command="{Binding OpenClientCommand}"
                                Style="{StaticResource MainButtonStyle}"/>


                        <Button x:Name="DropdownButton"
                                Grid.Column="1"
                                Style="{StaticResource ArrowButtonStyle}"
                                Click="DropdownButton_Click">

                            <TextBlock x:Name="ArrowText"
                                       Text="▼"
                                       FontSize="10"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Button>

                    </Grid>


                    <!-- DROPDOWN -->

                    <Border x:Name="FiveMDropdown"
                            Grid.Row="1"
                            Background="{StaticResource PanelLightBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1,0,1,1"
                            ClipToBounds="True"
                            Visibility="Collapsed">

                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsVisible" Value="True">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="0"
                                                                     To="1"
                                                                     Duration="0:0:0.2"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <StackPanel>

                            <ItemsControl ItemsSource="{Binding AvailableOpenClients}">

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate>

                                        <Button Content="{Binding DisplayName}"
                                                Height="42"
                                                Style="{StaticResource DropdownButtonStyle}"
                                                Command="{Binding DataContext.SelectOpenClientCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Click="ClientOption_Click"/>

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </StackPanel>

                    </Border>

                </Grid>

                <!-- DEV MODE -->

                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsDevMode,
                                                  Converter={StaticResource BoolToVisibility},
                                                  FallbackValue=Collapsed}">

                    <StackPanel
                            VerticalAlignment="Top"
                            Margin="20,8,20,0">

                    <TextBlock Text="{loc:Loc DevModeButton}"
                               Style="{StaticResource SectionHeaderStyle}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>

                    <Button Content="{Binding DevClientButtonText}"
                            Padding="14,6"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ToggleDevClientCommand}"
                            Margin="0,0,0,10"/>

                    <TextBlock Text="{loc:Loc GameBuildHeader}"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="10"
                               Margin="0,6,0,3"/>

                    <TextBox Text="{Binding DevGameBuild, UpdateSourceTrigger=PropertyChanged}"
                             Background="{StaticResource PanelLightBrush}"
                             Foreground="{StaticResource TextBrush}"
                             BorderBrush="{StaticResource BorderBrush}"
                             BorderThickness="1"
                             Padding="10,8"
                             FontSize="12"/>

                    <TextBlock Text="{loc:Loc PureModeHeader}"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="10"
                               Margin="0,10,0,3"/>

                    <ComboBox SelectedValue="{Binding DevPureMode}"
                              SelectedValuePath="Tag"
                              MinHeight="28"
                              VerticalContentAlignment="Center">

                        <ComboBoxItem Content="{loc:Loc PureModeNone}"/>
                        <ComboBoxItem Content="0">
                            <ComboBoxItem.Tag><sys:Int32>0</sys:Int32></ComboBoxItem.Tag>
                        </ComboBoxItem>
                        <ComboBoxItem Content="1">
                            <ComboBoxItem.Tag><sys:Int32>1</sys:Int32></ComboBoxItem.Tag>
                        </ComboBoxItem>
                        <ComboBoxItem Content="2">
                            <ComboBoxItem.Tag><sys:Int32>2</sys:Int32></ComboBoxItem.Tag>
                        </ComboBoxItem>

                    </ComboBox>

                    </StackPanel>

                </ScrollViewer>

                <!-- DEV LAUNCH -->

                <StackPanel Grid.Row="3"
                            Margin="20,14,20,20"
                            Visibility="{Binding IsDevMode,
                                                 Converter={StaticResource BoolToVisibility},
                                                 FallbackValue=Collapsed}">

                    <Button Content="{loc:Loc LaunchButton}"
                            MinHeight="50"
                            Style="{StaticResource MainButtonStyle}"
                            Command="{Binding DevLaunchCommand}"
                            CommandParameter="{x:Null}"/>

                    <Button Content="{loc:Loc LaunchSecondClientButton}"
                            MinHeight="50"
                            Margin="0,8,0,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding DevLaunchCommand}"
                            CommandParameter="{x:Static viewModels:DevLaunchParams.SecondClient}"/>

                </StackPanel>

            </Grid>

        </Border>

<!-- SERVIDOR -->

        <Border Grid.Column="2"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                Margin="10,24,20,24">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="*"/>

                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <!-- FORMULARIO -->

                <ScrollViewer Grid.Row="0"
                              VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollBarVisibility="Disabled">

                    <!-- Left margin lives on the siblings, not this StackPanel: the one
                         full-width child below is the list's grid, whose first 20 px column
                         is the arrows gutter (a negative-margin overlay child got clipped
                         by the ScrollViewer — that area is not renderable overflow here). -->
                    <StackPanel Margin="0,20,20,20">

                    <DockPanel Margin="20,0,0,7">

                        <TextBlock Text="{loc:Loc SavedServersHeader}"
                                   Style="{StaticResource SectionHeaderStyle}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>

                        <Button DockPanel.Dock="Right"
                                Command="{Binding RefreshServersCommand}"
                                ToolTip="{loc:Loc RefreshTooltip}"
                                Padding="4,0"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource IconButtonStyle}">

                            <TextBlock Text="↻"/>

                        </Button>

                        <Grid VerticalAlignment="Center">

                            <TextBox x:Name="ServerSearchBox"
                                     Text="{Binding ServerSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="{StaticResource PanelLightBrush}"
                                     Foreground="{StaticResource TextBrush}"
                                     BorderBrush="{StaticResource BorderBrush}"
                                     BorderThickness="1"
                                     Padding="8,2"
                                     FontSize="11"
                                     VerticalContentAlignment="Center"
                                     MinHeight="24"/>

                            <TextBlock Text="{loc:Loc SearchServersPlaceholder}"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="11"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       Margin="9,0,0,0"
                                       Visibility="{Binding Text,
                                                            ElementName=ServerSearchBox,
                                                            Converter={StaticResource EmptyStringToVisibility}}"/>

                        </Grid>

                    </DockPanel>

                    <!-- One cell holding the full-size list and two overlays. The list box
                         keeps its original width: the move arrows live in the grid's first
                         20 px column — the space that was the list's left margin; the drop
                         indicator overlays the list itself. -->
                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="1"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                Background="{StaticResource PanelLightBrush}">

                        <ListBox x:Name="SavedServersList"
                                 ItemsSource="{Binding SavedServersView}"
                                 SelectedItem="{Binding SelectedServer}"
                                 Background="{StaticResource PanelLightBrush}"
                                 BorderThickness="0"
                                 HorizontalContentAlignment="Stretch"
                                 Padding="0,4,0,4"
                                 Height="163"
                                 PreviewMouseLeftButtonDown="SavedServersList_PreviewMouseLeftButtonDown"
                                 MouseMove="SavedServersList_MouseMove"
                                 PreviewMouseLeftButtonUp="SavedServersList_PreviewMouseLeftButtonUp"
                                 ScrollViewer.ScrollChanged="SavedServersList_ScrollChanged"
                                 SelectionChanged="SavedServersList_SelectionChanged">

                            <ListBox.ItemContainerStyle>

                                <Style TargetType="{x:Type ListBoxItem}">

                                    <Setter Property="HorizontalContentAlignment"
                                            Value="Stretch"/>

                                    <EventSetter Event="ListBoxItem.MouseEnter"
                                                 Handler="SavedServerRow_MouseEnter"/>

                                    <EventSetter Event="ListBoxItem.MouseLeave"
                                                 Handler="SavedServerRow_MouseLeave"/>

                                </Style>

                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>

                                <DataTemplate>

                                    <Grid Margin="6">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Image Grid.Column="0"
                                               Source="{Binding Icon, Converter={StaticResource BytesToImageSourceConverter}}"
                                               Width="22"
                                               Height="22"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding TrimmedName}"
                                                   Foreground="{StaticResource TextBrush}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Left"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <Border Grid.Column="2"
                                                Background="{Binding Game, Converter={StaticResource GameClientToBrushConverter}}"
                                                CornerRadius="3"
                                                Padding="5,1"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding HasGame, Converter={StaticResource BoolToVisibility}}">

                                            <TextBlock Text="{Binding GameTagLabel}"
                                                       Foreground="{StaticResource BackgroundBrush}"
                                                       FontSize="9"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding StatusLabel}"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0"/>

                                        <Button Grid.Column="4"
                                                Command="{Binding DataContext.OpenEditServerDialogCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Padding="6,2"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource IconButtonStyle}">

                                            <Button.Visibility>

                                                <MultiBinding Converter="{StaticResource SelectionEqualityToVisibility}">

                                                    <Binding Path="DataContext"
                                                             RelativeSource="{RelativeSource AncestorType=ListBoxItem}"/>

                                                    <Binding Path="SelectedItem"
                                                             RelativeSource="{RelativeSource AncestorType=ListBox}"/>

                                                </MultiBinding>

                                            </Button.Visibility>

                                            <TextBlock Text="✏"/>

                                        </Button>

                                    </Grid>

                                </DataTemplate>

                            </ListBox.ItemTemplate>

                        </ListBox>

                        </Border>

                        <!-- Drop indicator: an accent line snapped to the insertion slot,
                             following the pointer while a row is being dragged. Never hit
                             (the list keeps every click). -->
                        <Canvas Grid.Column="1"
                                x:Name="DropIndicatorCanvas"
                                IsHitTestVisible="False">

                            <Border x:Name="DropIndicator"
                                    Height="2"
                                    Width="{Binding ActualWidth, ElementName=DropIndicatorCanvas}"
                                    Background="{StaticResource AccentBrush}"
                                    CornerRadius="1"
                                    Visibility="Collapsed"/>

                        </Canvas>

                        <!-- Move arrows overlay: a trackable pair in the gutter column (the
                             20 px that used to be the list's left margin), positioned from
                             code-behind on hover, selection and scroll. Transparent background
                             so the strip itself is hit-testable — the arrows stay alive while
                             the pointer crosses from the row onto them. -->
                        <Canvas x:Name="MoveArrowsCanvas"
                                Margin="0,1,0,1"
                                Background="Transparent"
                                MouseEnter="MoveArrowsCanvas_MouseEnter"
                                MouseLeave="MoveArrowsCanvas_MouseLeave">

                            <StackPanel x:Name="MoveArrowsOverlay"
                                        Visibility="Collapsed">

                                <Button Command="{Binding DataContext.MoveServerUpCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        IsEnabled="{Binding CanMoveUp}"
                                        Width="20"
                                        Padding="0"
                                        Style="{StaticResource IconButtonStyle}">

                                    <TextBlock Text="▲" FontSize="9"/>

                                </Button>

                                <Button Command="{Binding DataContext.MoveServerDownCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        IsEnabled="{Binding CanMoveDown}"
                                        Width="20"
                                        Padding="0"
                                        Style="{StaticResource IconButtonStyle}">

                                    <TextBlock Text="▼" FontSize="9"/>

                                </Button>

                            </StackPanel>

                        </Canvas>

                    </Grid>

                    <DockPanel Margin="20,8,0,0">

                        <Button Content="{loc:Loc DeleteButton}"
                                MinHeight="26"
                                Padding="12,4"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding DeleteServerCommand}"/>

                        <Button Content="{loc:Loc BrowseButton}"
                                MinHeight="26"
                                Padding="12,4"
                                HorizontalAlignment="Right"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="8,0,0,0"
                                Command="{Binding OpenServerBrowserCommand}"/>

                        <Button Content="{loc:Loc NewServerButton}"
                                MinHeight="26"
                                Padding="12,4"
                                HorizontalAlignment="Right"
                                Style="{StaticResource MainButtonStyle}"
                                Command="{Binding OpenAddServerDialogCommand}"/>

                    </DockPanel>

                    <TextBlock Text="{loc:Loc ConnectAddressHeader}"
                               Style="{StaticResource SectionHeaderStyle}"
                               Margin="20,14,0,0"/>

                    <TextBox x:Name="ServerAddressBox"
                             Text="{Binding ServerAddress,
                                            UpdateSourceTrigger=PropertyChanged}"
                             Background="{StaticResource PanelLightBrush}"
                             Foreground="{StaticResource TextBrush}"
                             BorderBrush="{StaticResource BorderBrush}"
                             BorderThickness="1"
                             Padding="5,1"
                             FontSize="12"
                             VerticalContentAlignment="Center"
                             MinHeight="10"
                             Margin="20,5,0,0"/>

                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="11"
                               HorizontalAlignment="Center"
                               Margin="20,2,0,0"/>

                    </StackPanel>

                </ScrollViewer>

                <!-- BOTON ENTRAR -->

                <Button Grid.Row="1"
                        Content="{loc:Loc EnterServerButton}"
                        Height="48"
                        Margin="20,0,20,16"
                        Style="{StaticResource MainButtonStyle}"
                        Command="{Binding ConnectCommand}"/>

            </Grid>

        </Border>

        <!-- ADD/EDIT SERVER DIALOG (overlay) -->

        <Border Grid.Column="0"
                Grid.ColumnSpan="3"
                Background="#66000000"
                Padding="40,60"
                Visibility="{Binding IsServerDialogOpen,
                                     Converter={StaticResource BoolToVisibility},
                                     FallbackValue=Collapsed}">

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">

            <Border Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Padding="20"
                    MinWidth="320">

                <StackPanel>

                    <TextBlock Text="{Binding ServerDialogTitle}"
                               Style="{StaticResource SectionHeaderStyle}"
                               Margin="0,0,0,12"/>

                    <TextBlock Text="{loc:Loc NameField}"
                               Style="{StaticResource SectionHeaderStyle}"/>

                    <TextBox Text="{Binding DialogServerName, UpdateSourceTrigger=PropertyChanged}"
                             Background="{StaticResource PanelLightBrush}"
                             Foreground="{StaticResource TextBrush}"
                             BorderBrush="{StaticResource BorderBrush}"
                             BorderThickness="1"
                             Padding="12,8"
                             FontSize="12"
                             MinHeight="38"
                             Margin="0,5,0,0"/>

                    <TextBlock Text="{loc:Loc AddressField}"
                               Style="{StaticResource SectionHeaderStyle}"
                               Margin="0,10,0,0"/>

                    <TextBox Text="{Binding DialogServerAddress, UpdateSourceTrigger=PropertyChanged}"
                             Background="{StaticResource PanelLightBrush}"
                             Foreground="{StaticResource TextBrush}"
                             BorderBrush="{StaticResource BorderBrush}"
                             BorderThickness="1"
                             Padding="12,8"
                             FontSize="12"
                             MinHeight="38"
                             Margin="0,5,0,0"/>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">

                        <CheckBox IsChecked="{Binding DialogRequiresSteam}"
                                  Content="{loc:Loc RequiresSteamCheckbox}"
                                  Foreground="{StaticResource SecondaryTextBrush}"
                                  FontSize="11"/>

                        <CheckBox IsChecked="{Binding DialogRequiresDiscord}"
                                  Content="{loc:Loc RequiresDiscordCheckbox}"
                                  Foreground="{StaticResource SecondaryTextBrush}"
                                  FontSize="11"
                                  Margin="16,0,0,0"/>

                    </StackPanel>

                    <TextBlock Text="{Binding DialogError}"
                               Foreground="#E5533D"
                               FontSize="11"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>

                    <DockPanel Margin="0,14,0,0">

                        <Button Content="{loc:Loc CancelButton}"
                                MinHeight="32"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Left"
                                Command="{Binding CancelServerDialogCommand}"/>

                        <Button Content="{loc:Loc SaveButton}"
                                MinHeight="32"
                                Style="{StaticResource MainButtonStyle}"
                                HorizontalAlignment="Right"
                                MinWidth="90"
                                Command="{Binding SaveServerDialogCommand}"/>

                    </DockPanel>

                </StackPanel>

            </Border>

            <!-- LOCAL DEV SIDE PANEL (loopback addresses only, slides in from the right) -->

            <Border Margin="10,0,0,0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Padding="20"
                    MinWidth="220"
                    Visibility="{Binding IsDialogLocalhost,
                                         Converter={StaticResource BoolToVisibility}}">

                <Border.RenderTransform>
                    <TranslateTransform/>
                </Border.RenderTransform>

                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDialogLocalhost}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)"
                                                             From="60"
                                                             To="0"
                                                             Duration="0:0:0.25">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0"
                                                             To="1"
                                                             Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel VerticalAlignment="Top">

                    <TextBlock Text="{loc:Loc DialogLocalDevHeader}"
                               Style="{StaticResource SectionHeaderStyle}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12"/>

                    <TextBlock Text="{loc:Loc DialogCfxIdField}"
                               Style="{StaticResource SectionHeaderStyle}"/>

                    <TextBox Text="{Binding DialogCfxId, UpdateSourceTrigger=PropertyChanged}"
                             Background="{StaticResource PanelLightBrush}"
                             Foreground="{StaticResource TextBrush}"
                             BorderBrush="{StaticResource BorderBrush}"
                             BorderThickness="1"
                             Padding="12,8"
                             FontSize="12"
                             MinHeight="38"
                             Margin="0,5,0,0"/>

                    <TextBlock Text="{loc:Loc GameBuildHeader}"
                               Style="{StaticResource SectionHeaderStyle}"
                               Margin="0,10,0,0"/>

                    <TextBox Text="{Binding DialogGameBuildText, UpdateSourceTrigger=PropertyChanged}"
                             Background="{StaticResource PanelLightBrush}"
                             Foreground="{StaticResource TextBrush}"
                             BorderBrush="{StaticResource BorderBrush}"
                             BorderThickness="1"
                             Padding="12,8"
                             FontSize="12"
                             MinHeight="38"
                             Margin="0,5,0,0"/>

                    <TextBlock Text="{loc:Loc PureModeHeader}"
                               Style="{StaticResource SectionHeaderStyle}"
                               Margin="0,10,0,0"/>

                    <ComboBox SelectedValue="{Binding DialogPureMode}"
                              SelectedValuePath="Tag"
                              MinHeight="30"
                              VerticalContentAlignment="Center"
                              Margin="0,5,0,0">

                        <ComboBoxItem Content="{loc:Loc PureModeNone}"/>
                        <ComboBoxItem Content="0">
                            <ComboBoxItem.Tag><sys:Int32>0</sys:Int32></ComboBoxItem.Tag>
                        </ComboBoxItem>
                        <ComboBoxItem Content="1">
                            <ComboBoxItem.Tag><sys:Int32>1</sys:Int32></ComboBoxItem.Tag>
                        </ComboBoxItem>
                        <ComboBoxItem Content="2">
                            <ComboBoxItem.Tag><sys:Int32>2</sys:Int32></ComboBoxItem.Tag>
                        </ComboBoxItem>

                    </ComboBox>

                    <TextBlock Text="{loc:Loc DialogGameField}"
                               Style="{StaticResource SectionHeaderStyle}"
                               Margin="0,10,0,0"/>

                    <ComboBox ItemsSource="{Binding DialogGameClientOptions}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Game"
                              SelectedValue="{Binding DialogGameClient}"
                              MinHeight="30"
                              VerticalContentAlignment="Center"
                              Margin="0,5,0,0"/>

                </StackPanel>

            </Border>

            </StackPanel>

        </Border>

        <!-- SERVER BROWSER (full-view overlay) -->

        <Border Grid.Column="0"
                Grid.ColumnSpan="3"
                Background="{StaticResource BackgroundBrush}"
                Visibility="{Binding IsServerBrowserOpen,
                                     Converter={StaticResource BoolToVisibility},
                                     FallbackValue=Collapsed}">

            <Grid Margin="20">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,10">

                    <Button Content="{loc:Loc BackButton}"
                            MinHeight="30"
                            Padding="12,4"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding CloseServerBrowserCommand}"/>

                    <Button DockPanel.Dock="Right"
                            Command="{Binding Browser.RefreshCommand}"
                            ToolTip="{loc:Loc RefreshTooltip}"
                            Padding="6,2"
                            VerticalAlignment="Center"
                            Style="{StaticResource IconButtonStyle}">

                        <TextBlock Text="↻" FontSize="14"/>

                    </Button>

                    <TextBlock Text="{loc:Loc BrowseServersHeader}"
                               Style="{StaticResource SectionHeaderStyle}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"/>

                </DockPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">

                    <ComboBox ItemsSource="{Binding Browser.GameFilterOptions}"
                              SelectedItem="{Binding Browser.SelectedGameFilterOption}"
                              DisplayMemberPath="Label"
                              MinWidth="110"
                              MinHeight="26"
                              VerticalContentAlignment="Center"/>

                    <CheckBox IsChecked="{Binding Browser.HideFull}"
                              Content="{loc:Loc HideFullCheckbox}"
                              Foreground="{StaticResource SecondaryTextBrush}"
                              FontSize="11"
                              VerticalAlignment="Center"
                              Margin="12,0,0,0"/>

                    <CheckBox IsChecked="{Binding Browser.HideEmpty}"
                              Content="{loc:Loc HideEmptyCheckbox}"
                              Foreground="{StaticResource SecondaryTextBrush}"
                              FontSize="11"
                              VerticalAlignment="Center"
                              Margin="12,0,0,0"/>

                    <Grid Margin="12,0,0,0" VerticalAlignment="Center" Width="220">

                        <TextBox x:Name="BrowserSearchBox"
                                 Text="{Binding Browser.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{StaticResource PanelLightBrush}"
                                 Foreground="{StaticResource TextBrush}"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 BorderThickness="1"
                                 Padding="8,4"
                                 FontSize="11"
                                 VerticalContentAlignment="Center"
                                 MinHeight="26"/>

                        <TextBlock Text="{loc:Loc SearchByNamePlaceholder}"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="11"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center"
                                   Margin="9,0,0,0"
                                   Visibility="{Binding Text,
                                                        ElementName=BrowserSearchBox,
                                                        Converter={StaticResource EmptyStringToVisibility}}"/>

                    </Grid>

                </StackPanel>

                <Border Grid.Row="2"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        Background="{StaticResource PanelLightBrush}">

                    <Grid>

                        <ListBox ItemsSource="{Binding Browser.ServersView}"
                                 Background="{StaticResource PanelLightBrush}"
                                 BorderThickness="0"
                                 HorizontalContentAlignment="Stretch"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                            <ListBox.ItemsPanel>

                                <ItemsPanelTemplate>

                                    <VirtualizingStackPanel/>

                                </ItemsPanelTemplate>

                            </ListBox.ItemsPanel>

                            <ListBox.ItemTemplate>

                                <DataTemplate>

                                    <Border Height="36" Padding="8,0">

                                        <Grid>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Image Grid.Column="0"
                                                   Source="{Binding Icon, Converter={StaticResource BytesToImageSourceConverter}, IsAsync=False}"
                                                   Width="22"
                                                   Height="22"
                                                   Margin="0,0,10,0"
                                                   VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Name}"
                                                       Foreground="{StaticResource TextBrush}"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Game}"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       FontSize="10"
                                                       VerticalAlignment="Center"
                                                       Margin="10,0,0,0"/>

                                            <TextBlock Grid.Column="3"
                                                       VerticalAlignment="Center"
                                                       Margin="10,0,0,0"
                                                       Foreground="{StaticResource SecondaryTextBrush}">

                                                <TextBlock.Text>

                                                    <MultiBinding StringFormat="{}{0}/{1}">

                                                        <Binding Path="Players"/>
                                                        <Binding Path="MaxPlayers"/>

                                                    </MultiBinding>

                                                </TextBlock.Text>

                                            </TextBlock>

                                            <StackPanel Grid.Column="5"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center"
                                                        Margin="12,0,0,0">

                                                <Button MinHeight="24"
                                                        Padding="8,2"
                                                        Command="{Binding DataContext.SaveBrowserServerCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">

                                                    <Button.Style>

                                                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButtonStyle}">

                                                            <Setter Property="Content" Value="{loc:Loc SaveButton}"/>

                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSaved}" Value="True">
                                                                    <Setter Property="Content" Value="{loc:Loc SavedBrowserButton}"/>
                                                                    <Setter Property="IsEnabled" Value="False"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>

                                                        </Style>

                                                    </Button.Style>

                                                </Button>

                                                <Button Content="{loc:Loc ConnectBrowserButton}"
                                                        MinHeight="24"
                                                        Padding="10,2"
                                                        Style="{StaticResource MainButtonStyle}"
                                                        Margin="6,0,0,0"
                                                        Command="{Binding DataContext.ConnectBrowserServerCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>

                                            </StackPanel>

                                        </Grid>

                                    </Border>

                                </DataTemplate>

                            </ListBox.ItemTemplate>

                        </ListBox>

                        <TextBlock Text="{loc:Loc BrowserLoadFailed}"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding Browser.LoadFailed, Converter={StaticResource BoolToVisibility}}"/>

                    </Grid>

                </Border>

            </Grid>

        </Border>

    </Grid>

</UserControl>
