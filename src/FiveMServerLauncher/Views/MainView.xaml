<!-- The shell's content area: one rounded content panel showing the current page, the bottom
     bar (CFX status, page tabs, open-client slot) and the modal overlays above both. Each
     area is its own UserControl inheriting this DataContext (the MainViewModel); every shared
     resource lives in Theme.xaml, merged through ThemeResources. Sibling order is z-order:
     later siblings paint above earlier ones. The title bar (update pill) and the footer live
     in MainWindow, outside this control, so no overlay here can ever cover them. -->
<UserControl x:Class="FiveMServerLauncher.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FiveMServerLauncher.Views">

    <UserControl.Resources>
        <views:ThemeResources/>
    </UserControl.Resources>

    <Grid Background="{StaticResource GroundBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- CONTENT PANEL: exactly one page is visible (CurrentPage); each fades/slides in
             when it is shown. Pages are never rebuilt, so the browser keeps its rows and
             scroll position across switches. -->

        <Border x:Name="ContentPanel"
                Grid.Row="0"
                Style="{StaticResource ContentPanelStyle}"
                Margin="16,12,16,0"
                ClipToBounds="True">

            <Grid>

                <views:ServersPage x:Name="ServersPage"
                                   views:Motion.Shown="{Binding IsServersPage}"
                                   Style="{StaticResource PageSurfaceStyle}"/>

                <views:ServerBrowser x:Name="BrowsePage"
                                     views:Motion.Shown="{Binding IsBrowsePage}"
                                     Style="{StaticResource PageSurfaceStyle}"/>

                <views:SettingsPage x:Name="SettingsPage"
                                    views:Motion.Shown="{Binding IsSettingsPage}"
                                    Style="{StaticResource PageSurfaceStyle}"/>

            </Grid>

        </Border>

        <!-- BOTTOM BAR (declared after the panel: the open-client list unrolls upward over
             the panel and must paint above it) -->

        <views:BottomBar x:Name="BottomBar"
                         Grid.Row="1"/>

        <!-- ADD/EDIT SERVER DIALOG (overlay above the pages and the bottom bar) -->

        <views:ServerDialog Grid.RowSpan="2"/>

        <!-- CONFIRM DIALOG (overlay; a root-grid sibling declared last so it paints
             above every other overlay — never nest it inside another overlay) -->

        <views:ConfirmDialog Grid.RowSpan="2"/>

    </Grid>

</UserControl>
