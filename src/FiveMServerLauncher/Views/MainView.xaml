<!-- The main view only composes the page controls; each area lives in its own UserControl
     (inheriting this DataContext, the MainViewModel) and every shared resource lives in
     Theme.xaml, merged through ThemeResources. Sibling order is z-order: later siblings paint
     above earlier ones. -->
<UserControl x:Class="FiveMServerLauncher.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FiveMServerLauncher.Views">

    <UserControl.Resources>
        <views:ThemeResources/>
    </UserControl.Resources>

    <!-- ROOT -->

    <Grid Background="{StaticResource GroundBrush}">

        <Grid.RowDefinitions>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="*"/>

            <ColumnDefinition Width="20"/>

            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>

        <!-- FIVEM -->

        <Border Grid.Column="0"
                Style="{StaticResource ContentPanelStyle}"
                Margin="20,24,10,24">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>

                <views:SettingsBar Grid.Row="0"/>

                <!-- Spans the CFX status row and paints above it (ZIndex: the status
                     block is a later sibling): the panel sizes to its content, so it
                     covers only what it needs while open, like a dropdown. The leftover
                     row alone is too short for every setting. -->

                <views:SettingsPanel Grid.Row="1"
                                     Grid.RowSpan="2"
                                     Panel.ZIndex="1"/>

                <views:CfxStatusPanel Grid.Row="2"/>

                <views:OpenClientButton Grid.Row="3"/>

                <!-- DEV MODE (a top-anchored overlay spanning the lower rows:
                     it never participates in their sizing, so mounting it
                     cannot jump the normal-mode surfaces it crossfades
                     against) -->

                <views:DevModePanel Grid.Row="1"
                                    Grid.RowSpan="3"/>

            </Grid>

        </Border>

        <!-- SERVIDOR -->

        <views:SavedServersPanel Grid.Column="2"/>

        <!-- UPDATE BANNER (a bottom strip; mounts only while one of the mutually
             exclusive banner states is set and takes no space otherwise; declared
             BEFORE the dialog and browser overlays so those later siblings paint
             above it — and span both rows — keeping it covered while they are
             open) -->

        <views:UpdateBanner Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"/>

        <!-- ADD/EDIT SERVER DIALOG (overlay) -->

        <views:ServerDialog Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Grid.RowSpan="2"/>

        <!-- SERVER BROWSER (full-view overlay) -->

        <views:ServerBrowser Grid.Column="0"
                             Grid.ColumnSpan="3"
                             Grid.RowSpan="2"/>

        <!-- CONFIRM DIALOG (overlay; a root-grid sibling declared last so it paints
             above every other overlay — never nest it inside another overlay) -->

        <views:ConfirmDialog Grid.Column="0"
                             Grid.ColumnSpan="3"
                             Grid.RowSpan="2"/>

    </Grid>

</UserControl>
