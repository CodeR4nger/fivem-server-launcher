<UserControl x:Class="FiveMServerLauncher.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:viewModels="clr-namespace:FiveMServerLauncher.ViewModels"
             xmlns:views="clr-namespace:FiveMServerLauncher.Views">

    <UserControl.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <views:BytesToImageSourceConverter x:Key="BytesToImageSourceConverter"/>
        <views:GameClientToBrushConverter x:Key="GameClientToBrushConverter"/>
        <views:CfxStatusToBrushConverter x:Key="CfxStatusToBrushConverter"/>

        <views:SelectionEqualityToVisibilityConverter x:Key="SelectionEqualityToVisibility"/>

        <!-- COLORES -->

        <SolidColorBrush x:Key="BackgroundBrush" Color="#101010"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#181818"/>
        <SolidColorBrush x:Key="PanelLightBrush" Color="#202020"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#F5A623"/>
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#D88E18"/>
        <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#999999"/>

        <!-- Borde -->
        <SolidColorBrush x:Key="BorderBrush" Color="#080808"/>
        <SolidColorBrush x:Key="GreenBrush" Color="#55C271"/>
        <SolidColorBrush x:Key="RedBrush" Color="#E05252"/>

        <!-- TEMPLATE DE BOTÓN COMPARTIDO -->
        <ControlTemplate x:Key="ButtonTemplate" TargetType="{x:Type Button}">

            <Border x:Name="ButtonBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}">

                <ContentPresenter
                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}"
                    ContentStringFormat="{TemplateBinding ContentStringFormat}"/>

            </Border>

            <ControlTemplate.Triggers>

                <!-- HOVER -->

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter TargetName="ButtonBorder"
                            Property="Background"
                            Value="{StaticResource AccentBrush}"/>

                    <Setter TargetName="ButtonBorder"
                            Property="BorderBrush"
                            Value="{StaticResource AccentDarkBrush}"/>

                    <Setter Property="Foreground"
                            Value="{StaticResource BackgroundBrush}"/>

                </Trigger>


                <!-- PRESSED -->

                <Trigger Property="IsPressed"
                         Value="True">

                    <Setter TargetName="ButtonBorder"
                            Property="Background"
                            Value="{StaticResource AccentDarkBrush}"/>

                    <Setter TargetName="ButtonBorder"
                            Property="BorderBrush"
                            Value="{StaticResource AccentDarkBrush}"/>

                    <Setter Property="Foreground"
                            Value="{StaticResource BackgroundBrush}"/>

                </Trigger>


                <!-- DISABLED -->

                <Trigger Property="IsEnabled"
                         Value="False">

                    <Setter TargetName="ButtonBorder"
                            Property="Opacity"
                            Value="0.45"/>

                    <Setter Property="Cursor"
                            Value="Arrow"/>

                </Trigger>

            </ControlTemplate.Triggers>

        </ControlTemplate>

        <!-- BASE DE BOTÓN -->

        <Style x:Key="BaseButtonStyle" TargetType="{x:Type Button}">

            <Setter Property="Background"
                    Value="{StaticResource PanelLightBrush}"/>

            <Setter Property="Foreground"
                    Value="{StaticResource TextBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Template"
                    Value="{StaticResource ButtonTemplate}"/>

        </Style>

        <!-- BOTÓN PRINCIPAL -->
        <Style x:Key="MainButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource BaseButtonStyle}">

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Foreground"
                    Value="{StaticResource AccentBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource AccentBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1,1,1,2"/>

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="Padding"
                    Value="20,12"/>

        </Style>

        <!-- BOTÓN SECUNDARIO (outline, quiet) -->

        <Style x:Key="SecondaryButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource BaseButtonStyle}">

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Foreground"
                    Value="{StaticResource SecondaryTextBrush}"/>

            <Setter Property="BorderBrush"
                    Value="#3A3A3A"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="Padding"
                    Value="16,10"/>

        </Style>

        <!-- SECTION HEADER (shared label style) -->
        <Style x:Key="SectionHeaderStyle"
               TargetType="TextBlock">

            <Setter Property="Foreground"
                    Value="{StaticResource SecondaryTextBrush}"/>

            <Setter Property="FontSize"
                    Value="11"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

        </Style>

        <!-- THIN DARK SCROLLBAR (view-scoped) -->

        <Style TargetType="{x:Type ScrollBar}">

            <Setter Property="Width" Value="6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type ScrollBar}">

                        <Grid UseLayoutRounding="True">

                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True"
                                   IsEnabled="True">

                                <Track.Thumb>

                                    <Thumb>

                                        <Thumb.Template>

                                            <ControlTemplate TargetType="{x:Type Thumb}">

                                                <Rectangle Fill="#3A3A3A"
                                                           RadiusX="3"
                                                           RadiusY="3"/>

                                            </ControlTemplate>

                                        </Thumb.Template>

                                    </Thumb>

                                </Track.Thumb>

                                <Track.DecreaseRepeatButton>

                                    <RepeatButton Command="{x:Static ScrollBar.LineUpCommand}"
                                                  Focusable="False"
                                                  IsTabStop="False"
                                                  Background="Transparent"
                                                  BorderThickness="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>

                                </Track.DecreaseRepeatButton>

                                <Track.IncreaseRepeatButton>

                                    <RepeatButton Command="{x:Static ScrollBar.LineDownCommand}"
                                                  Focusable="False"
                                                  IsTabStop="False"
                                                  Background="Transparent"
                                                  BorderThickness="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>

                                </Track.IncreaseRepeatButton>

                            </Track>

                        </Grid>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- BOTÓN DROPDOWN -->

        <Style x:Key="DropdownButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource BaseButtonStyle}">

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

            <Setter Property="Padding"
                    Value="18,13"/>

        </Style>

        <!-- BOTÓN DE FLECHA -->

        <Style x:Key="ArrowButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource BaseButtonStyle}">

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

        </Style>

    </UserControl.Resources>

    <!-- ROOT -->

    <Grid Background="{StaticResource BackgroundBrush}">

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="*"/>

            <ColumnDefinition Width="20"/>

            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>

        <!-- FIVEM -->

        <Border Grid.Column="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                Margin="20,24,10,24">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>

                <!-- SETTINGS BAR -->

                <DockPanel Grid.Row="0" Margin="14,14,14,0">

                    <Button Content="⚙ SETTINGS"
                            MinHeight="34"
                            Padding="14,8"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding SettingsCommand}"/>

                    <Button Content="DEV MODE"
                            MinHeight="34"
                            Padding="14,8"
                            Margin="8,0,0,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ToggleDevModeCommand}"/>

                </DockPanel>

                <!-- SETTINGS PANEL -->

                <Border Grid.Row="1"
                        Margin="14,10,14,0"
                        Padding="14"
                        Background="{StaticResource PanelLightBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        Visibility="{Binding IsSettingsOpen,
                                             Converter={StaticResource BoolToVisibility}}">

                    <StackPanel VerticalAlignment="Top">

                        <TextBlock Text="PREFERRED OPEN CLIENT"
                                   Style="{StaticResource SectionHeaderStyle}"/>

                        <ComboBox ItemsSource="{Binding AvailableOpenClients}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedItem="{Binding PreferredClientOption}"
                                  Height="30"
                                  Margin="0,6,0,10"
                                  VerticalContentAlignment="Center"/>

                        <CheckBox IsChecked="{Binding AutoLaunch}"
                                  Content="Auto-launch last server on startup"
                                  Foreground="{StaticResource TextBrush}"
                                  FontSize="12"/>

                    </StackPanel>

                </Border>


                <!-- STATUS FIVEM -->

                <StackPanel Grid.Row="2"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="30"
                            Visibility="{Binding IsDevMode,
                                                 Converter={StaticResource InverseBoolToVisibility},
                                                 FallbackValue=Visible}">

                    <TextBlock Text="FIVEM / CFX"
                               Style="{StaticResource SectionHeaderStyle}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>

                    <ItemsControl ItemsSource="{Binding CfxStatuses}">

                        <ItemsControl.ItemTemplate>

                            <DataTemplate>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Margin="0,2">

                                    <Ellipse Width="8"
                                             Height="8"
                                             Fill="{Binding Status,
                                                           Converter={StaticResource CfxStatusToBrushConverter}}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,8,0"/>

                                    <TextBlock Text="{Binding DisplayName}"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>

                                    <TextBlock Text="{Binding StatusLabel}"
                                               Foreground="{StaticResource TextBrush}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>

                                </StackPanel>

                            </DataTemplate>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </StackPanel>


                <!-- SPLIT BUTTON -->

                <Grid Grid.Row="3"
                      Margin="20,0,20,20"
                      Visibility="{Binding IsDevMode,
                                           Converter={StaticResource InverseBoolToVisibility},
                                           FallbackValue=Visible}">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="50"/>

                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>


                    <Grid Grid.Row="0">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="50"/>

                        </Grid.ColumnDefinitions>


                        <Button x:Name="FiveMButton"
                                Grid.Column="0"
                                Content="{Binding SelectedOpenClientLabel}"
                                Command="{Binding OpenClientCommand}"
                                Style="{StaticResource MainButtonStyle}"/>


                        <Button x:Name="DropdownButton"
                                Grid.Column="1"
                                Style="{StaticResource ArrowButtonStyle}"
                                Click="DropdownButton_Click">

                            <TextBlock x:Name="ArrowText"
                                       Text="▼"
                                       FontSize="10"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Button>

                    </Grid>


                    <!-- DROPDOWN -->

                    <Border x:Name="FiveMDropdown"
                            Grid.Row="1"
                            Background="{StaticResource PanelLightBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1,0,1,1"
                            Visibility="Collapsed">

                        <StackPanel>

                            <ItemsControl ItemsSource="{Binding AvailableOpenClients}">

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate>

                                        <Button Content="{Binding DisplayName}"
                                                Height="42"
                                                Style="{StaticResource DropdownButtonStyle}"
                                                Command="{Binding DataContext.SelectOpenClientCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Click="ClientOption_Click"/>

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </StackPanel>

                    </Border>

                </Grid>

                <!-- DEV MODE -->

                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsDevMode,
                                                  Converter={StaticResource BoolToVisibility},
                                                  FallbackValue=Collapsed}">

                    <StackPanel
                            VerticalAlignment="Top"
                            Margin="20,8,20,0">

                    <TextBlock Text="DEV MODE"
                               Style="{StaticResource SectionHeaderStyle}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>

                    <Button Content="{Binding DevClientButtonText}"
                            Padding="14,6"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ToggleDevClientCommand}"
                            Margin="0,0,0,10"/>

                    <TextBlock Text="GAME BUILD"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="10"
                               Margin="0,6,0,3"/>

                    <TextBox Text="{Binding DevGameBuild, UpdateSourceTrigger=PropertyChanged}"
                             Background="{StaticResource PanelLightBrush}"
                             Foreground="{StaticResource TextBrush}"
                             BorderBrush="{StaticResource BorderBrush}"
                             BorderThickness="1"
                             Padding="10,8"
                             FontSize="12"/>

                    <TextBlock Text="PURE MODE"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="10"
                               Margin="0,10,0,3"/>

                    <ComboBox SelectedValue="{Binding DevPureMode}"
                              SelectedValuePath="Tag"
                              MinHeight="28"
                              VerticalContentAlignment="Center">

                        <ComboBoxItem Content="None"/>
                        <ComboBoxItem Content="0">
                            <ComboBoxItem.Tag><sys:Int32>0</sys:Int32></ComboBoxItem.Tag>
                        </ComboBoxItem>
                        <ComboBoxItem Content="1">
                            <ComboBoxItem.Tag><sys:Int32>1</sys:Int32></ComboBoxItem.Tag>
                        </ComboBoxItem>
                        <ComboBoxItem Content="2">
                            <ComboBoxItem.Tag><sys:Int32>2</sys:Int32></ComboBoxItem.Tag>
                        </ComboBoxItem>

                    </ComboBox>

                    </StackPanel>

                </ScrollViewer>

                <!-- DEV LAUNCH -->

                <StackPanel Grid.Row="3"
                            Margin="20,14,20,20"
                            Visibility="{Binding IsDevMode,
                                                 Converter={StaticResource BoolToVisibility},
                                                 FallbackValue=Collapsed}">

                    <Button Content="LAUNCH"
                            MinHeight="50"
                            Style="{StaticResource MainButtonStyle}"
                            Command="{Binding DevLaunchCommand}"
                            CommandParameter="{x:Null}"/>

                    <Button Content="LAUNCH WITH SECOND CLIENT (-cl2)"
                            MinHeight="50"
                            Margin="0,8,0,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding DevLaunchCommand}"
                            CommandParameter="{x:Static viewModels:DevLaunchParams.SecondClient}"/>

                </StackPanel>

            </Grid>

        </Border>

<!-- SERVIDOR -->

        <Border Grid.Column="2"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                Margin="10,24,20,24">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="*"/>

                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <!-- FORMULARIO -->

                <ScrollViewer Grid.Row="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel Margin="20">

                    <TextBlock Text="SAVED SERVERS"
                               Style="{StaticResource SectionHeaderStyle}"
                               Margin="0,0,0,7"/>

                    <Border BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            Background="{StaticResource PanelLightBrush}">

                        <ListBox x:Name="SavedServersList"
                                 ItemsSource="{Binding SavedServers}"
                                 SelectedItem="{Binding SelectedServer}"
                                 Background="{StaticResource PanelLightBrush}"
                                 BorderThickness="0"
                                 HorizontalContentAlignment="Stretch"
                                 Padding="0,4,0,4"
                                 MaxHeight="110">

                            <ListBox.ItemTemplate>

                                <DataTemplate>

                                    <Grid Margin="6">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Image Grid.Column="0"
                                               Source="{Binding Icon, Converter={StaticResource BytesToImageSourceConverter}}"
                                               Width="22"
                                               Height="22"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   Foreground="{StaticResource TextBrush}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <Border Grid.Column="2"
                                                Background="{Binding Game, Converter={StaticResource GameClientToBrushConverter}}"
                                                CornerRadius="3"
                                                Padding="5,1"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding HasGame, Converter={StaticResource BoolToVisibility}}">

                                            <TextBlock Text="{Binding GameTagLabel}"
                                                       Foreground="{StaticResource BackgroundBrush}"
                                                       FontSize="9"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding StatusLabel}"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0"/>

                                        <Button Grid.Column="4"
                                                Command="{Binding DataContext.OpenEditServerDialogCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Cursor="Hand"
                                                Padding="6,2"
                                                VerticalAlignment="Center">

                                            <Button.Visibility>

                                                <MultiBinding Converter="{StaticResource SelectionEqualityToVisibility}">

                                                    <Binding Path="DataContext"
                                                             RelativeSource="{RelativeSource AncestorType=ListBoxItem}"/>

                                                    <Binding Path="SelectedItem"
                                                             RelativeSource="{RelativeSource AncestorType=ListBox}"/>

                                                </MultiBinding>

                                            </Button.Visibility>

                                            <TextBlock Text="✏"/>

                                            <Button.Template>

                                                <ControlTemplate TargetType="{x:Type Button}">

                                                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">

                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                    </Border>

                                                </ControlTemplate>

                                            </Button.Template>

                                            <Button.Resources>

                                                <Style TargetType="{x:Type TextBlock}" BasedOn="{x:Null}">

                                                    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>

                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                     Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>

                                                </Style>

                                            </Button.Resources>

                                        </Button>

                                    </Grid>

                                </DataTemplate>

                            </ListBox.ItemTemplate>

                        </ListBox>

                    </Border>

                    <DockPanel Margin="0,8,0,0">

                        <Button Content="DELETE"
                                MinHeight="26"
                                Padding="12,4"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding DeleteServerCommand}"/>

                        <Button Content="+ NEW SERVER"
                                MinHeight="26"
                                Padding="12,4"
                                HorizontalAlignment="Right"
                                Style="{StaticResource MainButtonStyle}"
                                Command="{Binding OpenAddServerDialogCommand}"/>

                    </DockPanel>

                    <TextBlock Text="CONNECT ADDRESS"
                               Style="{StaticResource SectionHeaderStyle}"
                               Margin="0,20,0,0"/>

                    <TextBox x:Name="ServerAddressBox"
                             Text="{Binding ServerAddress,
                                            UpdateSourceTrigger=PropertyChanged}"
                             Background="{StaticResource PanelLightBrush}"
                             Foreground="{StaticResource TextBrush}"
                             BorderBrush="{StaticResource BorderBrush}"
                             BorderThickness="1"
                             Padding="16,10"
                             FontSize="13"
                             VerticalContentAlignment="Center"
                             MinHeight="40"
                             Margin="0,7,0,0"/>

                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="11"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>

                    </StackPanel>

                </ScrollViewer>

                <!-- BOTON ENTRAR -->

                <Button Grid.Row="1"
                        Content="ENTER SERVER"
                        Height="54"
                        Margin="20,16,20,20"
                        Style="{StaticResource MainButtonStyle}"
                        Command="{Binding ConnectCommand}"/>

            </Grid>

        </Border>

        <!-- ADD/EDIT SERVER DIALOG (overlay) -->

        <Border Grid.Column="0"
                Grid.ColumnSpan="3"
                Background="#66000000"
                Padding="40,60"
                Visibility="{Binding IsServerDialogOpen,
                                     Converter={StaticResource BoolToVisibility},
                                     FallbackValue=Collapsed}">

            <Border Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Padding="20"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    MinWidth="320">

                <StackPanel>

                    <TextBlock Text="{Binding ServerDialogTitle}"
                               Style="{StaticResource SectionHeaderStyle}"
                               Margin="0,0,0,12"/>

                    <TextBox Text="{Binding DialogServerName, UpdateSourceTrigger=PropertyChanged}"
                             Background="{StaticResource PanelLightBrush}"
                             Foreground="{StaticResource TextBrush}"
                             BorderBrush="{StaticResource BorderBrush}"
                             BorderThickness="1"
                             Padding="12,8"
                             FontSize="12"
                             MinHeight="38"/>

                    <TextBox Text="{Binding DialogServerAddress, UpdateSourceTrigger=PropertyChanged}"
                             Background="{StaticResource PanelLightBrush}"
                             Foreground="{StaticResource TextBrush}"
                             BorderBrush="{StaticResource BorderBrush}"
                             BorderThickness="1"
                             Padding="12,8"
                             FontSize="12"
                             MinHeight="38"
                             Margin="0,8,0,0"/>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">

                        <CheckBox IsChecked="{Binding DialogRequiresSteam}"
                                  Content="Requires Steam"
                                  Foreground="{StaticResource SecondaryTextBrush}"
                                  FontSize="11"/>

                        <CheckBox IsChecked="{Binding DialogRequiresDiscord}"
                                  Content="Requires Discord"
                                  Foreground="{StaticResource SecondaryTextBrush}"
                                  FontSize="11"
                                  Margin="16,0,0,0"/>

                    </StackPanel>

                    <TextBlock Text="{Binding DialogError}"
                               Foreground="#E5533D"
                               FontSize="11"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>

                    <DockPanel Margin="0,14,0,0">

                        <Button Content="CANCEL"
                                MinHeight="32"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Left"
                                Command="{Binding CancelServerDialogCommand}"/>

                        <Button Content="SAVE"
                                MinHeight="32"
                                Style="{StaticResource MainButtonStyle}"
                                HorizontalAlignment="Right"
                                MinWidth="90"
                                Command="{Binding SaveServerDialogCommand}"/>

                    </DockPanel>

                </StackPanel>

            </Border>

        </Border>

    </Grid>

</UserControl>
