<!-- Confirm modal: a scrim with one centred card (the question, Cancel, Confirm). Confirm is
     the danger pill when the confirmation guards a destructive action (delete), the amber
     primary otherwise. Esc cancels, Enter on a non-button confirms; focus enters on Cancel
     (the safe default), cycles inside and returns to the opener on close (ModalFocus).
     DataContext is inherited (MainViewModel). -->
<UserControl x:Class="FiveMServerLauncher.Views.ConfirmDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:FiveMServerLauncher.Views"
             xmlns:views="clr-namespace:FiveMServerLauncher.Views">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <views:ThemeResources/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Confirm: amber primary, or the danger fill for a destructive action -->
            <Style x:Key="ConfirmButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsConfirmDestructive}" Value="True">
                        <Setter Property="Background" Value="{StaticResource DangerTextBrush}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource DangerTextBrush}"/>
                        <Setter Property="Foreground" Value="{StaticResource OnSelectedBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- SCRIM: fades in/out with the open flag; collapses once faded out -->
    <Border Background="{StaticResource ScrimBrush}"
            Padding="24"
            views:Motion.Shown="{Binding IsConfirmOpen}">

        <Border.Visibility>
            <MultiBinding Converter="{StaticResource PanelVisibilityStateConverter}"
                          Mode="OneWay">
                <Binding Path="IsConfirmOpen"/>
                <Binding Path="Opacity"
                         RelativeSource="{RelativeSource Self}"/>
            </MultiBinding>
        </Border.Visibility>

        <Border.Style>
            <StaticResource ResourceKey="FadeSurfaceStyle"/>
        </Border.Style>

        <!-- CARD: pops in -->
        <Border x:Name="ConfirmDialogCard"
                Style="{StaticResource ModalFrameStyle}"
                views:Motion.Shown="{Binding IsConfirmOpen}"
                views:ModalFocus.IsOpen="{Binding IsConfirmOpen}"
                Padding="28,24"
                Width="440"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                KeyboardNavigation.TabNavigation="Cycle"
                KeyboardNavigation.ControlTabNavigation="Cycle"
                KeyboardNavigation.DirectionalNavigation="Contained"
                AutomationProperties.Name="{Binding ConfirmText}">

            <Border.InputBindings>
                <KeyBinding Key="Escape" Command="{Binding CancelConfirmCommand}"/>
                <KeyBinding Key="Return" Command="{Binding ConfirmCommand}"/>
            </Border.InputBindings>

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0"
                              Focusable="False"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">

                    <TextBlock Text="{Binding ConfirmText}"
                               Style="{StaticResource BodyTextStyle}"
                               FontSize="{StaticResource FontSizeRowTitle}"
                               TextWrapping="Wrap"/>

                </ScrollViewer>

                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,22,0,0">

                    <Button Content="{loc:Loc CancelButton}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            MinHeight="44"
                            Padding="20,0"
                            Command="{Binding CancelConfirmCommand}"/>

                    <Button Content="{loc:Loc ConfirmButton}"
                            Style="{StaticResource ConfirmButtonStyle}"
                            MinHeight="44"
                            MinWidth="96"
                            Padding="26,0"
                            Margin="10,0,0,0"
                            Command="{Binding ConfirmCommand}"/>

                </StackPanel>

            </Grid>

        </Border>

    </Border>

</UserControl>
