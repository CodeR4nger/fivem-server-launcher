<!-- Confirm overlay. DataContext is inherited (MainViewModel). -->
<UserControl x:Class="FiveMServerLauncher.Views.ConfirmDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:FiveMServerLauncher.Views"
             xmlns:views="clr-namespace:FiveMServerLauncher.Views">

    <UserControl.Resources>
        <views:ThemeResources/>
    </UserControl.Resources>

    <Border Background="{StaticResource ScrimBrush}"
            Padding="40,60"
            views:Motion.Shown="{Binding IsConfirmOpen}">

        <Border.Visibility>
            <MultiBinding Converter="{StaticResource PanelVisibilityStateConverter}"
                          Mode="OneWay">
                <Binding Path="IsConfirmOpen"/>
                <Binding Path="Opacity"
                         RelativeSource="{RelativeSource Self}"/>
            </MultiBinding>
        </Border.Visibility>

        <Border.Style>
            <StaticResource ResourceKey="FadeSurfaceStyle"/>
        </Border.Style>

        <Border Style="{StaticResource ModalFrameStyle}"
                views:Motion.Shown="{Binding IsConfirmOpen}"
                Padding="20"
                MinWidth="320"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">

            <StackPanel>

                <TextBlock Text="{Binding ConfirmText}"
                           Style="{StaticResource BodyTextStyle}"
                           TextWrapping="Wrap"/>

                <DockPanel Margin="0,14,0,0">

                    <Button Content="{loc:Loc CancelButton}"
                            MinHeight="32"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Left"
                            Command="{Binding CancelConfirmCommand}"/>

                    <Button Content="{loc:Loc ConfirmButton}"
                            MinHeight="32"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Right"
                            MinWidth="90"
                            Command="{Binding ConfirmCommand}"/>

                </DockPanel>

            </StackPanel>

        </Border>

    </Border>

</UserControl>
