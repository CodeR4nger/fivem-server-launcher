<!-- Confirm overlay. DataContext is inherited (MainViewModel). -->
<UserControl x:Class="FiveMServerLauncher.Views.ConfirmDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:FiveMServerLauncher.Views"
             xmlns:views="clr-namespace:FiveMServerLauncher.Views">

    <UserControl.Resources>
        <views:ThemeResources/>
    </UserControl.Resources>

    <Border Background="#66000000"
            Padding="40,60"
            Opacity="0">

        <Border.Visibility>
            <MultiBinding Converter="{StaticResource PanelVisibilityStateConverter}"
                          Mode="OneWay">
                <Binding Path="IsConfirmOpen"/>
                <Binding Path="Opacity"
                         RelativeSource="{RelativeSource Self}"/>
            </MultiBinding>
        </Border.Visibility>

        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsConfirmOpen}" Value="True">
                        <DataTrigger.EnterActions>
                            <BeginStoryboard Storyboard="{StaticResource PanelFadeIn}"/>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                            <BeginStoryboard Storyboard="{StaticResource PanelFadeOut}"/>
                        </DataTrigger.ExitActions>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsConfirmOpen}" Value="False">
                        <Setter Property="IsHitTestVisible" Value="False"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Border Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                Padding="20"
                MinWidth="320"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">

            <StackPanel>

                <TextBlock Text="{Binding ConfirmText}"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="13"
                           TextWrapping="Wrap"/>

                <DockPanel Margin="0,14,0,0">

                    <Button Content="{loc:Loc CancelButton}"
                            MinHeight="32"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Left"
                            Command="{Binding CancelConfirmCommand}"/>

                    <Button Content="{loc:Loc ConfirmButton}"
                            MinHeight="32"
                            Style="{StaticResource MainButtonStyle}"
                            HorizontalAlignment="Right"
                            MinWidth="90"
                            Command="{Binding ConfirmCommand}"/>

                </DockPanel>

            </StackPanel>

        </Border>

    </Border>

</UserControl>
