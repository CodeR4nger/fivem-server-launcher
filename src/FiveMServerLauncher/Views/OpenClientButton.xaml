<!-- OPEN split button with its installed-client dropdown. DataContext is inherited (MainViewModel). -->
<UserControl x:Class="FiveMServerLauncher.Views.OpenClientButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FiveMServerLauncher.Views">

    <UserControl.Resources>
        <views:ThemeResources/>
    </UserControl.Resources>

    <Grid Margin="20,0,20,16">

        <Grid.Visibility>
            <MultiBinding Converter="{StaticResource PanelVisibilityStateConverter}"
                          ConverterParameter="invert"
                          Mode="OneWay">
                <Binding Path="IsDevMode"/>
                <Binding Path="Opacity"
                         RelativeSource="{RelativeSource Self}"/>
            </MultiBinding>
        </Grid.Visibility>

        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDevMode}" Value="False">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard Storyboard="{StaticResource PanelFadeIn}"/>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard Storyboard="{StaticResource PanelFadeOut}"/>
                    </DataTrigger.ExitActions>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsDevMode}" Value="True">
                        <Setter Property="IsHitTestVisible" Value="False"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

        <Grid.RowDefinitions>

            <RowDefinition Height="48"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>


        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="50"/>

            </Grid.ColumnDefinitions>


            <Button x:Name="FiveMButton"
                    Grid.Column="0"
                    Content="{Binding SelectedOpenClientLabel}"
                    Command="{Binding OpenClientCommand}"
                    Style="{StaticResource MainButtonStyle}"/>


            <Button x:Name="DropdownButton"
                    Grid.Column="1"
                    Style="{StaticResource ArrowButtonStyle}"
                    Click="DropdownButton_Click">

                <TextBlock x:Name="ArrowText"
                           Text="▼"
                           FontSize="10"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

            </Button>

        </Grid>


        <!-- DROPDOWN -->

        <Border x:Name="FiveMDropdown"
                Grid.Row="1"
                Background="{StaticResource PanelLightBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1,0,1,1"
                ClipToBounds="True"
                Visibility="Collapsed">

            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <Trigger Property="IsVisible" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0"
                                                         To="1"
                                                         Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel>

                <ItemsControl ItemsSource="{Binding AvailableOpenClients}">

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <Button Content="{Binding DisplayName}"
                                    Height="42"
                                    Style="{StaticResource DropdownButtonStyle}"
                                    Command="{Binding DataContext.SelectOpenClientCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Click="ClientOption_Click"/>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </StackPanel>

        </Border>

    </Grid>

</UserControl>
