<!-- The bottom bar's open-client split button. DataContext is inherited (MainViewModel).
     Main part: "Open <preferred client>" (opens it). ▾ part: the installed clients, the
     preferred one marked; picking one saves it as the Preferred client and launches nothing.
     Both parts edit/read the one PreferredClientOption the Settings page also edits. -->
<UserControl x:Class="FiveMServerLauncher.Views.OpenClientButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:FiveMServerLauncher.Views"
             xmlns:views="clr-namespace:FiveMServerLauncher.Views"
             PreviewKeyDown="OpenClientButton_PreviewKeyDown">

    <UserControl.Resources>
        <views:ThemeResources/>
    </UserControl.Resources>

    <Grid x:Name="ButtonRow" Height="48">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="50"/>
        </Grid.ColumnDefinitions>

        <!-- The client menu: opened only by the ▾ part (no right-click), placed above the
             row and as wide as it, in the theme popup menu. A ContextMenu brings the menu
             keyboard model: arrows move, Enter picks, Esc closes. -->
        <Grid.Resources>
            <ContextMenu x:Key="ClientMenu"
                         Style="{StaticResource PopupMenuStyle}"
                         DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                         MinWidth="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}"
                         ItemsSource="{Binding AvailableOpenClients}"
                         Placement="Top"
                         VerticalOffset="-6">
                <ContextMenu.ItemContainerStyle>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource PopupMenuItemStyle}">
                        <Setter Property="Command"
                                Value="{Binding DataContext.ChoosePreferredClientCommand,
                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <Setter Property="CommandParameter" Value="{Binding}"/>
                        <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}"/>
                        <Setter Property="HeaderTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="CurrentMark"
                                                   Text="✓"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Visibility>
                                                <MultiBinding Converter="{StaticResource SelectionEqualityToVisibility}">
                                                    <Binding/>
                                                    <Binding Path="DataContext.PreferredClientOption"
                                                             RelativeSource="{RelativeSource AncestorType=ContextMenu}"/>
                                                </MultiBinding>
                                            </TextBlock.Visibility>
                                        </TextBlock>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding DisplayName}"
                                                   FontSize="{StaticResource FontSizeRowTitle}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ContextMenu.ItemContainerStyle>
            </ContextMenu>
        </Grid.Resources>

        <Button x:Name="OpenButton"
                Grid.Column="0"
                Content="{Binding OpenClientLabel}"
                Command="{Binding OpenClientCommand}"
                Margin="0,0,6,0"
                Padding="14,0"
                Style="{StaticResource SecondaryButtonStyle}"/>

        <Button x:Name="ChooserButton"
                Grid.Column="1"
                Padding="0"
                IsEnabled="{Binding HasInstalledClients}"
                AutomationProperties.Name="{loc:Loc OpenClientChooser}"
                ToolTip="{loc:Loc OpenClientChooser}"
                Style="{StaticResource SecondaryButtonStyle}"
                Click="ChooserButton_Click">
            <TextBlock Text="▾"
                       FontSize="{StaticResource FontSizeRowTitle}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Button>

    </Grid>

</UserControl>
