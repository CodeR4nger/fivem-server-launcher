<!-- OPEN split button with its installed-client dropdown. DataContext is inherited (MainViewModel). -->
<UserControl x:Class="FiveMServerLauncher.Views.OpenClientButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FiveMServerLauncher.Views">

    <UserControl.Resources>
        <views:ThemeResources/>
    </UserControl.Resources>

    <Grid Margin="20,0,20,16"
          views:Motion.Shown="{Binding IsDevMode, Converter={StaticResource InverseBoolean}}">

        <Grid.Visibility>
            <MultiBinding Converter="{StaticResource PanelVisibilityStateConverter}"
                          ConverterParameter="invert"
                          Mode="OneWay">
                <Binding Path="IsDevMode"/>
                <Binding Path="Opacity"
                         RelativeSource="{RelativeSource Self}"/>
            </MultiBinding>
        </Grid.Visibility>

        <Grid.Style>
            <StaticResource ResourceKey="FadeSurfaceStyle"/>
        </Grid.Style>

        <Grid.RowDefinitions>

            <RowDefinition Height="48"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>


        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="50"/>

            </Grid.ColumnDefinitions>


            <Button x:Name="FiveMButton"
                    Grid.Column="0"
                    Content="{Binding SelectedOpenClientLabel}"
                    Command="{Binding OpenClientCommand}"
                    Margin="0,0,6,0"
                    FontSize="15"
                    Style="{StaticResource SecondaryButtonStyle}"/>


            <Button x:Name="DropdownButton"
                    Grid.Column="1"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="DropdownButton_Click">

                <TextBlock x:Name="ArrowText"
                           Text="▼"
                           FontSize="10"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

            </Button>

        </Grid>


        <!-- DROPDOWN -->

        <Border x:Name="FiveMDropdown"
                Grid.Row="1"
                Background="{StaticResource SurfaceRaisedBrush}"
                BorderBrush="{StaticResource BorderStrongBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusMenu}"
                Padding="4"
                Margin="0,6,0,0"
                ClipToBounds="True"
                Visibility="Collapsed">

            <!-- The height unroll is code-behind glue (gated on Motion.IsEnabled there);
                 the fade rides along only with motion on. -->
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsVisible" Value="True"/>
                                <Condition Property="views:Motion.IsEnabled" Value="True"/>
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0"
                                                         To="1"
                                                         Duration="{StaticResource MotionMedium}"
                                                         EasingFunction="{StaticResource MotionEase}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                        </MultiTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel>

                <ItemsControl ItemsSource="{Binding AvailableOpenClients}">

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <Button Content="{Binding DisplayName}"
                                    Height="42"
                                    Style="{StaticResource MenuRowButtonStyle}"
                                    Command="{Binding DataContext.SelectOpenClientCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Click="ClientOption_Click"/>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </StackPanel>

        </Border>

    </Grid>

</UserControl>
