<!-- Dev Mode controls (client toggle, build, pure mode, launch buttons). DataContext is inherited (MainViewModel). -->
<UserControl x:Class="FiveMServerLauncher.Views.DevModePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:viewModels="clr-namespace:FiveMServerLauncher.ViewModels"
             xmlns:loc="clr-namespace:FiveMServerLauncher.Views"
             xmlns:views="clr-namespace:FiveMServerLauncher.Views">

    <UserControl.Resources>
        <views:ThemeResources/>
    </UserControl.Resources>

    <StackPanel VerticalAlignment="Top"
                views:Motion.Shown="{Binding IsDevMode}">

        <StackPanel.Visibility>
            <MultiBinding Converter="{StaticResource PanelVisibilityStateConverter}"
                          Mode="OneWay">
                <Binding Path="IsDevMode"/>
                <Binding Path="Opacity"
                         RelativeSource="{RelativeSource Self}"/>
            </MultiBinding>
        </StackPanel.Visibility>

        <StackPanel.Style>
            <StaticResource ResourceKey="FadeSurfaceStyle"/>
        </StackPanel.Style>

        <ScrollViewer VerticalScrollBarVisibility="Auto">

            <StackPanel
                    VerticalAlignment="Top"
                    Margin="20,8,20,0">

        <TextBlock Text="{loc:Loc DevModeButton}"
                   Style="{StaticResource SectionHeaderStyle}"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>

        <Button Content="{Binding DevClientButtonText}"
                Padding="14,6"
                Style="{StaticResource SecondaryButtonStyle}"
                Command="{Binding ToggleDevClientCommand}"
                Margin="0,0,0,10"/>

        <TextBlock Text="{loc:Loc GameBuildHeader}"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="10"
                   Margin="0,6,0,3"/>

        <ComboBox ItemsSource="{Binding DevGameBuildOptions}"
                  DisplayMemberPath="Label"
                  SelectedValuePath="Build"
                  SelectedValue="{Binding DevGameBuild}"
                  MinHeight="28"
                  VerticalContentAlignment="Center"/>

        <TextBlock Text="{loc:Loc PureModeHeader}"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="10"
                   Margin="0,10,0,3"/>

        <ComboBox SelectedValue="{Binding DevPureMode}"
                  SelectedValuePath="Tag"
                  MinHeight="28"
                  VerticalContentAlignment="Center">

            <ComboBoxItem Content="{loc:Loc PureModeNone}"/>
            <ComboBoxItem Content="0">
                <ComboBoxItem.Tag><sys:Int32>0</sys:Int32></ComboBoxItem.Tag>
            </ComboBoxItem>
            <ComboBoxItem Content="1">
                <ComboBoxItem.Tag><sys:Int32>1</sys:Int32></ComboBoxItem.Tag>
            </ComboBoxItem>
            <ComboBoxItem Content="2">
                <ComboBoxItem.Tag><sys:Int32>2</sys:Int32></ComboBoxItem.Tag>
            </ComboBoxItem>

        </ComboBox>

        </StackPanel>

    </ScrollViewer>

        <!-- DEV LAUNCH -->

        <StackPanel Margin="20,14,20,20">

        <Button Content="{loc:Loc LaunchButton}"
                MinHeight="50"
                Style="{StaticResource PrimaryButtonStyle}"
                Command="{Binding DevLaunchCommand}"
                CommandParameter="{x:Null}"/>

        <Button Content="{loc:Loc LaunchSecondClientButton}"
                MinHeight="50"
                Margin="0,8,0,0"
                Style="{StaticResource SecondaryButtonStyle}"
                Command="{Binding DevLaunchCommand}"
                CommandParameter="{x:Static viewModels:DevLaunchParams.SecondClient}"/>

        </StackPanel>

    </StackPanel>

</UserControl>
