<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>FiveMServerLauncher</RootNamespace>
    <AssemblyName>CFXLauncher</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\launcher.ico</ApplicationIcon>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\launcher.ico" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\en.json" />
    <EmbeddedResource Include="Localization\es.json" />
    <EmbeddedResource Include="Localization\fr.json" />
    <EmbeddedResource Include="Localization\de.json" />
    <EmbeddedResource Include="Localization\it.json" />
    <EmbeddedResource Include="Localization\ja.json" />
    <EmbeddedResource Include="Localization\ko.json" />
    <EmbeddedResource Include="Localization\pl.json" />
    <EmbeddedResource Include="Localization\pt.json" />
    <EmbeddedResource Include="Localization\ru.json" />
    <EmbeddedResource Include="Localization\zh-Hans.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Grpc.Tools" Version="2.84.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Proto\master.proto" />
  </ItemGroup>

</Project>
