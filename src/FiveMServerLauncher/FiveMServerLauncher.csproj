<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>FiveMServerLauncher</RootNamespace>
    <AssemblyName>CFXLauncher</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\launcher.ico</ApplicationIcon>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\launcher.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Wildcard: adding a language is one JSON file, no csproj edit. The tag is
         the file name, the picker label is its `_displayName`. -->
    <EmbeddedResource Include="Localization\*.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Grpc.Tools" Version="2.84.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Native transport for the WebP icon decoder (CFX serves icons as WebP since
         the 2026-10 icon_url change; WPF/WIC cannot decode WebP). MIT package
         carrying the official libwebp 1.6.1 win-x64 binaries (~400 KB). Consumed
         only through the IWebpDecoder P/Invoke seam, never through its managed API.
         RID-native layout: flows into both dev output and the single-file publish
         (IncludeNativeLibrariesForSelfExtract). -->
    <PackageReference Include="Imazen.WebP.NativeRuntime.win-x64" Version="1.6.1" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Proto\master.proto" />
  </ItemGroup>

</Project>
